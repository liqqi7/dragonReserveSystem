.tab-bar-wrap {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  box-sizing: border-box;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 2rpx solid #e5e7eb;
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.07);
}

.tab-items-wrap {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 112rpx;
  padding: 4rpx 32rpx;
  align-items: center;
  justify-content: space-between;
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 104rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.tab-item--active {
  gap: 4rpx;
}

.tab-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.tab-label {
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.tab-label--active {
  color: #ff9800;
  font-weight: 600;
}
