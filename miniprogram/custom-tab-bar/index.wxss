:host {
  background: transparent;
}

.tab-bar-wrap {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  box-sizing: border-box;
  background: transparent;
}

.tab-items-wrap {
  position: relative;
  display: flex;
  overflow: hidden;
  box-sizing: border-box;
  width: calc(100% - 76.92308rpx);
  height: 100rpx;
  margin: 0 38.46154rpx;
  padding: 7.69231rpx;
  align-items: center;
  border-radius: 50rpx;
  background: transparent;
  box-shadow: 0 5.76923rpx 23.07692rpx rgba(100, 116, 139, 0.101961);
}

.tab-glass-blur,
.tab-glass-fill {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.tab-glass-blur {
  z-index: 0;
  background: transparent;
}

.tab-glass-fill {
  z-index: 1;
}

.tab-glass-stroke {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.tab-item {
  position: relative;
  z-index: 2;
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  height: 84.61538rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.92308rpx;
  border-radius: calc(50rpx - 7.69231rpx);
}

.tab-item--active {
  background: rgba(255, 255, 255, 0.901961);
  box-shadow: 0 3.84615rpx 15.38462rpx rgba(100, 116, 139, 0.070588);
}

.tab-icon {
  display: block;
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
}

.tab-label {
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 21.15385rpx;
  font-weight: 300;
}

.tab-label--active {
  color: #f59e0b;
}
