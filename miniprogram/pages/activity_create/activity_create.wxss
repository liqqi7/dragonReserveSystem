page { height:100%; background:#FFFFFF; }
.wizard { height:100vh; box-sizing:border-box; display:flex; flex-direction:column; color:#111827; overflow:hidden; }
.nav { height:88rpx; flex-shrink:0; padding:0 44.23rpx; display:flex; align-items:center; position:relative; z-index:3; }
.step-stage { position:relative; flex:1; min-height:0; overflow:visible; }
.step-scene { position:relative; width:100%; height:100%; display:flex; flex-direction:column; overflow:visible; }
.step-scene--entering.step-scene--entering--forward { animation-name:create-step-enter-forward; animation-duration:320ms; animation-timing-function:cubic-bezier(0.22, 1, 0.36, 1); animation-fill-mode:forwards; }
.step-scene--entering.step-scene--entering--backward { animation-name:create-step-enter-backward; animation-duration:320ms; animation-timing-function:cubic-bezier(0.22, 1, 0.36, 1); animation-fill-mode:forwards; }
.step-scene--leaving { position:absolute; top:0; right:0; bottom:0; left:0; z-index:2; pointer-events:none; }
.step-scene--leaving--forward { animation-name:create-step-leave-forward; animation-duration:320ms; animation-timing-function:cubic-bezier(0.22, 1, 0.36, 1); animation-fill-mode:forwards; }
.step-scene--leaving--backward { animation-name:create-step-leave-backward; animation-duration:320ms; animation-timing-function:cubic-bezier(0.22, 1, 0.36, 1); animation-fill-mode:forwards; }
@keyframes create-step-enter-forward { from { transform:translateX(100%); opacity:0; } to { transform:translateX(0); opacity:1; } }
@keyframes create-step-leave-forward { from { transform:translateX(0); opacity:1; } to { transform:translateX(-100%); opacity:0; } }
@keyframes create-step-enter-backward { from { transform:translateX(-100%); opacity:0; } to { transform:translateX(0); opacity:1; } }
@keyframes create-step-leave-backward { from { transform:translateX(0); opacity:1; } to { transform:translateX(100%); opacity:0; } }
.back { width:69.23rpx; height:88rpx; display:flex; align-items:center; justify-content:flex-start; }
.back-icon { width:34.62rpx; height:34.62rpx; }

.body { flex:1; min-height:0; overflow:visible; }
.heading { padding:0 46.15rpx; display:flex; flex-direction:column; align-items:center; gap:23.08rpx; text-align:center; }
.body--step-1 .heading { padding-top:38.46rpx; }
.body--step-2 .heading { padding-top:246.15rpx; }
.body--step-3 .heading { transition:padding-top 360ms cubic-bezier(0.42,0,0.58,1); }
.body--step-3.body--subitems-closed .heading { padding-top:246.15rpx; }
.body--step-3.body--subitems-open .heading { padding-top:61.54rpx; }
.title { font-size:46.15rpx; font-weight:700; line-height:1.2; color:#111827; }
.subtitle { font-size:26.92rpx; line-height:1.4; color:#9CA3AF; font-weight:400; }
.categories { height:61.54rpx; width:100%; margin-top:61.54rpx; display:flex; flex-direction:row; white-space:nowrap; }
.category-edge-spacer { flex:0 0 38.46rpx; width:38.46rpx; height:61.54rpx; }
.category-slot { flex:0 0 113.46rpx; width:113.46rpx; height:61.54rpx; }
.category { box-sizing:border-box; width:98.08rpx; height:61.54rpx; border-radius:30.77rpx; display:flex; align-items:center; justify-content:center; color:#6B7280; background:#F3F4F6; font-size:23.08rpx; font-weight:500; }
.category--active { background:#111827; color:#FFFFFF; font-weight:700; }
.gallery { height:869.23rpx; width:100%; margin-top:30.77rpx; }
.gallery-page { width:657.69rpx; height:100%; display:flex; box-sizing:border-box; }
.cover-column { flex:0 0 317.31rpx; width:317.31rpx; margin-right:23.08rpx; }
.cover-column:last-child { margin-right:0; }
.cover { position:relative; width:317.31rpx; height:423.08rpx; border-radius:30.77rpx; margin-bottom:23.08rpx; overflow:visible; }
.cover-media { position:relative; width:100%; height:100%; border-radius:30.77rpx; overflow:hidden; background:#F5F5F5; }
.cover-image { display:block; width:100%; height:100%; }
/* Same mounted-placeholder crossfade and left-to-right shimmer as the home cards. */
.cover-skeleton { position:absolute; top:0; left:0; z-index:1; width:100%; height:100%; overflow:hidden; border-radius:30.77rpx; background:#EAECEF; opacity:1; pointer-events:none; transition:opacity 440ms ease-out; }
.cover-skeleton--revealed { opacity:0; }
.cover-skeleton-shimmer { position:absolute; top:0; bottom:0; left:0; width:45%; background:linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.65), rgba(255,255,255,0)); transform:translateX(-100%); }
.cover-skeleton-shimmer--running { transform:translateX(325%); transition:transform 1400ms linear; }
.cover-outline { position:absolute; left:0; top:0; z-index:2; width:100%; height:100%; border:1.92rpx solid rgba(0,0,0,0.05); border-radius:30.77rpx; box-sizing:border-box; }
.cover-outline--selected { border:3.85rpx solid #FF9800; }
.selected { position:absolute; left:15.38rpx; top:15.38rpx; z-index:3; width:46.15rpx; height:46.15rpx; background:#FF9800; color:#FFFFFF; border-radius:23.08rpx; display:flex; align-items:center; justify-content:center; }
.selected-icon { width:26.92rpx; height:26.92rpx; }
.body--step-2 .fields { padding:69.23rpx 53.85rpx 38.46rpx; }
.body--step-3 .fields { transition:padding-top 360ms cubic-bezier(0.42,0,0.58,1); }
.body--step-3 .fields--subitems-closed { padding:69.23rpx 53.85rpx 38.46rpx; }
.body--step-3 .fields--subitems-open { padding:38.46rpx 53.85rpx 38.46rpx; }
.label { display:block; font-size:26.92rpx; line-height:46.15rpx; font-weight:700; margin:0 0 15.38rpx; }
.body--step-2 .label:not(:first-child), .body--step-3 .label:not(:first-child) { margin-top:38.46rpx; }
.field { height:107.69rpx; border-radius:30.77rpx; background:#F3F4F6; padding:0 38.46rpx; font-size:26.92rpx; line-height:26.92rpx; box-sizing:border-box; }
.location { display:flex; align-items:center; justify-content:space-between; }
.location-value { font-size:26.92rpx; line-height:26.92rpx; font-weight:400; }
.location-value--placeholder, .location-arrow { color:#9CA3AF; opacity:1; }
.location-value--filled { color:#111827; }
.remark { position:relative; height:184.62rpx; border-radius:30.77rpx; background:#F3F4F6; padding:30.77rpx 38.46rpx; box-sizing:border-box; }
.remark-input { width:100%; height:100rpx; color:#111827; font-size:26.92rpx; font-weight:400; line-height:37.69rpx; }
.remark-placeholder { position:absolute; left:38.46rpx; top:30.77rpx; color:#9CA3AF; font-size:26.92rpx; font-weight:400; line-height:37.69rpx; pointer-events:none; }
.counter { display:block; text-align:right; font-size:19.23rpx; color:#CBD5E1; }
.time-card { display:flex; align-items:center; gap:23.08rpx; background:transparent; border-radius:0; padding:0; }
.time-row { flex:1; min-width:0; height:107.69rpx; padding:0 30.77rpx; box-sizing:border-box; border-radius:30.77rpx; background:#F3F4F6; display:flex; align-items:center; justify-content:center; font-size:26.92rpx; color:#111827; white-space:nowrap; }
.time-value { color:#111827; }
.time-placeholder { color:#9CA3AF; font-weight:400; }
.time-separator { flex-shrink:0; color:#9CA3AF; font-size:23.08rpx; font-weight:500; }
.capacity-field { margin-top:38.46rpx; }
.capacity-card { height:107.69rpx; padding:0 23.08rpx; border-radius:30.77rpx; background:#F3F4F6; display:flex; align-items:center; justify-content:space-between; box-sizing:border-box; }
.capacity-value { min-width:107.69rpx; text-align:center; font-size:30.77rpx; line-height:30.77rpx; font-weight:600; color:#111827; }
.step-button { width:69.23rpx; height:69.23rpx; border-radius:19.23rpx; background:#FFFFFF; display:flex; align-items:center; justify-content:center; }
.step-icon { width:30.77rpx; height:30.77rpx; display:block; }
.subitems-section { margin-top:38.46rpx; }
.footer { position:absolute; left:0; right:0; bottom:0; width:100%; box-sizing:border-box; padding:23.08rpx 46.15rpx 0; flex-shrink:0; background:transparent; display:flex; flex-direction:column; align-items:center; z-index:2; }
.primary { width:100%; height:107.69rpx; flex-shrink:0; box-sizing:border-box; border-radius:53.85rpx; background:#FF9800; color:#FFFFFF; font-size:30.77rpx; font-weight:600; display:flex; flex-direction:row; align-items:center; justify-content:center; }
.primary--disabled { background:#E5E7EB; color:#9CA3AF; }
.previous { height:76.92rpx; display:flex; align-items:center; justify-content:center; color:#9CA3AF; font-size:26.92rpx; }
.empty { display:block; padding:53.85rpx; font-size:26.92rpx; color:#9CA3AF; }

.field, .remark, .time-row, .label { font-weight:400; }
.label { font-weight:700; }


.gallery-indicator { height:30.77rpx; margin:15.38rpx auto 0; display:flex; align-items:center; justify-content:center; gap:15.38rpx; }
.gallery-indicator-dot { width:11.54rpx; height:7.69rpx; border-radius:3.85rpx; background:#E5E7EB; }
.gallery-indicator-active { width:34.62rpx; height:7.69rpx; border-radius:3.85rpx; background:#FF9800; }









