page {
  background: #f8fafc;
}

.tools-page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background: #f8fafc;
}

.tools-navbar {
  box-sizing: border-box;
  height: 176.92rpx;
  padding-left: 38.46rpx;
  padding-right: 38.46rpx;
}

.tools-navbar-inner {
  position: relative;
  display: flex;
  box-sizing: border-box;
  height: 88.46rpx;
  align-items: center;
  justify-content: space-between;
}

.tools-title {
  color: #111827;
  font-size: 34.62rpx;
  font-weight: 600;
  line-height: 1.2;
}

.tools-logo {
  position: absolute;
  top: 9.62rpx;
  right: 0;
  width: 76.92rpx;
  height: 50.26rpx;
  opacity: 0.82;
}

.tools-list {
  display: flex;
  box-sizing: border-box;
  padding: 0 38.46rpx;
  flex-direction: column;
  gap: 23.08rpx;
}

.tool-card {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 276.92rpx;
  padding: 38.46rpx 34.62rpx;
  align-items: center;
  border: 1.92rpx solid #e7eaf0;
  border-radius: 38.46rpx;
  background: #ffffff;
}

.tool-card-icon {
  display: flex;
  width: 115.38rpx;
  height: 115.38rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 34.62rpx;
}

.tool-card-icon--boardgame {
  background: #fef3c7;
}

.tool-card-icon--chwazi {
  background: #dbeafe;
}

.tool-icon {
  width: 61.54rpx;
  height: 61.54rpx;
}

.tool-card-copy {
  display: flex;
  min-width: 0;
  margin-left: 26.92rpx;
  flex: 1;
  flex-direction: column;
}

.tool-card-title {
  overflow: hidden;
  color: #111827;
  font-size: 34.62rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-card-description {
  margin-top: 11.54rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 26.92rpx;
  font-weight: 400;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-card-arrow {
  width: 46.15rpx;
  height: 46.15rpx;
  margin-left: 15.38rpx;
  flex: none;
}

.tools-bottom-spacer {
  width: 100%;
}
