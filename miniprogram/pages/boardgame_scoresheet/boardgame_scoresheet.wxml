<view class="bg-page"><view class="bg-title">{{play.game_snapshot.name || '计分表'}}</view><view class="bg-subtitle">保留原始算式，分清空白与 0 分</view><view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{notice}}" class="bg-notice">{{notice}}</view><view wx:if="{{loading && !hasSheet}}" class="bg-empty">正在加载…</view>
  <view wx:if="{{!hasSheet && !loading}}" class="bg-empty">还没有计分表<view wx:if="{{editable && !serverView}}" class="bg-link" bindtap="openTemplates">选择普通、轮次或游戏模板</view></view>
  <block wx:if="{{hasSheet}}"><view class="bg-heading"><text>{{templateName}}</text><text wx:if="{{editable && !serverView}}" class="bg-link" bindtap="openTemplates">更换模板</text></view><button wx:if="{{reviewingConflict}}" class="bg-button secondary full" bindtap="toggleServer">{{serverView ? '返回本机修改' : '查看服务器原表'}}</button>
    <view wx:if="{{legacySheet}}" class="bg-notice">来源旧版计分表保留原分项，暂不自动计算。可用副本自定义后核对总分。<text wx:if="{{editable && !serverView}}" class="bg-link" bindtap="customize"> 转为可计算副本</text></view><view class="bg-muted">单选 / 勾选项长按可清空，清空不等于 0。</view><view class="bg-label">计算方式</view><picker range="{{methods}}" range-key="label" value="{{methodIndex}}" bindchange="methodChange" disabled="{{!editable || lockedTemplate || serverView}}"><view class="bg-input">{{methods[methodIndex].label}}　⌄</view></picker><view class="bg-label">分组 / 轮次</view><picker range="{{groupOptions}}" range-key="label" value="{{groupIndex}}" bindchange="groupChange"><view class="bg-input">{{groupOptions[groupIndex].label}}　⌄</view></picker>
    <view class="sheet-pages"><button class="bg-chip" data-step="-1" bindtap="pageSubjects" disabled="{{subjectPage === 0}}">前一组玩家</button><text class="bg-muted">第 {{subjectPage + 1}} 组</text><button class="bg-chip" data-step="1" bindtap="pageSubjects" disabled="{{!hasMoreSubjects}}">后一组玩家</button></view>
    <scroll-view scroll-x class="sheet-scroll"><view class="sheet-table"><view class="sheet-line"><view class="sheet-label">计分项</view><view wx:for="{{subjects}}" wx:key="key" class="sheet-cell head">{{item.label}}</view></view><view wx:for="{{rows}}" wx:for-item="row" wx:key="key" class="sheet-line"><view class="sheet-label">{{row.label}}<text wx:if="{{!row.contributes && !row.is_aggregate}}" class="bg-muted">（辅助）</text><text wx:if="{{editable && !serverView && row.repeatable && !row.repeat_of}}" class="sheet-label-action" data-key="{{row.key}}" bindtap="repeat">＋ 再记一项</text><text wx:if="{{editable && !serverView && row.repeat_of}}" class="sheet-label-action" data-key="{{row.key}}" bindtap="removeRepeat">移除此补记</text></view><view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="subject_key" class="sheet-cell">
      <text wx:if="{{!editable || serverView}}" class="sheet-value">{{cell.value_number === null || cell.value_number === undefined ? cell.value_text || '—' : cell.value_number}}</text>
      <input wx:elif="{{row.kind === 'number' || row.kind === 'subtotal'}}" class="sheet-input" value="{{cell.input}}" data-row="{{row.key}}" data-subject="{{cell.subject_key}}" data-kind="{{row.kind}}" bindinput="input" placeholder="{{row.kind === 'subtotal' ? '自动 / 手填' : '未填写'}}"/>
      <input wx:elif="{{row.kind === 'text'}}" class="sheet-input" value="{{cell.value_text}}" data-row="{{row.key}}" data-subject="{{cell.subject_key}}" data-kind="text" bindinput="input" placeholder="可选"/>
      <view wx:elif="{{row.kind === 'radio' || row.kind === 'checkbox'}}" class="sheet-mark {{cell.checked ? 'selected' : ''}}" data-row="{{row.key}}" data-subject="{{cell.subject_key}}" data-kind="{{row.kind}}" bindtap="mark" bindlongpress="clearCell">{{cell.checked ? '✓' : cell.checked === false ? '○' : '—'}}</view>
      <picker wx:elif="{{row.kind === 'choice'}}" range="{{row.optionLabels}}" value="{{cell.optionIndex}}" data-row="{{row.key}}" data-subject="{{cell.subject_key}}" bindchange="option"><view class="sheet-value bg-link">{{row.optionLabels[cell.optionIndex]}} ⌄</view></picker>
    </view></view></view></scroll-view>
    <view class="sheet-pages"><button class="bg-chip" data-step="-1" bindtap="pageRows" disabled="{{rowPage === 0}}">上一页计分项</button><button class="bg-chip" data-step="1" bindtap="pageRows" disabled="{{!hasMoreRows}}">下一页计分项</button></view>
    <view wx:if="{{editable && !serverView}}" class="sheet-controls"><button wx:if="{{!lockedTemplate}}" class="bg-chip" bindtap="openRow">＋ 计分项</button><button wx:if="{{!lockedTemplate && sheetType === 'rounds'}}" class="bg-chip" bindtap="addRound">＋ 一轮</button><button wx:if="{{lockedTemplate}}" class="bg-chip" bindtap="customize">用副本自定义</button></view>
    <view wx:if="{{editable && !serverView}}" class="sheet-controls"><button wx:if="{{isAdmin && !legacySheet}}" class="bg-chip" data-kind="template" bindtap="openMaintenance">保存为模板版本</button><button wx:if="{{isAdmin}}" class="bg-chip" data-kind="review" bindtap="openMaintenance">审核统计结构</button><button class="bg-chip" data-kind="clear" bindtap="openMaintenance">移除计分表</button></view>
    <view class="bg-heading"><text>最终得分</text><text class="bg-muted">未齐表示存在缺项</text></view><view class="sheet-summary"><view wx:for="{{totals}}" wx:key="subject_key" class="sheet-total"><view class="sheet-total-name">{{item.label}}</view><view class="sheet-total-score">{{item.display}}</view></view></view>
    <block wx:if="{{editable && !serverView}}"><view class="bg-label">保存原因{{play.status !== 'draft' ? ' *' : '（可选）'}}</view><input class="bg-input" value="{{reason}}" bindinput="reason" placeholder="例如：补录分项或修正计算"/><view class="bg-footer-space"/><view class="bg-fixed-actions"><button class="bg-button secondary bg-grow" bindtap="preview" loading="{{saving}}" disabled="{{saving}}">计算预览</button><button class="bg-button bg-grow" bindtap="save" disabled="{{saving}}">{{legacySheet ? '保存来源分项' : '保存并更新成绩'}}</button></view></block>
  </block>
</view>
<boardgame-sheet title="选择计分表" kind="form" visible="{{templateOpen}}" bindclose="closeTemplates" busy="{{saving}}" size="high"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-row"><button class="bg-chip {{builtin === 'generic' ? 'active' : ''}}" data-value="generic" bindtap="builtin">普通分项</button><button class="bg-chip {{builtin === 'rounds' ? 'active' : ''}}" data-value="rounds" bindtap="builtin">轮次计分</button></view><block wx:if="{{builtin === 'rounds'}}"><view class="bg-label">初始轮数（1–100）</view><input class="bg-input" type="number" value="{{roundCount}}" bindinput="rounds"/></block><view class="bg-heading">适用的游戏模板</view><view wx:for="{{templates}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="useTemplate"><view>{{item.name}}</view><text class="bg-muted">版本 {{item.version_number}} · 适配当前游戏、扩展、玩法和人数</text></view><view wx:if="{{!templates.length}}" class="bg-muted">没有专用模板，可使用通用计分表。</view><view wx:if="{{hasSheet}}" class="bg-notice">选用后替换当前计分结构和分项。保存后当前分项会被替换，请先核对。</view><view wx:if="{{play.status !== 'draft'}}"><view class="bg-label">替换 / 创建原因 *</view><input class="bg-input" value="{{reason}}" bindinput="reason" placeholder="说明本次更新原因"/></view><button slot="footer" class="bg-button full" bindtap="useTemplate" disabled="{{saving}}">使用通用计分表</button></boardgame-sheet>
<boardgame-sheet title="添加计分项" kind="form" visible="{{newRowOpen}}" bindclose="closeRow" busy="{{saving}}" size="high"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-label">名称</view><input class="bg-input" value="{{rowForm.label}}" data-key="label" bindinput="rowField" placeholder="例如：资源分"/><view class="bg-label">记录方式</view><picker range="{{rowKinds}}" range-key="label" value="{{rowKindIndex}}" bindchange="rowKind"><view class="bg-input">{{rowKinds[rowKindIndex].label}}　⌄</view></picker><view wx:if="{{rowKindIndex === 1 || rowKindIndex === 2}}"><view class="bg-label">选中获得的分值</view><input class="bg-input" value="{{rowForm.value}}" data-key="value" bindinput="rowField"/></view><view wx:if="{{rowKindIndex === 3}}"><view class="bg-label">选项与分值（每行一项）</view><textarea class="bg-input bg-textarea" value="{{rowForm.options}}" data-key="options" bindinput="rowField" placeholder="普通任务:3&#10;困难任务:5"/></view><view class="bg-card"><view class="bg-row bg-between"><text>计入总分</text><switch checked="{{rowForm.contributes}}" data-key="contributes" bindchange="rowField" color="#FF9800"/></view><view class="bg-row bg-between" style="margin-top:20rpx"><text>允许重复补记</text><switch checked="{{rowForm.repeatable}}" data-key="repeatable" bindchange="rowField" color="#FF9800"/></view></view><button slot="footer" class="bg-button full" bindtap="addRow">添加计分项</button></boardgame-sheet>

<boardgame-sheet visible="{{maintenanceOpen}}" title="{{maintenanceKind === 'template' ? '保存计分模板' : maintenanceKind === 'review' ? '审核计分结构' : '移除计分表'}}" kind="form" size="{{maintenanceKind === 'clear' ? 'standard' : 'high'}}" busy="{{saving}}" bindclose="closeMaintenance"><view wx:if="{{error}}" class="bg-error">{{error}}</view><block wx:if="{{maintenanceKind === 'clear'}}"><view class="bg-notice">移除各轮分项和计分结构，当前最终成绩仍保留。需要调整总分时，请回到对局页编辑。</view></block><block wx:else><view class="bg-card"><view>{{play.game_snapshot.name}}</view><view class="bg-subtitle">适用于当前玩法及 {{play.expansions.length}} 个扩展</view></view><block wx:if="{{maintenanceKind === 'template'}}"><view class="bg-label">模板名称</view><input class="bg-input" value="{{maintenanceName}}" data-key="maintenanceName" bindinput="maintenanceField" maxlength="255"/><view class="bg-label">保存方式</view><picker range="{{templateChoices}}" range-key="label" value="{{templateChoiceIndex}}" bindchange="templateChoice"><view class="bg-input">{{templateChoices[templateChoiceIndex].label}} ⌄</view></picker><view class="bg-label">适用人数（留空为不限）</view><view class="bg-grid-2"><input class="bg-input" type="number" value="{{minPlayers}}" data-key="minPlayers" bindinput="maintenanceField" placeholder="最少人数"/><input class="bg-input" type="number" value="{{maxPlayers}}" data-key="maxPlayers" bindinput="maintenanceField" placeholder="最多人数"/></view><view class="bg-subtitle">模板保存计分规则，不包含本局玩家姓名和成绩。旧版本及历史对局保持原版本。</view></block><view class="bg-label">规则版本名称</view><input class="bg-input" value="{{maintenanceVersion}}" data-key="maintenanceVersion" bindinput="maintenanceField" maxlength="64" placeholder="例如：基础规则 1.0"/><block wx:if="{{methodIndex !== 1 && methodIndex !== 2}}"><view class="bg-label">可相加比较的分项</view><view wx:for="{{maintenanceRows}}" wx:key="key" class="bg-card bg-row bg-between"><text class="bg-grow">{{item.label}}</text><switch color="#FF9800" checked="{{item.selected}}" data-key="{{item.key}}" bindchange="additive"/></view><view class="bg-subtitle">只选择规则上可相加的计分项；未选择的分项仍保留独立统计。</view></block></block><block wx:if="{{maintenanceKind !== 'template'}}"><view class="bg-label">核对原因</view><textarea class="bg-input bg-textarea" value="{{maintenanceReason}}" data-key="maintenanceReason" bindinput="maintenanceField" maxlength="500"/></block><button slot="footer" class="bg-button full" bindtap="saveMaintenance" disabled="{{saving}}" loading="{{saving}}">确认保存</button></boardgame-sheet>
