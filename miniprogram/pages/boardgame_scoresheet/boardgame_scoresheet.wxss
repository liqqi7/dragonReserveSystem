@import "../../styles/boardgames.wxss";
.sheet-scroll{width:100%}.sheet-table{display:table;min-width:100%;border-collapse:collapse}.sheet-line{display:flex;min-height:94rpx;border-bottom:1rpx solid #E5E7EB;align-items:stretch}.sheet-label{width:178rpx;flex:none;font-size:23.08rpx;padding:20rpx 10rpx;box-sizing:border-box;background:#fff;position:sticky;left:0;z-index:1}.sheet-cell{width:164rpx;flex:none;padding:14rpx 8rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center}.sheet-cell.head{font-weight:700;background:#F5F5F5}.sheet-input{width:100%;min-width:0;border-radius:12rpx;background:#F5F5F5;font-size:23.08rpx;min-height:66rpx;text-align:center}.sheet-value{font-size:23.08rpx;font-variant-numeric:tabular-nums;word-break:break-word}.sheet-mark{min-width:64rpx;height:64rpx;background:#F5F5F5;border-radius:12rpx;display:flex;align-items:center;justify-content:center;color:#9CA3AF}.sheet-mark.selected{background:#FF9800;color:#fff}.sheet-pages{display:flex;justify-content:space-between;gap:20rpx;margin:20rpx 0;align-items:center}.sheet-summary{display:flex;gap:20rpx;flex-wrap:wrap}.sheet-total{background:#FFF3E0;padding:20rpx;border-radius:18rpx;min-width:130rpx}.sheet-total-name{font-size:23.08rpx;color:#7C3A05}.sheet-total-score{font-size:38.46rpx;font-weight:700;margin-top:8rpx}.sheet-controls{display:flex;gap:12rpx;margin:20rpx 0;flex-wrap:wrap}.sheet-label-action{display:block;color:#FF9800;font-size:23.08rpx;margin-top:12rpx}
