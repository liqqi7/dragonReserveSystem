page {
  background: #09090b;
  overflow: hidden;
}

.chwazi-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  color: #ffffff;
  transition: background-color 0.18s ease;
}

.chwazi-page--selected {
  transition: none;
}

.chwazi-navbar {
  position: relative;
  z-index: 110;
  box-sizing: border-box;
  height: auto;
  padding-left: 38.46rpx;
  padding-right: 38.46rpx;
}

.chwazi-navbar-inner {
  display: flex;
  box-sizing: border-box;
  height: 84.61538rpx;
  align-items: center;
  justify-content: space-between;
}

.chwazi-back,
.chwazi-navbar-placeholder {
  display: flex;
  width: 61.54rpx;
  height: 61.54rpx;
  align-items: center;
  justify-content: center;
}

.chwazi-back image {
  width: 34.61538rpx;
  height: 34.61538rpx;
  transform: translateX(-7.69231rpx);
}

.chwazi-title {
  color: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 38.46154rpx;
  font-weight: 700;
  line-height: 1.4;
}

.chwazi-stage {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 1038.46rpx;
  margin-top: 80.76923rpx;
  overflow: hidden;
}

.chwazi-stage--selected {
  height: 1269.23077rpx;
  margin-top: 76.92308rpx;
}

.touch-point {
  position: absolute;
  width: 230.77rpx;
  height: 230.77rpx;
}

.touch-ring-progress {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 230.77rpx;
  height: 230.77rpx;
  border-radius: 50%;
}

.touch-ring-half {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
}

.touch-ring-half--right {
  right: 0;
}

.touch-ring-half--left {
  left: 0;
}

.touch-ring-arc {
  position: absolute;
  top: 0;
  box-sizing: border-box;
  width: 230.77rpx;
  height: 230.77rpx;
  border: 17.30769rpx solid transparent;
  border-radius: 50%;
  transform: rotate(-135deg);
  animation-duration: 1500ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  will-change: transform;
}

.touch-ring-arc--right {
  right: 0;
  animation-name: chwazi-ring-right;
}

.touch-ring-arc--left {
  left: 0;
  animation-name: chwazi-ring-left;
}

.touch-ring-cutout {
  position: absolute;
  top: 17.30769rpx;
  left: 17.30769rpx;
  z-index: 2;
  width: 196.15385rpx;
  height: 196.15385rpx;
  border-radius: 50%;
  background: #09090b;
}

.touch-ring-cap-rotator {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 230.77rpx;
  height: 230.77rpx;
  transform-origin: center;
  animation: chwazi-ring-cap 1500ms linear forwards;
  will-change: transform;
}

.touch-ring-cap {
  position: absolute;
  z-index: 3;
  width: 17.30769rpx;
  height: 17.30769rpx;
  border-radius: 50%;
  opacity: 0;
  animation: chwazi-ring-cap-visible 1500ms linear forwards;
}

.touch-ring-cap--start,
.touch-ring-cap--end {
  top: 0;
  left: 106.73077rpx;
}

.touch-point--selected::before {
  position: absolute;
  top: -23.08rpx;
  left: -23.08rpx;
  z-index: 0;
  width: 276.92rpx;
  height: 276.92rpx;
  border-radius: 50%;
  background: #09090b;
  content: "";
}

.touch-inner {
  position: absolute;
  z-index: 4;
  width: 157.69rpx;
  height: 157.69rpx;
  border-radius: 50%;
}

.chwazi-too-many {
  position: absolute;
  top: 373.08rpx;
  right: 46.15rpx;
  left: 46.15rpx;
  display: block;
  width: auto;
  color: #ffffff;
  font-family: "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 32.69rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: center;
  white-space: pre-line;
}

.chwazi-bottom-spacer {
  width: 100%;
}

.chwazi-winner-curtain {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: #09090b;
  pointer-events: none;
  animation: chwazi-collapse-to-winner 480ms cubic-bezier(0.65, 0, 0.35, 1) both;
  will-change: transform;
}

.chwazi-winner-curtain-stage {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1038.46rpx;
  overflow: hidden;
}

.winner-curtain-touch {
  position: absolute;
  width: 230.77rpx;
  height: 230.77rpx;
}

.winner-curtain-ring {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: 230.77rpx;
  height: 230.77rpx;
  border: 17.30769rpx solid;
  border-radius: 50%;
}

.winner-curtain-inner {
  position: absolute;
  top: 36.53846rpx;
  left: 36.53846rpx;
  width: 157.69rpx;
  height: 157.69rpx;
  border-radius: 50%;
}

@keyframes chwazi-ring-right {
  0% {
    transform: rotate(-135deg);
  }

  50%,
  100% {
    transform: rotate(45deg);
  }
}

@keyframes chwazi-ring-left {
  0%,
  50% {
    transform: rotate(-135deg);
  }

  100% {
    transform: rotate(45deg);
  }
}

@keyframes chwazi-ring-cap {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes chwazi-ring-cap-visible {
  0% {
    opacity: 0;
  }

  0.1%,
  100% {
    opacity: 1;
  }
}

@keyframes chwazi-collapse-to-winner {
  from {
    transform: scale(1);
  }

  to {
    transform: scale(0);
  }
}
