<view class="memory-screen" style="padding-top:{{top}}px;">
  <view class="memory-nav"><view class="memory-back" bindtap="back" aria-role="button" aria-label="返回"><image src="/images/memory-back-dark.svg" /></view><button class="memory-nav-title review-filter" bindtap="chooseStatus" aria-label="切换审核状态">{{status === 'pending' ? '内容审核' : statusLabel}}<image src="/images/memory-chevron.svg" /></button></view>
  <view class="memory-body review-stage" style="margin-bottom:{{bottom}}rpx;">
  <scroll-view class="review-scroll" type="list" scroll-y bindscrolltolower="more">
    <view class="review-list">
    <view wx:for="{{items}}" wx:key="id" class="review-item">
      <view class="review-preview" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.cover}}" class="review-cover" src="{{item.cover}}" mode="aspectFill" /><image wx:if="{{item.videoCover}}" class="review-play" src="/images/memory-play.svg" /><text wx:if="{{item.media_count > 1}}" class="review-count">1/{{item.media_count}}</text></view>
      <view class="review-copy">
        <view class="review-author"><image src="{{item.author.avatar_url}}" mode="aspectFill" /><text class="review-nickname" max-lines="1" overflow="ellipsis">{{item.author.nickname}}</text><text class="review-created">{{item.createdLabel}}</text></view>
        <view wx:if="{{item.caption}}" class="review-caption-row"><text wx:if="{{item.expanded}}" class="review-caption">{{item.caption}}</text><text wx:else class="review-caption" max-lines="1" overflow="ellipsis">{{item.caption}}</text><button class="review-expand" data-id="{{item.id}}" bindtap="toggleCaption">{{item.expanded ? '收起' : '展开'}}</button></view>
        <view class="review-meta"><view><image src="{{item.video_count > 0 ? '/images/memory-review-timer.svg' : '/images/memory-review-image.svg'}}" /><text>{{item.mediaLabel}}</text></view><view wx:if="{{item.sizeLabel}}"><image src="/images/memory-review-size.svg" /><text>{{item.sizeLabel}}</text></view><view wx:if="{{item.activity_name}}" class="review-activity"><image src="/images/memory-review-activity.svg" /><text max-lines="1" overflow="ellipsis">{{item.activity_name}}</text></view></view>
      </view>
      <view class="memory-actions review-actions"><button wx:if="{{status === 'pending'}}" class="review-reject" data-id="{{item.id}}" bindtap="askReject" disabled="{{busy}}">不通过</button><button class="{{status === 'pending' ? 'review-approve' : 'memory-neutral'}}" data-id="{{item.id}}" bindtap="open">{{status === 'pending' ? '通过' : '查看内容'}}</button><button wx:if="{{status === 'rejected' || status === 'offline' || status === 'failed' || status === 'draft'}}" class="memory-neutral" data-id="{{item.id}}" bindtap="askCleanup" disabled="{{busy}}">清理素材</button></view>
    </view>
    </view>
    <view wx:if="{{error}}" class="memory-state"><text>{{error}}</text><button bindtap="retry">重试</button></view>
    <view wx:if="{{loading}}" class="memory-state"><text>加载中</text></view>
  </scroll-view>
  <view wx:if="{{!items.length && !loading && !error}}" class="review-empty"><view class="review-empty-art"><image src="/images/memory-review-empty.svg" /></view><view class="review-empty-copy"><text class="review-empty-title">{{status === 'pending' ? '暂无待审核内容' : '暂无内容'}}</text><text>用户上传的视频和图片会出现在这里</text></view></view>
  </view>
</view>
<create-access-dialog id="memory-confirm" bind:confirm="confirmAction" />
<create-access-dialog id="session-expired-dialog" />
