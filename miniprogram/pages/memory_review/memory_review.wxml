<view class="memory-screen" style="padding-top:{{top}}px;">
  <view class="memory-nav"><view class="memory-back" bindtap="back" aria-role="button" aria-label="返回"><image src="/images/memory-back-dark.svg" /></view><view class="memory-nav-title review-filter" bindtap="chooseStatus" aria-role="button" aria-label="切换审核状态"><view class="review-title-copy"><text>{{status === 'pending' ? '内容审核' : statusLabel}}</text><image src="/images/memory-chevron.svg" /></view></view></view>
  <view class="memory-body review-stage">
  <scroll-view class="review-scroll" type="list" scroll-y="{{!filterOpen}}" bindscrolltolower="more" bindscroll="scroll">
    <view class="review-list" style="padding-bottom:{{bottom + 30.76923}}rpx;">
    <view wx:for="{{items}}" wx:key="id" class="review-item">
      <view class="review-preview" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.cover}}" class="review-cover memory-window-image" data-url="{{item.cover}}" src="{{imageSources[item.cover] || ''}}" mode="aspectFill" /><image wx:if="{{item.videoCover}}" class="review-play" src="/images/memory-play.svg" /></view>
      <view class="review-copy">
        <view class="review-author"><image src="{{item.author.avatar_url}}" mode="aspectFill" /><text class="review-nickname" max-lines="1" overflow="ellipsis">{{item.author.nickname}}</text><text class="review-created">{{item.createdLabel}}</text></view>
        <view wx:if="{{item.caption}}" class="review-caption-row">
          <text wx:if="{{!item.captionMeasured}}" class="review-caption review-caption-measure" data-id="{{item.id}}" aria-hidden="true">{{item.caption}}</text>
          <text wx:if="{{item.expanded}}" class="review-caption">{{item.caption}}</text>
          <text wx:else class="review-caption review-caption-preview" data-id="{{item.id}}" max-lines="1" overflow="ellipsis">{{item.caption}}</text>
          <view wx:if="{{item.captionExpandable}}" class="review-expand" data-id="{{item.id}}" bindtap="toggleCaption" aria-role="button" aria-label="{{item.expanded ? '收起备注' : '展开备注'}}"><text>{{item.expanded ? '收起' : '展开'}}</text></view>
        </view>
        <view class="review-meta"><view><image src="{{item.video_count > 0 ? '/images/memory-review-timer.svg' : '/images/memory-review-image.svg'}}" /><text>{{item.mediaLabel}}</text></view><view wx:if="{{item.sizeLabel}}"><image src="/images/memory-review-size.svg" /><text>{{item.sizeLabel}}</text></view><view wx:if="{{item.activity_name}}" class="review-activity"><image src="/images/memory-review-activity.svg" /><text max-lines="1" overflow="ellipsis">{{item.activity_name}}</text></view></view>
      </view>
      <text class="review-created">{{item.statusLabel}}</text>
      <view class="memory-actions review-actions">
        <button wx:if="{{item.status === 'pending'}}" class="review-reject" data-id="{{item.id}}" bindtap="reject" disabled="{{busy}}">不通过</button>
        <button wx:if="{{item.status === 'pending'}}" class="review-approve" data-id="{{item.id}}" bindtap="approve" disabled="{{busy}}">通过</button>
        <button wx:if="{{item.status === 'rejected'}}" class="review-approve" data-id="{{item.id}}" data-action="reopen" bindtap="resourceAction" disabled="{{busy}}">重新审核</button>
        <button wx:if="{{item.status === 'published'}}" class="review-reject" data-id="{{item.id}}" data-action="offline" bindtap="resourceAction" disabled="{{busy}}">内容下架</button>
        <button wx:if="{{item.status === 'failed' || item.status === 'offline'}}" class="review-approve" data-id="{{item.id}}" data-action="{{item.status === 'failed' ? 'retry' : 'republish'}}" bindtap="resourceAction" disabled="{{busy}}">{{item.status === 'failed' ? '重新压缩' : '重新上架'}}</button>
        <button wx:if="{{item.status === 'processing'}}" class="memory-neutral" disabled>压缩中</button>
        <button wx:if="{{item.status === 'rejected' || item.status === 'offline' || item.status === 'failed'}}" class="review-reject" data-id="{{item.id}}" bindtap="askCleanup" disabled="{{busy}}">删除</button>
      </view>
    </view>
    </view>
    <view wx:if="{{error}}" class="memory-state"><text>{{error}}</text><button bindtap="retry">重试</button></view>
    <view wx:if="{{loading}}" class="memory-state"><text>加载中</text></view>
  </scroll-view>
  <view wx:if="{{!items.length && !loading && !error}}" class="review-empty"><view class="review-empty-art"><image src="/images/memory-review-empty.svg" /></view><view class="review-empty-copy"><text class="review-empty-title">{{status === 'pending' ? '暂无待审核内容' : '暂无内容'}}</text><text>用户上传的视频和图片会出现在这里</text></view></view>
  </view>
  <view wx:if="{{filterOpen}}" class="memory-sheet-overlay" bindtap="closeFilter">
    <view class="memory-sheet review-status-menu" catchtap="stopTap" style="padding-bottom:{{bottom}}rpx;">
      <scroll-view type="list" scroll-y show-scrollbar="{{false}}" class="review-status-options" style="height:{{filterHeight}}px;">
        <view wx:for="{{tabs}}" wx:key="id" class="review-status-option" data-status="{{item.id}}" bindtap="tab" aria-role="button" aria-label="{{item.name + (statusCounts ? '，' + statusCounts[item.id] + '项' : '') + (status === item.id ? '，当前状态' : '')}}"><text>{{item.name}}（{{statusCounts ? statusCounts[item.id] : '…'}}）</text></view>
      </scroll-view>
      <view class="review-status-cancel" bindtap="closeFilter" aria-role="button" aria-label="取消"><text>取消</text></view>
    </view>
  </view>
</view>
<create-access-dialog id="memory-confirm" bind:confirm="confirmAction" />
<create-access-dialog id="session-expired-dialog" />
