@import "../../styles/memory.wxss";
@import "../../styles/memoryMedia.wxss";
@import "../../styles/memorySheet.wxss";
.review-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7.69231rpx;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
}
.review-title-copy {
  position: relative;
  display: flex;
  align-items: center;
}
.review-filter image {
  position: absolute;
  left: 100%;
  margin-left: 7.69231rpx;
  top: 50%;
  width: 23.07692rpx;
  height: 23.07692rpx;
  transform: translateY(-50%) rotate(90deg);
}
.review-filter text {
  font-size: 20px;
  line-height: 1.4;
  font-weight: 700;
  color: #000000;
}
.review-status-menu {
  height: auto;
  max-height: 85vh;
  padding: 0;
}
.review-status-options {
  width: 100%;
  flex: none;
}
.review-status-option,
.review-status-cancel {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 34.61538rpx;
  line-height: 1.2;
}
.review-status-option {
  border-bottom: 1rpx solid #e5e7eb;
}
.review-status-cancel {
  height: 112rpx;
  flex: none;
  border-top: 12rpx solid #f5f5f5;
}
.review-stage {
  position: relative;
}
.review-scroll {
  height: 100%;
}
.review-list {
  padding: 30.76923rpx 38.46154rpx;
  display: flex;
  flex-direction: column;
  gap: 23.07692rpx;
}
.review-item {
  padding: 23.07692rpx;
  background: #ffffff;
  border-radius: 46.15385rpx;
  display: flex;
  flex-direction: column;
  gap: 23.07692rpx;
  box-shadow: 0 11.53846rpx 38.46154rpx rgba(0, 0, 0, 0.1);
}
.review-preview {
  position: relative;
  height: 330.76923rpx;
  border-radius: 23.07692rpx;
  overflow: hidden;
  background: #e5e7eb;
}
.review-cover {
  display: block;
  width: 100%;
  height: 100%;
}
.review-copy {
  display: flex;
  flex-direction: column;
  gap: 15.38462rpx;
  color: #171a24;
}
.review-author {
  display: flex;
  align-items: center;
  gap: 15.38462rpx;
  font-size: 26.92308rpx;
  line-height: 1.2;
  font-weight: 600;
}
.review-author image {
  width: 53.84615rpx;
  height: 53.84615rpx;
  flex: none;
  border-radius: 50%;
}
.review-nickname {
  flex: 1;
  min-width: 0;
}
.review-created {
  flex: none;
  font-size: 23.07692rpx;
  color: #98a2b3;
  font-weight: 400;
}
.review-caption-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 15.38462rpx;
}
.review-caption {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 26.92308rpx;
  line-height: 1.2;
  word-break: break-all;
}
.review-caption-measure {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  visibility: hidden;
  pointer-events: none;
}
.review-expand {
  display: flex;
  align-self: flex-end;
  min-width: 0;
  width: auto;
  padding: 0;
  margin: 0;
  flex: none;
  background: transparent;
  color: #667085;
  font-size: 23.07692rpx;
  line-height: 1.2;
}
.review-meta {
  display: flex;
  align-items: center;
  gap: 30.76923rpx;
  color: #667085;
  font-size: 23.07692rpx;
  line-height: 1.2;
}
.review-meta > view {
  display: flex;
  align-items: center;
  gap: 7.69231rpx;
  flex: none;
}
.review-meta image {
  width: 23.07692rpx;
  height: 23.07692rpx;
  flex: none;
}
.review-meta .review-activity {
  flex: 1;
  min-width: 0;
}
.review-activity text {
  flex: 1;
  min-width: 0;
}
.review-actions {
  gap: 19.23077rpx;
}
.review-actions button {
  height: 76.92308rpx;
  border-radius: 19.23077rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26.92308rpx;
  line-height: 1.2;
  font-weight: 600;
}
.review-reject {
  background: #fef2f2;
  color: #e5484d;
}
.review-approve {
  background: #ff9800;
  color: #ffffff;
}
.review-empty {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30.76923rpx;
}
.review-empty-art {
  width: 230.76923rpx;
  height: 230.76923rpx;
  border-radius: 50%;
  background: #f0f1f3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.review-empty-art image {
  width: 84.61538rpx;
  height: 84.61538rpx;
}
.review-empty-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11.53846rpx;
  color: #98a2b3;
  font-size: 23.07692rpx;
  line-height: 1.2;
}
.review-empty-title {
  color: #171a24;
  font-size: 30.76923rpx;
  font-weight: 600;
}
