.project-member-row-wrap { position: relative; width: 100%; height: 123.08rpx; overflow: hidden; border-radius: 23.08rpx; margin-bottom: 0; }
.project-member-row-wrap--spaced { margin-bottom: 7.69rpx; }
.project-member-row { position: relative; width: 100%; height: 123.08rpx; background: #ffffff; border-radius: 23.08rpx; display: flex; align-items: center; box-sizing: border-box; }
.project-member-cell { height: 123.08rpx; padding-left: 23.08rpx; display: flex; align-items: center; gap: 15.38rpx; min-width: 0; }
.project-member-avatar { flex: 0 0 76.92rpx; width: 76.92rpx; height: 76.92rpx; border-radius: 50%; background: #e5e7eb; }
.project-member-name { width: 140.38rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23.08rpx; line-height: 36.23rpx; font-weight: 500; color: #111827; }
.project-empty { color: #9ca3af; font-size: 26.92rpx; }

.detail-scroll-content { display: flex; flex-direction: column; height: 100%; }
.detail-scroll-content--projects { height: auto; min-height: 100%; }
.detail-scroll-content--projects .immersive-hero { flex: 0 0 750rpx; }
.detail-scroll-content--projects .detail-panel { margin-top: -107.69rpx; padding-bottom: 46.15rpx; }
.detail-scroll-content--projects .hero-copy { bottom: calc(107.69rpx + 46.15rpx); }
.detail-scroll-content--projects .facts-row { margin-top: 23.08rpx; }
