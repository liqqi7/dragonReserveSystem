  height: 26.92rpx;
}

.hero-remark-measure,
.remark-toggle-measure {
  position: fixed;
  left: -10000rpx;
  top: 0;
  pointer-events: none;
  visibility: hidden;
}

.hero-remark-measure {
  display: inline-block;
  width: auto;
