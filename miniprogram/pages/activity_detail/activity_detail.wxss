page {
  height: 100%;
  overflow: hidden;
  background: #ffffff;
}

.page-wrap {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

.main-scroll {
  position: relative;
  overflow: hidden;
  background: #ffffff;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
  box-sizing: border-box;
}

.state-block-full {
  min-height: 100vh;
}

.state-text {
  font-size: 28rpx;
  color: #6b7280;
}

.retry-btn {
  margin-top: 32rpx;
  min-width: 192rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 24rpx;
  background: #ff9800;
  color: #ffffff;
  font-size: 28rpx;
}

.retry-btn::after,
.bottom-icon-button::after,
.bottom-primary::after {
  display: none;
}

.immersive-hero {
  position: relative;
  width: 100%;
  height: 750rpx;
  overflow: hidden;
  background: #d1d5db;
}

.hero-img,
.hero-video,
.hero-placeholder,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  background: linear-gradient(145deg, #dbe3e0 0%, #738b83 100%);
}

.hero-shade {
  z-index: 4;
  background:
    radial-gradient(120% 108% at 50% 42%, rgba(0, 0, 0, 0) 52%, rgba(0, 0, 0, 0.059) 76%, rgba(0, 0, 0, 0.169) 100%),
    linear-gradient(180deg, rgba(0, 0, 0, 0.259) 0%, rgba(0, 0, 0, 0.102) 24%, rgba(0, 0, 0, 0.18) 50%, rgba(0, 0, 0, 0.459) 72%, rgba(0, 0, 0, 0.78) 88%, rgba(0, 0, 0, 0.91) 100%);
  background-blend-mode: multiply, normal;
  pointer-events: none;
}

.hero-avatar-cluster {
  position: absolute;
  inset: 0;
  z-index: 2;
}

.hero-avatar {
  position: absolute;
  overflow: hidden;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
}

/*
 * 详情主视觉按首页大卡 276px 宽的头像布局等比放大到 390px（750rpx）。
 * 保持头像与背景使用同一宽度缩放基准，避免只放大背景导致构图漂移。
 */
.hero-avatar-tl {
  top: 43.48rpx;
  left: 43.48rpx;
  width: 448.37rpx;
  height: 448.37rpx;
}

.hero-avatar-tr {
  top: 364.13rpx;
  left: 451.09rpx;
  width: 255.43rpx;
  height: 255.43rpx;
}

.hero-avatar-mid {
  top: 505.43rpx;
  left: 233.70rpx;
  width: 222.83rpx;
  height: 222.83rpx;
}

.hero-cluster-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.custom-navbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: border-box;
}

