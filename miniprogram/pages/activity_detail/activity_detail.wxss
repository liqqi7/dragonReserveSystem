  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.signup-profile-modal-body {
  padding: 24rpx;
  flex: 1;
  overflow-y: auto;
}

.signup-profile-hint {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff1f2;
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.5;
}

.signup-profile-form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.signup-profile-form-item {
  margin-bottom: 24rpx;
}

.signup-profile-label {
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}

.signup-profile-form-row .signup-profile-label {
  margin-bottom: 0;
}

.signup-profile-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.signup-profile-avatar-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fafafa;
}

.signup-profile-avatar-btn::after {
  border: none;
}

.signup-profile-avatar-img {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

.signup-profile-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 22rpx;
  color: #888;
}

.signup-profile-input {
  width: 100%;
  height: 72rpx;
  line-height: 40rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ddd;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  box-sizing: border-box;
}

.signup-profile-modal-footer {
  display: flex;
  padding: 24rpx;
  border-top: 1rpx solid #eee;
  gap: 16rpx;
}

.signup-profile-btn {
  flex: 1;
  margin: 0;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  border: none;
}

.signup-profile-btn-default {
  background-color: #f0f0f0;
  color: #333;
}

.signup-profile-btn-primary {
  background-color: #1989fa;
  color: #ffffff;
}

.signup-profile-btn-disabled {
  opacity: 0.45;
}


