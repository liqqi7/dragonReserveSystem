}

.remark-toggle {
  height: 38.46rpx;
  display: flex;
  align-items: center;
  gap: 7.69rpx;
  flex-shrink: 0;
}

.remark-toggle-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 23.08rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.remark-toggle-label {
  position: relative;
  width: 46.15rpx;
  height: 38.46rpx;
  overflow: hidden;
}

.remark-toggle-label .remark-toggle-text {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translateY(0);
  transition: opacity 160ms ease-out, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.remark-toggle-label .remark-toggle-text-active {
  opacity: 1;
  transform: translateY(0);
}

.remark-toggle-label .remark-toggle-text-out-up {
  opacity: 0;
  transform: translateY(-7.69rpx);
}

.remark-toggle-label .remark-toggle-text-out-down {
  opacity: 0;
  transform: translateY(7.69rpx);
}

.remark-chevron-rotator {
  width: 26.92rpx;
  height: 26.92rpx;
  flex-shrink: 0;
  transform: rotate(0deg);
  transform-origin: center;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.remark-chevron {
  position: relative;
  width: 26.92rpx;
  height: 26.92rpx;
}

.remark-chevron::after {
  content: "";
  position: absolute;
  left: 8.65rpx;
  top: 5.77rpx;
  width: 9.62rpx;
  height: 9.62rpx;
  border-right: 2.31rpx solid rgba(255, 255, 255, 0.8);
  border-bottom: 2.31rpx solid rgba(255, 255, 255, 0.8);
  transform: rotate(45deg);
  transform-origin: center;
}

.hero-remark-full-measure,
.remark-toggle-measure {
  position: fixed;
  left: -10000rpx;
  top: 0;
  pointer-events: none;
  visibility: hidden;
}

