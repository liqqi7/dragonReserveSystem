.library-content { padding:23.07692rpx 30.76923rpx 0; }
.library-search { height:80.76923rpx;display:flex;align-items:center;gap:19.23077rpx;padding:0 26.92308rpx;background:white;border:1.92308rpx solid #E5E7EB;border-radius:30.76923rpx;box-sizing:border-box; }
.library-search-icon { width:34.61538rpx;height:34.61538rpx;flex:none; }
.library-search-input { flex:1;min-width:0;height:76.92308rpx;font-size:26.92308rpx;color:#111827; }
.library-section { margin-top:38.46154rpx; }
.library-section-head { display:flex;align-items:center;justify-content:space-between;min-height:53.84615rpx;margin-bottom:23.07692rpx; }
.library-section-title { font-size:38.46154rpx;line-height:53.84615rpx;font-weight:700; }
.library-filter-link { display:flex;align-items:center;gap:11.53846rpx;font-size:23.07692rpx;line-height:34.61538rpx;color:#4B5563; }
.library-chevron { width:23.07692rpx;height:23.07692rpx; }
