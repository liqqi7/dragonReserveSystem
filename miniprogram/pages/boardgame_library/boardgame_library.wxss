page { background:#FFFFFF;color:#111827; }
.library-page { height:100vh;display:flex;flex-direction:column;background:#FFFFFF;box-sizing:border-box; }
.library-nav { display:flex;align-items:center;justify-content:space-between;padding:0 30.76923rpx;box-sizing:border-box; }
.library-back,.library-nav-spacer { width:84.61538rpx;height:84.61538rpx;flex:none; }
.library-back { display:flex;align-items:center; }
.library-back image { width:46.15385rpx;height:46.15385rpx; }
