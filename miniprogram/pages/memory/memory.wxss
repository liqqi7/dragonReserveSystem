@import "../../styles/dragonChrome.wxss";
@import "../../styles/memoryMedia.wxss";
page {
  background: #f8fafc;
  color: #111827;
}
.memory-page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.memory-heading {
  position: relative;
  z-index: 2;
  flex: none;
  height: 84.61538rpx;
  padding: 0 38.46154rpx;
  display: flex;
  align-items: center;
  font-size: 46.15385rpx;
  font-weight: 700;
}
.memory-scroll {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
}
.memory-card-slot {
  position: relative;
}
.memory-card-transition {
  display: block;
  width: 100%;
  height: 100%;
}
.memory-cover {
  display: block;
  position: relative;
  overflow: hidden;
  border-radius: 23.07692rpx;
  background: #f3f4f6;
}
.memory-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}
.memory-empty {
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #6b7280;
  font-size: 28rpx;
}
.memory-empty button {
  font-size: 28rpx;
  color: #ff9800;
  background: #f3f4f6;
}
