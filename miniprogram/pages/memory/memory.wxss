@import "../../styles/dragonChrome.wxss";
@import "../../styles/memoryMedia.wxss";
@import "../../styles/cardSkeleton.wxss";
page {
  background: #f8fafc;
  color: #111827;
}
.memory-page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.memory-heading {
  position: relative;
  z-index: 2;
  flex: none;
  height: 84.61538rpx;
  padding: 0 38.46154rpx;
  display: flex;
  align-items: center;
  font-size: 46.15385rpx;
  font-weight: 600;
  line-height: 65.38462rpx;
}
.memory-scroll {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
}
.memory-card-slot {
  position: relative;
}
.memory-web-grid { display: flex; align-items: flex-start; box-sizing: border-box; }
.memory-web-column { display: flex; flex-direction: column; min-width: 0; }
.memory-card-transition {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
  /* The opaque content stays behind the fading skeleton, avoiding a page-color flash. */
  transition: none;
}
.memory-card-transition--ready { opacity: 1; pointer-events: auto; }
.memory-card-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 23.07692rpx;
  background: #EAECEF;
  opacity: 1;
  transition: opacity 440ms ease-out;
}
.memory-card-skeleton--ready { opacity: 0; pointer-events: none; }
.memory-initial-skeleton { background: #EAECEF; }
.memory-cover-retry {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  font-size: 25rpx;
  background: transparent;
}
.memory-cover {
  display: block;
  position: relative;
  overflow: hidden;
  border-radius: 23.07692rpx;
  background: #EAECEF;
}
.memory-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}
.memory-empty {
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #6b7280;
  font-size: 28rpx;
}
.memory-empty button {
  font-size: 28rpx;
  color: #ff9800;
  background: #f3f4f6;
}
