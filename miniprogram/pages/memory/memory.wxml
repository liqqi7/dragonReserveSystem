<view class="memory-page" style="padding-top:{{top}}px;">
  <image class="dragon-watermark dragon-watermark--absolute" src="/images/activity-home-logo.png" mode="aspectFit" aria-hidden="true" />
  <scroll-view class="memory-scroll" type="custom" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh" bindscrolltolower="more" bindscroll="scroll">
    <list-view><view class="memory-heading"><text>记忆</text></view></list-view>
    <grid-view type="masonry" cross-axis-count="2" cross-axis-gap="{{gridGap}}" main-axis-gap="{{gridGap}}" padding="{{gridPadding}}">
      <view wx:for="{{items}}" wx:key="id" class="memory-card-slot" style="width:{{cardWidth}}px;height:{{item.coverHeight}}px;">
        <open-container class="memory-card-transition" closed-color="transparent" closed-elevation="0" closed-border-radius="{{cardRadius}}" middle-color="#000000" open-color="#000000" open-elevation="0" open-border-radius="0" transition-type="fadeThrough" transition-duration="320" data-id="{{item.id}}" bind:tap="open" aria-role="button" aria-label="查看记忆">
          <view class="memory-cover" style="width:{{cardWidth}}px;height:{{item.coverHeight}}px;">
            <image class="memory-cover-image memory-window-image" data-url="{{item.cover}}" src="{{imageSources[item.cover] || ''}}" mode="aspectFill" />
            <image wx:if="{{item.videoCover}}" class="memory-play" src="/images/memory-play.svg" mode="aspectFit" />
          </view>
        </open-container>
      </view>
    </grid-view>
    <view wx:if="{{!loading && !items.length && !error}}" class="memory-empty"><text>暂无记忆</text></view>
    <view wx:if="{{error}}" class="memory-empty"><text>{{error}}</text><button bindtap="retry">重试</button></view>
    <view wx:if="{{loading}}" class="memory-empty"><text>加载中</text></view>
  </scroll-view>
</view>
<create-access-dialog id="create-access-dialog" />
<create-access-dialog id="session-expired-dialog" />
