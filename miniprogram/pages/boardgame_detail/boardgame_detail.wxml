<import src="../../templates/boardgame-name.wxml"/>
<view class="bg-page">
  <view wx:if="{{error}}" class="bg-error" bindtap="load">{{error}} · 点击重试</view><view wx:if="{{loading && !game}}" class="bg-empty">正在加载…</view>
  <block wx:if="{{game}}">
    <view class="detail-hero"><image wx:if="{{game.cover_url}}" class="detail-cover" data-path="game.cover_url" binderror="imageError" src="{{game.cover_url}}" mode="aspectFill"/><view wx:else class="detail-cover bg-cover placeholder">暂无封面</view><view class="bg-grow"><text class="bg-badge">{{game.game_type === 'expansion' ? '扩展' : '本体'}}{{game.is_standalone ? ' · 可独立游玩' : ''}}</text><template is="boardgame-name" data="{{game:game, titleClass:'bg-title'}}"/><view class="detail-meta">{{!game.min_players && !game.max_players ? '人数未记录' : game.min_players && game.max_players && game.min_players !== game.max_players ? game.min_players + '–' + game.max_players + ' 人' : (game.max_players || game.min_players) + ' 人'}}<view>{{!game.min_playtime_minutes && !game.max_playtime_minutes ? '时长未记录' : game.min_playtime_minutes && game.max_playtime_minutes && game.min_playtime_minutes !== game.max_playtime_minutes ? game.min_playtime_minutes + '–' + game.max_playtime_minutes + ' 分钟' : (game.max_playtime_minutes || game.min_playtime_minutes) + ' 分钟'}}</view><view>复杂度 {{game.complexity || '未记录'}}</view></view><text wx:if="{{game.permissions.can_edit}}" class="bg-link" bindtap="openEdit">编辑资料</text></view></view>
    <view class="bg-row bg-wrap"><button class="bg-button bg-grow" bindtap="record">记录一局</button><button class="bg-button secondary" bindtap="openPreference">{{preference.want_to_play ? '已标记想玩' : '我的偏好'}}</button></view>
    <view wx:if="{{pendingMessage}}" class="bg-notice">{{pendingMessage}}</view>
    <view class="bg-row bg-wrap detail-tabs"><button class="bg-chip {{tab === 'info' ? 'active' : ''}}" data-tab="info" bindtap="setTab">游戏资料</button><button class="bg-chip {{tab === 'inventory' ? 'active' : ''}}" data-tab="inventory" bindtap="setTab">馆藏 {{game.inventory_summary.total}}</button><button class="bg-chip" bindtap="history">游玩记录</button></view>
    <block wx:if="{{tab === 'info'}}"><view class="bg-card"><view class="detail-section-title">游戏资料</view><view class="detail-description {{descriptionOpen ? 'expanded' : 'collapsed'}}" style="margin-top:20rpx">{{game.description || '还没有游戏介绍，可以先录入名字，再慢慢补全。'}}</view><text wx:if="{{game.description.length > 100}}" class="bg-link" bindtap="toggleDescription">{{descriptionOpen ? '收起介绍' : '展开全部介绍'}}</text></view>
      <view class="bg-heading"><text>本体与扩展</text><text wx:if="{{isAdmin}}" class="bg-link" bindtap="openCompatibility">管理关系</text></view><view wx:if="{{!expansions.length}}" class="bg-card bg-muted">暂未登记扩展关系</view><view wx:for="{{expansions}}" wx:key="expansion_game_id" class="bg-card bg-row bg-between" data-id="{{item.game.id}}" bindtap="openGame"><view class="bg-grow"><template is="boardgame-name" data="{{game:item.game}}"/><text class="bg-muted">{{item.manual_decision === 'block' ? '不兼容' : item.manual_decision === 'allow' ? '已确认兼容' : '来源建议，使用时核对'}}</text></view><text class="bg-link">查看 ›</text></view>
      <view class="bg-card bg-row bg-between" bindtap="statistics"><view><view class="detail-section-title">这款游戏的数据</view><text class="bg-muted">胜率、得分、连胜与计分分项</text></view><text class="bg-link">查看 ›</text></view>
      <view class="bg-card bg-row bg-between" bindtap="collection"><view><view class="detail-section-title">我的收藏与成本</view><text class="bg-muted">评分 {{preference.rating || '未填写'}} · {{prior.played_before ? '以前玩过' : '未标记既往游玩'}}</text></view><text class="bg-link">查看 ›</text></view>
    </block>
    <block wx:else><view class="bg-heading"><text>馆藏与可用性</text><text class="bg-link" bindtap="openBox">＋ 登记我的一盒</text></view><view class="bg-row bg-between"><text class="bg-muted">每盒分别记录归属和状态</text><text class="bg-link" data-kind="inventory" bindtap="manage">管理 / 已归档</text></view><view wx:if="{{!inventory.length}}" class="bg-empty">还没有人登记这款游戏</view>
      <view wx:for="{{inventory}}" wx:key="id" class="bg-card"><view class="bg-row bg-between"><view class="detail-owner">{{item.owner.display_name}}</view><text class="bg-badge">{{item.statusLabel}}</text></view><view class="detail-box-meta bg-muted">{{item.edition_label || item.edition_name || '版本未填写'}} · {{item.language_label || item.language || '语言未填写'}}<view>{{item.available_for_activity ? '可带到活动' : '暂未开放活动使用'}}</view><view wx:if="{{item.internal}}">购入日期 {{item.internal.purchased_on || '未填写'}}<view>购入价格 {{item.internal.purchase_price === null ? '未填写' : item.internal.purchase_price}} {{item.internal.purchase_currency || ''}}</view></view></view><view wx:if="{{item.permissions.can_edit}}" class="bg-link" style="margin-top:20rpx" data-id="{{item.id}}" bindtap="openBox">编辑这盒游戏</view></view><button wx:if="{{inventoryCursor}}" class="bg-button secondary full" bindtap="moreBoxes">更多实物</button></block>
    <view wx:if="{{game.permissions.can_edit}}" class="bg-list-item bg-row bg-between" data-kind="games" bindtap="manage"><text>资料维护</text><text class="bg-link">归档与重复资料核对 ›</text></view>
  </block>
</view>
<boardgame-sheet title="我的游戏偏好" kind="form" visible="{{prefOpen}}" bindclose="closePreference" busy="{{saving}}" size="high"><view wx:if="{{formError}}" class="bg-error">{{formError}}</view><view class="bg-label">我的评分（1–10）</view><input class="bg-input" type="digit" value="{{prefForm.rating}}" data-key="rating" bindinput="prefField" placeholder="未填写"/>
  <view class="bg-card"><view class="bg-row bg-between bg-list-item"><text>长期想玩</text><switch checked="{{prefForm.want_to_play}}" data-key="want_to_play" bindchange="prefField" color="#FF9800"/></view><view class="bg-row bg-between bg-list-item"><text>愿望单</text><switch checked="{{prefForm.wishlist}}" data-key="wishlist" bindchange="prefField" color="#FF9800"/></view><view class="bg-row bg-between bg-list-item"><text>已预订</text><switch checked="{{prefForm.preordered}}" data-key="preordered" bindchange="prefField" color="#FF9800"/></view></view>
  <view class="bg-label">私人笔记</view><textarea class="bg-input bg-textarea" maxlength="5000" value="{{prefForm.note}}" data-key="note" bindinput="prefField" placeholder="版本、喜好或下一次想试的玩法"/>
  <view class="bg-card"><view class="bg-row bg-between"><text>以前玩过，未逐局记录</text><switch checked="{{priorForm.played_before}}" data-key="played_before" bindchange="priorField" color="#FF9800"/></view><block wx:if="{{priorForm.played_before}}"><view class="bg-label">大约玩过多少次（可不填）</view><input class="bg-input" type="number" value="{{priorForm.approximate_count}}" data-key="approximate_count" bindinput="priorField" placeholder="次数未知"/></block></view><view class="bg-muted">既往次数只作收藏参考，不计入月份、活动和胜率统计。</view>
  <button slot="footer" class="bg-button full" loading="{{saving}}" disabled="{{saving}}" bindtap="savePreference">保存偏好</button>
</boardgame-sheet>
<boardgame-sheet title="{{boxId ? '编辑实物' : '登记实物'}}" kind="form" visible="{{inventoryOpen}}" bindclose="closeBox" busy="{{saving}}" size="high"><view wx:if="{{formError}}" class="bg-error">{{formError}}</view>
  <view class="bg-label">归属</view><picker wx:if="{{isAdmin && ownerOptions.length}}" range="{{ownerOptions}}" range-key="nickname" value="{{ownerIndex}}" bindchange="ownerChange"><view class="bg-input">{{ownerOptions[ownerIndex].nickname}}　⌄</view></picker><view wx:else class="bg-input">我的游戏</view>
  <text wx:if="{{isAdmin}}" class="bg-link" bindtap="openOwner">查找其他成员</text><input wx:if="{{box.owner_type === 'external'}}" class="bg-input" style="margin-top:16rpx" value="{{box.owner_label}}" data-key="owner_label" bindinput="boxField" placeholder="填写归属名称"/>
  <view class="bg-label">状态</view><picker range="{{statuses}}" range-key="label" value="{{boxStatusIndex}}" bindchange="boxStatus"><view class="bg-input">{{statuses[boxStatusIndex].label}}　⌄</view></picker><view class="bg-card bg-row bg-between"><text>可带到活动使用</text><switch checked="{{box.available_for_activity}}" disabled="{{box.status !== 'available'}}" data-key="available_for_activity" bindchange="boxField" color="#FF9800"/></view>
  <view class="bg-label">购入日期</view><view class="bg-input" bindtap="chooseDate">{{box.purchased_on || '未填写'}}　›</view><text wx:if="{{box.purchased_on}}" class="bg-link" bindtap="clearDate">清空日期</text><view class="bg-label">购入价格 / 币种</view><view class="bg-row"><input class="bg-input bg-grow" type="digit" value="{{box.purchase_price}}" data-key="purchase_price" bindinput="boxField" placeholder="未填写"/><input class="bg-input" style="width:110rpx" maxlength="3" value="{{box.purchase_currency}}" data-key="purchase_currency" bindinput="boxField" placeholder="CNY"/></view>
  <view wx:if="{{box.bgg_version_id}}" class="bg-notice">修改版本名称或语言会解除 BGG 版次关联，原选择保留在修改记录中。</view><view class="bg-label">版本 / 语言</view><input class="bg-input" value="{{box.edition_name}}" data-key="edition_name" bindinput="boxField" placeholder="版本名称（可选）"/><input class="bg-input" style="margin-top:16rpx" value="{{box.language}}" data-key="language" bindinput="boxField" placeholder="例如：简体中文"/>
  <view class="bg-label">存放位置（仅自己和管理员可见）</view><input class="bg-input" value="{{box.storage_location}}" data-key="storage_location" bindinput="boxField" placeholder="可不填写"/><view class="bg-label">排序值（越小越靠前）</view><input class="bg-input" type="number" value="{{box.sort_order}}" data-key="sort_order" bindinput="boxField"/>
  <block wx:if="{{!boxId}}"><view class="bg-label">实物数量（1–20）</view><input class="bg-input" type="number" value="{{box.quantity}}" data-key="quantity" bindinput="boxField"/></block><view class="bg-label">私人备注</view><textarea class="bg-input bg-textarea" value="{{box.remark}}" data-key="remark" bindinput="boxField" maxlength="5000"/>
  <button wx:if="{{boxId}}" class="bg-button danger full" style="margin-top:24rpx" bindtap="archiveBox" disabled="{{saving}}">归档这盒游戏</button><view wx:if="{{boxId}}" class="bg-subtitle">归档后从可用馆藏移除，既有对局保留。</view>
  <button slot="footer" class="bg-button full" bindtap="saveBox" loading="{{saving}}" disabled="{{saving}}">保存实物</button>
</boardgame-sheet>
<boardgame-sheet title="编辑游戏资料" kind="form" visible="{{editOpen}}" bindclose="closeEdit" busy="{{saving}}" size="high"><view wx:if="{{formError}}" class="bg-error">{{formError}}</view><view class="bg-label">名称</view><input class="bg-input" value="{{editForm.name}}" data-key="name" bindinput="editField"/><view class="bg-label">别名（逗号分隔）</view><input class="bg-input" value="{{editForm.aliases}}" data-key="aliases" bindinput="editField"/><view wx:if="{{game.game_type === 'expansion'}}" class="bg-row bg-between"><text>可以独立游玩</text><switch checked="{{editForm.is_standalone}}" data-key="is_standalone" bindchange="editField" color="#FF9800"/></view><view class="bg-label">最少 / 最多人数</view><view class="bg-row"><input class="bg-input bg-grow" type="number" value="{{editForm.min_players}}" data-key="min_players" bindinput="editField"/><input class="bg-input bg-grow" type="number" value="{{editForm.max_players}}" data-key="max_players" bindinput="editField"/></view><view class="bg-label">最长时长（分钟）</view><input class="bg-input" type="number" value="{{editForm.max_playtime_minutes}}" data-key="max_playtime_minutes" bindinput="editField"/><view class="bg-label">复杂度（1–5）</view><input class="bg-input" type="digit" value="{{editForm.complexity}}" data-key="complexity" bindinput="editField"/><view class="bg-label">游戏介绍</view><textarea class="bg-input bg-textarea" maxlength="100000" value="{{editForm.description}}" data-key="description" bindinput="editField"/><button slot="footer" class="bg-button full" bindtap="saveEdit" loading="{{saving}}" disabled="{{saving}}">保存资料</button></boardgame-sheet>
<date-time-picker-sheet visible="{{dateOpen}}" mode="date" title="购入日期" value="{{dateValue}}" bindclose="closeDate" bindconfirm="dateConfirm"/>

<boardgame-sheet title="维护扩展关系" kind="form" visible="{{compatOpen}}" bindclose="closeCompatibility" busy="{{saving}}" size="high"><view wx:if="{{formError}}" class="bg-error">{{formError}}</view><view class="bg-row"><input class="bg-input bg-grow" value="{{compatQuery}}" bindinput="compatInput" placeholder="搜索已录入的扩展"/><button class="bg-button small" bindtap="searchCompatibility">搜索</button></view><view wx:for="{{compatItems}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="chooseCompatibility"><text wx:if="{{compatChosen.id === item.id}}">✓ </text><template is="boardgame-name" data="{{game:item}}"/></view><button wx:if="{{compatCursor}}" class="bg-button secondary full" data-more="{{true}}" bindtap="searchCompatibility">更多扩展</button><block wx:if="{{compatChosen}}"><view class="bg-label">{{compatChosen.name}}的兼容关系</view><picker range="{{compatOptions}}" range-key="label" value="{{compatDecision}}" bindchange="compatDecision"><view class="bg-input">{{compatOptions[compatDecision].label}} ⌄</view></picker><view class="bg-label">说明</view><input class="bg-input" value="{{compatNote}}" bindinput="compatNote" placeholder="补充适用版本或限制"/></block><button slot="footer" class="bg-button full" bindtap="saveCompatibility" disabled="{{saving || !compatChosen}}">保存扩展关系</button></boardgame-sheet>
<boardgame-sheet title="选择归属成员" kind="info" visible="{{ownerOpen}}" bindclose="closeOwner"><view class="bg-row"><input class="bg-input bg-grow" value="{{ownerQuery}}" bindinput="ownerInput" placeholder="搜索昵称"/><button class="bg-button small" bindtap="searchOwner">搜索</button></view><view wx:for="{{ownerMembers}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="chooseOwner">{{item.nickname}}</view><button wx:if="{{ownerCursor}}" class="bg-button secondary full" data-more="{{true}}" bindtap="searchOwner">更多成员</button></boardgame-sheet>
