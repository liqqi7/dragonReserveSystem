<import src="../../templates/boardgame-name.wxml"/>
<view class="detail-page"><view class="detail-nav" style="padding-top:{{statusBarHeight}}px"><view class="detail-nav-row" style="height:{{navHeight}}px"><view class="detail-nav-icon" bindtap="goBack"><image src="/images/icon-chevron-left.svg" mode="aspectFit"/></view><text class="detail-nav-title">桌游详情</text><view class="detail-nav-spacer"></view></view></view><view wx:if="{{error}}" class="detail-error" bindtap="load"><text>{{error}} · 点击重试</text></view><view wx:if="{{loading && !game}}" class="detail-loading"><text>正在加载…</text></view><block wx:if="{{game}}"><scroll-view type="custom" class="detail-scroll" scroll-y><view class="detail-identity"><image wx:if="{{game.cover_url}}" class="detail-identity-cover" src="{{game.cover_url}}" mode="aspectFill" binderror="imageError"/><view wx:else class="detail-identity-cover detail-placeholder"><text>暂无封面</text></view><view class="detail-identity-copy"><text class="detail-name">{{game.chinese_name || game.name}}</text><text class="detail-original">{{game.original_name || '—'}}</text></view></view><view class="detail-rating-row"><view class="detail-rating-item"><text class="detail-rating-value">{{game.bgg_rating || '—'}}<text wx:if="{{game.bgg_rating}}"> / 10</text></text><text class="detail-rating-label">BGG 评分</text></view><view class="detail-rating-item"><text class="detail-rating-value">{{game.bgg_rank || '—'}}</text><text class="detail-rating-label">BGG 综合排名</text></view><view class="detail-rating-item"><text class="detail-rating-value">{{game.bgg_weight_display || game.bgg_weight || game.complexity || '—'}}<text wx:if="{{game.bgg_weight_display || game.bgg_weight || game.complexity}}"> / 5</text></text><text class="detail-rating-label">BGG 重度</text></view></view><view class="detail-facts"><view><text>{{game.min_players || '—'}}<text wx:if="{{game.max_players && game.max_players !== game.min_players}}">–{{game.max_players}}</text> 人</text><text>人数</text></view><view><text>{{game.min_playtime_minutes || '—'}}<text wx:if="{{game.max_playtime_minutes && game.max_playtime_minutes !== game.min_playtime_minutes}}">–{{game.max_playtime_minutes}}</text> 分钟</text><text>时长</text></view><view><text>{{game.year_published || '—'}}</text><text>出版年份</text></view></view><view class="detail-mechanics" wx:if="{{game.mechanic_tags && game.mechanic_tags.length}}"><text class="detail-section-heading">玩法机制</text><view class="detail-tags"><text wx:for="{{game.mechanic_tags}}" wx:key="id">{{item.name}}</text></view></view><view wx:if="{{detailImages.length}}" class="detail-gallery"><swiper wx:if="{{detailImages.length}}" class="detail-gallery-swiper" display-multiple-items="{{detailImages.length > 2 ? 3 : detailImages.length}}" circular="{{detailImages.length > 1}}" bindchange="galleryChanged"><swiper-item wx:for="{{detailImages}}" wx:key="id"><image src="{{item.url}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"/></swiper-item></swiper></view><view wx:if="{{myVersions.length}}" class="detail-version-card detail-drawer-entry"><view class="detail-card-heading"><text>我的版本</text></view><view wx:if="{{myVersions.length}}" class="detail-version-row" bindtap="openBox" data-id="{{myVersions[0].id}}"><image class="detail-version-icon" src="./book-open.svg"/><text>{{myVersions[0].edition_label || myVersions[0].edition_name || '版本未填写'}}<text wx:if="{{myVersions[0].bgg_version && myVersions[0].bgg_version.year_published}}"> · 版本年 {{myVersions[0].bgg_version.year_published}}</text></text><text class="detail-card-arrow">›</text></view></view><view wx:if="{{game.expansions && game.expansions.length}}" class="detail-exp-card detail-drawer-entry" bindtap="openExpansions" role="button">
  <view class="detail-card-heading"><text>扩展</text><text class="detail-exp-entry">›</text></view>
  <scroll-view type="custom" enable-flex scroll-x class="detail-exp-cards" show-scrollbar="{{false}}">
    <view class="detail-exp-row">
      <view wx:for="{{game.expansions}}" wx:key="id" class="detail-exp-item">
        <view class="detail-exp-cover">
          <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill"/>
          <view wx:else class="detail-exp-cover placeholder"><text>暂无封面</text></view>
          <view class="detail-exp-shade"></view>
          <text class="detail-exp-name">{{item.chinese_name || item.name}}</text>
          <view wx:if="{{item.owner_count}}" class="detail-exp-own"><text>✓</text></view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
<view class="detail-owner-card detail-drawer-entry" bindtap="openOwner"><text>拥有者</text><view class="detail-owner-summary"><view class="detail-avatar-list"><view wx:for="{{ownerPreview}}" wx:key="id" class="detail-avatar"><image wx:if="{{item.owner.avatar_url}}" src="{{item.owner.avatar_url}}" mode="aspectFill"/><text wx:else>{{item.ownerInitial}}</text></view><view wx:if="{{ownerCount > 5}}" class="detail-avatar">+{{ownerCount - 5}}</view></view><text>{{ownerCount}} 位</text></view></view><view class="detail-description-card"><view class="detail-section-heading"><text>游戏简介</text></view><text wx:if="{{descriptionOpen}}" class="detail-description">{{game.description || '暂无游戏简介'}}</text><text wx:else class="detail-description" overflow="ellipsis" max-lines="3">{{game.description || '暂无游戏简介'}}</text><text wx:if="{{game.description && game.description.length > 100}}" class="detail-expand" bindtap="toggleDescription">{{descriptionOpen ? '收起简介⌃' : '展开简介⌄'}}</text></view></scroll-view></block><view wx:if="{{game && ownerAccess}}" class="detail-bottom-bar"><view wx:if="{{myVersions.length}}" class="detail-delete-btn" bindtap="openDeleteDialog" role="button" aria-label="删除我的桌游"><image src="/images/icon-trash-red.svg" mode="aspectFit"/></view><view class="detail-record-btn" bindtap="recordPlay" role="button">记录一局</view></view></view>


<boardgame-sheet visible="{{inventoryOpen}}" title="我的版本" kind="form" size="high" busy="{{saving}}" bindclose="closeBox">
  <view wx:for="{{versionOptions}}" wx:key="bgg_version_id" class="version-option {{selectedVersionId === item.bgg_version_id ? 'selected' : ''}}" data-id="{{item.bgg_version_id}}" bindtap="chooseDetailVersion">
    <image wx:if="{{item.cover_url}}" class="version-cover" src="{{item.cover_url}}" mode="aspectFill"/>
    <view wx:else class="version-cover version-placeholder"><text>暂无版本图</text></view>
    <view class="version-copy"><text class="version-name">{{item.display_name || item.name}}</text><text class="version-meta">{{item.languageLabel || '语言未知'}} · {{item.year_published || '年份未知'}}</text><text class="version-meta">{{item.publisherLabel || '出版商未知'}}</text></view>
    <view class="version-state"><text wx:if="{{currentVersionId === item.bgg_version_id}}" class="version-current">当前使用</text><view class="version-choice {{selectedVersionId === item.bgg_version_id ? 'checked' : ''}}"><text wx:if="{{selectedVersionId === item.bgg_version_id}}">✓</text></view></view>
  </view>
  <text wx:if="{{!versionOptions.length}}" class="version-meta">暂无可用版本资料</text><text wx:if="{{formError}}" class="version-error">{{formError}}</text>
  <view role="button" slot="footer" class="{{saving || !selectedVersionId || selectedVersionId === currentVersionId ? 'is-disabled' : ''}} version-submit" bindtap="changeDetailVersion" aria-disabled="{{saving || !selectedVersionId || selectedVersionId === currentVersionId}}"><text>{{saving ? '正在保存…' : '更换版本'}}</text></view>
</boardgame-sheet>
<boardgame-sheet visible="{{expansionsOpen}}" title="扩展详情" kind="form" showClose="{{false}}" size="high" bindclose="closeExpansions">
  <view class="exp-sheet-list">
    <view wx:for="{{expansionOptions}}" wx:key="id" class="exp-sheet-item {{item.checked ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleExpansion" role="button">
      <image wx:if="{{item.cover_url}}" class="exp-sheet-cover" src="{{item.cover_url}}" mode="aspectFill"/>
      <view wx:else class="exp-sheet-cover placeholder"><text>暂无封面</text></view>
      <view class="exp-sheet-copy">
        <view class="exp-sheet-name"><text>{{item.chinese_name || item.name}}</text></view>
        <view class="exp-sheet-owners {{item.owner_count ? 'has' : 'is-none'}}"><text wx:if="{{item.owner_count}}" class="exp-sheet-owners-icon">✓</text><text>{{item.owners_label}}</text></view>
      </view>
      <text wx:if="{{item.year_published}}" class="exp-sheet-year">{{item.year_published}}</text>
      <view class="exp-choice {{item.checked ? 'on' : ''}}"><text wx:if="{{item.checked}}">✓</text></view>
    </view>
  </view>
  <text wx:if="{{expError}}" class="version-error">{{expError}}</text>
  <button slot="footer" style="width:673rpx;" class="{{expSaving || !ownerAccess ? 'is-disabled' : ''}} version-submit" bindtap="saveExpansions" disabled="{{expSaving || !ownerAccess}}">{{expSaving ? '正在保存…' : '更换我的扩展'}}</button>
</boardgame-sheet>
<boardgame-sheet visible="{{ownerOpen}}" title="全部拥有者（{{ownerCount}}）" size="high" bindclose="closeOwner">
  <view wx:for="{{ownerRows}}" wx:key="id" class="detail-owner-drawer-card"><image wx:if="{{item.owner.avatar_url}}" class="detail-owner-avatar" src="{{item.owner.avatar_url}}" mode="aspectFill"/><view wx:else class="detail-owner-avatar"><text>{{item.ownerInitial}}</text></view><view class="detail-owner-drawer-copy"><text class="detail-drawer-name">{{item.owner.display_name || '成员'}}</text><text class="detail-drawer-sub">{{item.edition_label || '版次未确定'}}{{item.bgg_version.year_published ? ' · ' + item.bgg_version.year_published : ''}}</text></view></view>
  <text wx:if="{{ownerError}}" class="version-error" bindtap="retryOwners">{{ownerError}} · 点击重试</text><text wx:if="{{ownersLoading}}" class="version-meta">正在加载拥有者…</text><button wx:if="{{inventoryCursor}}" class="{{ownersLoading ? 'is-disabled' : ''}} owner-more" bindtap="moreOwners" disabled="{{ownersLoading}}">更多拥有者</button>
</boardgame-sheet>

<create-access-dialog id="session-expired-dialog" />
<view wx:if="{{deleteDialogOpen}}" class="detail-dialog-mask" bindtap="closeDeleteDialog"><view class="detail-dialog" catchtap="noop"><view class="detail-dialog-head"><image class="detail-dialog-icon" src="/images/icon-alert-red.svg" mode="aspectFit"/><text class="detail-dialog-title">删除我的桌游？</text></view><text class="detail-dialog-desc">{{deleteSoleOwner ? '你是这个桌游的唯一拥有者，卖了就玩不了了，深思吧！' : '你要卖了这个桌游么？'}}</text><view class="detail-dialog-actions"><view class="detail-dialog-cancel" bindtap="closeDeleteDialog">取消</view><view class="detail-dialog-confirm {{deleting ? 'is-disabled' : ''}}" bindtap="confirmDelete">{{deleting ? '删除中…' : '确认'}}</view></view></view></view>
<view wx:if="{{deleteDone}}" class="detail-done-mask"><image class="detail-done-art" src="/pages/boardgame_detail/delete-success-art.png" mode="aspectFit"/><text class="detail-done-text">恭喜你挣钱了，那吐点吧</text><view class="detail-done-btn" bindtap="goBackLibrary" role="button">返回桌游库</view></view>
