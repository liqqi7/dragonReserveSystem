<view class="bg-page"><view class="bg-row bg-between"><view class="bg-title">待同步记录</view><button class="bg-button small" loading="{{busy}}" disabled="{{busy}}" bindtap="retry">立即同步</button></view><view class="bg-subtitle">本机修改按当前账号保存。冲突需要核对后再提交。</view><view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{!items.length}}" class="bg-empty">记录已同步，没有待处理内容</view>
  <view wx:for="{{items}}" wx:key="operation_id" class="bg-card"><view class="bg-row bg-between"><text>{{item.title}}</text><text class="bg-badge">{{item.stateLabel}}</text></view><view wx:if="{{item.errorText}}" class="bg-subtitle">{{item.errorText}}</view><view class="offline-diff"><view class="offline-side"><view class="bg-label" style="margin-top:0">本机修改</view><view class="offline-value">{{item.localText}}</view></view><view wx:if="{{item.canResolve}}" class="offline-side"><view class="bg-label" style="margin-top:0">服务器记录</view><view class="offline-value">{{item.remoteText}}</view></view></view>
    <view wx:if="{{item.canResolve}}" class="bg-muted">先刷新服务器记录，核对后可重新提交本机填写的字段。</view><view class="offline-actions"><button wx:if="{{item.canResolve}}" class="bg-button small secondary" data-id="{{item.operation_id}}" bindtap="refresh" disabled="{{busy}}">刷新对照</button><button wx:if="{{item.canResolve && item.action !== 'scoresheet.put'}}" class="bg-button small" data-id="{{item.operation_id}}" bindtap="useLocal" disabled="{{busy}}">确认使用本机修改</button><button wx:if="{{item.canResolve && item.action === 'scoresheet.put'}}" class="bg-button small" data-id="{{item.operation_id}}" bindtap="reviewSheet">核对计分表</button><button class="bg-button small secondary" data-id="{{item.operation_id}}" bindtap="discard" disabled="{{busy}}">{{item.canResolve ? '保留服务器版本' : '移除本机待提交项'}}</button></view>
  </view>
</view>
