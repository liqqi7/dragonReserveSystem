<import src="../../templates/boardgame-name.wxml"/>
<view class="bg-page"><view wx:if="{{segmentMode}}" class="bg-notice">核对来源中的第 {{segmentNumber}} 局。分数与时长不会从汇总记录复制，保存后回到来源条目统一确认导入。</view><view wx:if="{{importedHeld}}" class="bg-notice">正在编辑私有导入历史，保存不会公开记录。<view wx:if="{{hasSheet && editing}}" class="bg-row bg-between"><text>本次更正替换来源计分结构（原件仍保留）</text><switch checked="{{clearImportedSheet}}" bindchange="clearImported" color="#FF9800"/></view></view><view wx:if="{{id && !importedHeld}}" class="bg-link" bindtap="tags">管理我的对局标签</view>
  <view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{notice}}" class="bg-notice" bindtap="offline">{{notice}}</view><view wx:if="{{loading && !form}}" class="bg-empty">正在加载…</view>
  <block wx:if="{{form}}">
    <view class="bg-row bg-between"><view class="bg-grow"><template is="boardgame-name" data="{{game:game, titleClass:'bg-title'}}"/><view class="bg-subtitle">{{form.played_on}} · {{modes[modeIndex].label}} · {{play.status === 'completed' ? '已完成' : play.status === 'abandoned' ? '中途结束' : play.status === 'voided' ? '已作废' : '记录中'}}</view></view><text wx:if="{{!id && !segmentMode}}" class="bg-link" bindtap="openGamePicker">选择游戏 ›</text><button wx:if="{{!editing && play.permissions.can_edit && play.status !== 'voided'}}" class="bg-button small" bindtap="edit">编辑</button></view>
    <view wx:if="{{form.activity_id}}" class="bg-list-item bg-row bg-between" bindtap="openActivity"><view class="bg-grow"><view class="bg-muted">所属活动</view><view>{{activityContext.name || '查看活动'}}{{activityContext.table_label ? ' · ' + activityContext.table_label : ''}}</view></view><text class="bg-link">›</text></view>
    <view wx:if="{{!segmentMode}}" class="bg-list-item bg-row bg-between" data-key="timingOpen" bindtap="toggleSection"><text>本局计时</text><text class="bg-link">{{timingOpen ? '收起' : play.timer_status === 'running' ? timerText : '展开'}} ⌄</text></view><view wx:if="{{!segmentMode && (timingOpen || play.timer_status === 'running')}}" class="bg-card bg-row bg-between"><view><view class="play-timer">{{timerText}}</view><text class="bg-muted">{{play.timer_status === 'running' ? '计时中' : play.timer_status === 'paused' ? '已暂停' : play.timer_status === 'stopped' ? '已结束计时' : '尚未计时'}}</text></view><view class="bg-row bg-wrap" wx:if="{{(!play || play.permissions.can_edit) && form.status !== 'abandoned' && form.status !== 'voided'}}"><button wx:if="{{!play || play.timer_status === 'idle'}}" class="bg-button small" data-action="start" bindtap="timer" disabled="{{saving}}">开始</button><button wx:if="{{play.timer_status === 'running'}}" class="bg-button small" data-action="pause" bindtap="timer" disabled="{{saving}}">暂停</button><button wx:if="{{play.timer_status === 'paused'}}" class="bg-button small" data-action="resume" bindtap="timer" disabled="{{saving}}">继续</button><button wx:if="{{play.timer_status === 'running' || play.timer_status === 'paused'}}" class="bg-button small secondary" data-action="stop" bindtap="timer" disabled="{{saving}}">结束</button><button wx:if="{{play.timer_status === 'stopped'}}" class="bg-button small secondary" data-action="restore" bindtap="timer" disabled="{{saving}}">恢复</button></view></view>
    <block wx:if="{{editing}}"><view class="bg-heading">本局信息</view><view class="bg-label">日期 / 对局模式</view><view class="play-field-grid"><view class="bg-input" bindtap="openDate">{{form.played_on}}　›</view><picker range="{{modes}}" range-key="label" value="{{modeIndex}}" bindchange="modeChange" disabled="{{hasSheet && !clearImportedSheet}}"><view class="bg-input">{{modes[modeIndex].label}}　⌄</view></picker></view>
      <view class="play-section-toggle" data-key="detailsOpen" bindtap="toggleSection"><text>地点、时长与实物</text><text>{{detailsOpen ? '收起' : '展开'}} ⌄</text></view><block wx:if="{{detailsOpen}}">
      <view class="bg-label">开始时间（北京时间，可留空）</view><view class="bg-input" bindtap="openStart">{{form.started_at_label || '未记录具体时间'}} ›</view><text wx:if="{{form.started_at}}" class="bg-link" bindtap="clearStart">清空开始时间</text><view class="play-field-grid"><view><view class="bg-label">游玩环境</view><picker range="{{environments}}" range-key="label" value="{{environmentIndex}}" bindchange="environment"><view class="bg-input">{{environments[environmentIndex].label}} ⌄</view></picker></view><view><view class="bg-label">地点</view><input class="bg-input" value="{{form.location_label}}" bindinput="location" placeholder="可不填写"/><text class="bg-link" bindtap="openLocations">选择常用地点</text></view></view><view class="bg-label">使用的实物</view><picker range="{{boxes}}" range-key="label" value="{{boxIndex}}" bindchange="boxChange"><view class="bg-input">{{boxes[boxIndex].label || '未指定使用哪一盒'}}　⌄</view></picker>
      <view class="play-field-grid"><view><view class="bg-label">实际时长（分钟）</view><input class="bg-input" type="number" value="{{form.duration_minutes}}" data-key="duration_minutes" bindinput="field" placeholder="未填写"/></view><view><view class="bg-label">总轮数</view><input class="bg-input" type="number" value="{{form.round_count}}" data-key="round_count" bindinput="field" placeholder="未填写"/></view></view>
      </block>
      <view wx:if="{{form.competition_mode === 'individual' || form.competition_mode === 'team'}}" class="play-field-grid"><view><view class="bg-label">成绩判定</view><picker range="{{results}}" range-key="label" value="{{resultIndex}}" bindchange="resultChange"><view class="bg-input">{{results[resultIndex].label}}　⌄</view></picker></view><view><view class="bg-label">分数方向</view><picker range="{{directions}}" range-key="label" value="{{directionIndex}}" bindchange="directionChange" disabled="{{hasSheet && !clearImportedSheet}}"><view class="bg-input">{{directions[directionIndex].label}}　⌄</view></picker></view></view>
      <block wx:if="{{form.result_source === 'tiebreak'}}"><view class="bg-label">同分如何决胜 *</view><input class="bg-input" value="{{form.result_reason}}" data-key="result_reason" bindinput="field" placeholder="例如：剩余资源更多者获胜"/></block>
      <view class="bg-label">玩法 / 变体</view><input class="bg-input" value="{{form.rules_snapshot.variant_key}}" data-key="rules_snapshot.variant_key" bindinput="field" placeholder="标准玩法可留空" disabled="{{hasSheet && !clearImportedSheet}}"/>
    </block>
    <view class="bg-heading"><text>参与人与成绩 · {{form.players.length}} 人</text><text wx:if="{{editing}}" class="bg-link" data-role="player" bindtap="openMembers">＋ 添加成员</text></view>
    <view wx:if="{{editing}}" class="play-section-toggle" data-key="playerOptionsOpen" bindtap="toggleSection"><text>先手、初玩、角色与辅助参与</text><text>{{playerOptionsOpen ? '收起' : '展开'}} ⌄</text></view>
    <view wx:for="{{form.players}}" wx:key="clientIdentity" class="play-player">
      <view class="bg-row"><image wx:if="{{item.avatar_url}}" class="bg-avatar" data-path="form.players[{{index}}].avatar_url" binderror="imageError" src="{{item.avatar_url}}" mode="aspectFill"/><view wx:else class="bg-avatar">{{item.display_name[0] || index + 1}}</view><view class="bg-grow"><view class="play-name">{{item.display_name}} <text wx:if="{{item.participant_kind === 'automa'}}" class="bg-badge">Automa</text></view><view class="play-state" wx:if="{{!editing}}">{{item.is_start_player ? '先手 · ' : ''}}{{item.role_label || ''}}{{item.is_new_to_player ? ' · 第一次玩' : ''}}</view></view><text wx:if="{{editing}}" class="play-remove" data-index="{{index}}" bindtap="removePlayer">移除</text><text wx:else class="bg-score">{{item.resultLabel}}</text></view>
      <block wx:if="{{editing}}"><view class="play-score-row"><picker range="{{form.competition_mode === 'individual' ? statuses : personalStatuses}}" range-key="label" value="{{form.competition_mode === 'individual' ? item.statusIndex : item.personalStatusIndex}}" data-index="{{index}}" bindchange="statusChange"><view class="bg-chip">{{form.competition_mode === 'individual' ? statuses[item.statusIndex].label : personalStatuses[item.personalStatusIndex].label}}　⌄</view></picker><input wx:if="{{form.competition_mode === 'individual' && item.score_status === 'recorded'}}" class="bg-input play-score-input" type="text" value="{{item.score}}" data-index="{{index}}" data-key="score" bindinput="playerField" placeholder="含 0 / 负分" disabled="{{hasSheet && !clearImportedSheet}}"/><input wx:if="{{form.result_source === 'manual_rank' && form.competition_mode === 'individual'}}" class="bg-input play-score-input" type="number" value="{{item.rank}}" data-index="{{index}}" data-key="rank" bindinput="playerField" placeholder="名次"/></view>
        <view wx:if="{{form.competition_mode === 'individual' && (form.result_source === 'manual_winner' || form.result_source === 'tiebreak')}}" class="play-result-choice {{item.outcome === 'win' ? 'chosen' : ''}}" style="margin-top:16rpx" data-kind="players" data-index="{{index}}" bindtap="winner">{{item.score_status === 'gave_up' ? '摆烂成员按未获胜记录' : item.outcome === 'win' ? '✓ 这位玩家获胜' : '指定为赢家'}}</view>
        <picker wx:if="{{form.competition_mode === 'team'}}" range="{{form.teams}}" range-key="name" value="{{item.teamIndex}}" data-index="{{index}}" bindchange="teamChange"><view class="bg-input" style="margin-top:16rpx">{{form.teams[item.teamIndex].name}}　⌄</view></picker>
        <block wx:if="{{playerOptionsOpen}}"><view class="bg-row bg-between" style="margin-top:20rpx"><text class="bg-small">先手</text><switch checked="{{item.is_start_player}}" data-index="{{index}}" data-key="is_start_player" bindchange="playerField" color="#FF9800"/><picker range="{{newFlags}}" value="{{item.newIndex}}" data-index="{{index}}" bindchange="newChange"><view class="bg-chip">{{newFlags[item.newIndex]}}　⌄</view></picker></view><input class="bg-input" style="margin-top:18rpx" value="{{item.role_label}}" data-index="{{index}}" data-key="role_label" bindinput="playerField" placeholder="角色 / 阵营（可选）"/></block>
      </block><view wx:else class="bg-row bg-between" style="margin-top:22rpx"><text>{{item.scoreLabel}}</text><text class="bg-muted" wx:if="{{item.rank}}">第 {{item.rank}} 名</text></view>
    </view>
    <view wx:if="{{editing && playerOptionsOpen}}" class="bg-row bg-wrap" style="margin-top:20rpx"><button class="bg-chip" bindtap="addAutoma">＋ Automa</button><button class="bg-chip" data-role="teacher" bindtap="openMembers">＋ 讲解员</button><button class="bg-chip" data-role="moderator" bindtap="openMembers">＋ 主持人</button></view>
    <view wx:if="{{form.observers.length}}" class="bg-card"><view class="detail-section-title">辅助参与者</view><view wx:for="{{form.observers}}" wx:key="index" class="bg-list-item bg-row bg-between"><view>{{item.display_name}} · {{item.observer_role === 'teacher' ? '讲解员' : '主持人'}}</view><text wx:if="{{editing}}" class="play-remove" data-kind="observers" data-index="{{index}}" bindtap="removePlayer">移除</text></view><text class="bg-muted">不计入实际玩家人数、得分和胜率。</text></view>
    <block wx:if="{{form.competition_mode === 'team'}}"><view class="bg-heading"><text>团队成绩</text><text wx:if="{{editing}}" class="bg-link" bindtap="addTeam">＋ 添加队伍</text></view><view wx:for="{{form.teams}}" wx:key="client_key" class="play-player"><view class="bg-row bg-between"><input wx:if="{{editing}}" class="bg-input bg-grow" value="{{item.name}}" data-kind="teams" data-index="{{index}}" data-key="name" bindinput="playerField"/><text wx:else class="play-name">{{item.name}}</text><text wx:if="{{editing}}" class="play-remove" data-index="{{index}}" bindtap="removeTeam">移除</text></view><view wx:if="{{editing}}" class="play-score-row"><picker range="{{statuses}}" range-key="label" value="{{item.statusIndex}}" data-kind="teams" data-index="{{index}}" bindchange="statusChange"><view class="bg-chip">{{statuses[item.statusIndex].label}}　⌄</view></picker><input wx:if="{{item.score_status === 'recorded'}}" class="bg-input play-score-input" value="{{item.score}}" data-kind="teams" data-index="{{index}}" data-key="score" bindinput="playerField" placeholder="分数" disabled="{{hasSheet && !clearImportedSheet}}"/><input wx:if="{{form.result_source === 'manual_rank'}}" class="bg-input play-score-input" type="number" value="{{item.rank}}" data-kind="teams" data-index="{{index}}" data-key="rank" bindinput="playerField" placeholder="名次"/></view><view wx:if="{{editing && (form.result_source === 'manual_winner' || form.result_source === 'tiebreak')}}" class="play-result-choice {{item.outcome === 'win' ? 'chosen' : ''}}" style="margin-top:16rpx" data-kind="teams" data-index="{{index}}" bindtap="winner">{{item.outcome === 'win' ? '✓ 这队获胜' : '指定为赢家'}}</view><view wx:if="{{!editing}}" class="bg-row bg-between" style="margin-top:20rpx"><text>{{item.scoreLabel}}</text><text>{{item.outcome === 'win' ? '获胜' : item.outcome === 'draw' ? '平局' : item.outcome === 'loss' ? '未获胜' : '结果未知'}}</text></view></view></block>
    <view wx:if="{{form.competition_mode === 'cooperative' || form.competition_mode === 'solo'}}" class="bg-card"><view class="bg-heading" style="margin-top:0"><text>共同成绩</text></view><block wx:if="{{editing}}"><picker range="{{sharedResults}}" value="{{sharedResultIndex}}" bindchange="sharedResult"><view class="bg-input">{{sharedResults[sharedResultIndex]}}　⌄</view></picker><view class="play-score-row"><picker range="{{statuses}}" range-key="label" value="{{sharedStatusIndex}}" bindchange="sharedStatus"><view class="bg-chip">{{statuses[sharedStatusIndex].label}}　⌄</view></picker><input wx:if="{{form.shared_score_status === 'recorded'}}" class="bg-input play-score-input" value="{{form.shared_score}}" data-key="shared_score" bindinput="field" placeholder="共同得分" disabled="{{hasSheet && !clearImportedSheet}}"/></view></block><view wx:else class="bg-row bg-between"><text>{{form.shared_score === null ? statuses[sharedStatusIndex].label : form.shared_score}}</text><text>{{sharedResults[sharedResultIndex]}}</text></view></view>
    <button wx:if="{{!segmentMode && form.competition_mode !== 'unscored'}}" class="bg-button secondary full play-sheet-link" bindtap="scoresheet" disabled="{{saving}}">{{hasSheet ? '查看 / 编辑计分表' : '使用计分表，记录每轮或分项'}}</button>
    <view class="bg-heading"><text>本局使用的扩展 {{form.expansions.length}}</text><text wx:if="{{editing}}" class="bg-link" bindtap="openExpansions">选择 ›</text></view><view wx:if="{{!form.expansions.length}}" class="bg-card bg-muted">仅使用本体</view><view wx:for="{{form.expansions}}" wx:key="game_id" class="bg-card"><text>{{item.game_name || '已选择的扩展'}}</text><view class="bg-muted">{{item.modules_note || '未注明模块'}}</view></view>
    <block wx:if="{{editing}}"><view class="play-section-toggle" data-key="advancedOpen" bindtap="toggleSection"><text>统计口径</text><text>{{advancedOpen ? '收起' : exclusions[exclusionIndex].label}} ⌄</text></view><block wx:if="{{advancedOpen}}"><view class="bg-label">统计口径</view><picker range="{{exclusions}}" range-key="label" value="{{exclusionIndex}}" bindchange="exclusionChange"><view class="bg-input">{{exclusions[exclusionIndex].label}}　⌄</view></picker><input wx:if="{{form.stats_exclusion !== 'none'}}" class="bg-input" style="margin-top:16rpx" value="{{form.exclusion_reason}}" data-key="exclusion_reason" bindinput="field" placeholder="请填写排除原因"/></block><view class="bg-label">对局备注（成员可见）</view><textarea class="bg-input bg-textarea" value="{{form.note}}" data-key="note" bindinput="field" maxlength="5000" placeholder="记下这一局的故事"/><block wx:if="{{play && play.status !== 'draft'}}"><view class="bg-label">修改原因 *</view><input class="bg-input" value="{{reason}}" bindinput="reason" placeholder="让其他参与者了解更正原因"/></block></block><view wx:else class="bg-card play-history-note">{{form.note || '没有额外备注'}}<view wx:if="{{form.stats_exclusion !== 'none'}}">{{exclusions[exclusionIndex].label}}：{{form.exclusion_reason}}</view></view>
    <view wx:if="{{id && !editing && !importedHeld}}" class="play-management"><view class="bg-list-item bg-row bg-between" bindtap="openHistory"><text>修改记录</text><text class="bg-link">查看 ›</text></view><view class="bg-row bg-wrap"><button wx:if="{{play.permissions.can_report}}" class="bg-chip" data-action="report" bindtap="openAction">反馈问题</button><button class="bg-chip" data-action="copy" bindtap="openAction">再记一局</button><button wx:if="{{play.permissions.can_edit}}" class="bg-chip" data-action="{{play.status === 'voided' ? 'restore' : 'void'}}" bindtap="openAction">{{play.status === 'voided' ? '恢复对局' : '作废记录'}}</button></view></view>
    <view wx:if="{{editing}}" class="bg-notice">未填写和 0 分分别记录；个人摆烂保留参局记录，并计为未获胜。整局未开完或掀桌不计完成局。</view><view class="bg-footer-space"/>
    <view wx:if="{{editing}}" class="bg-fixed-actions play-footer"><button wx:if="{{!segmentMode && (!play || play.status === 'draft')}}" class="bg-button secondary" data-status="draft" bindtap="save" disabled="{{saving}}">暂存</button><button class="bg-button secondary" bindtap="openEnd" disabled="{{saving}}">中途结束</button><button class="bg-button" data-status="completed" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{segmentMode ? '保存本局核对' : '保存对局'}}</button></view>
  </block>
</view>
<boardgame-sheet title="选择小程序成员" visible="{{memberOpen}}" bindclose="closeMembers"><input class="bg-input" value="{{memberQuery}}" bindinput="memberInput" placeholder="搜索昵称"/><view wx:for="{{members}}" wx:key="id" class="bg-list-item bg-row" data-id="{{item.id}}" bindtap="chooseMember"><image wx:if="{{item.avatar_url}}" class="bg-avatar" data-path="members[{{index}}].avatar_url" binderror="imageError" src="{{item.avatar_url}}"/><view wx:else class="bg-avatar">人</view><text>{{item.nickname}}</text></view><button wx:if="{{memberCursor}}" class="bg-button secondary full" bindtap="moreMembers">更多成员</button></boardgame-sheet>
<boardgame-sheet title="选择本局扩展" kind="form" visible="{{expansionOpen}}" bindclose="closeExpansions" busy="{{saving}}" size="high"><view wx:if="{{!expansions.length}}" class="bg-empty">还没有关联的扩展</view><view wx:for="{{expansions}}" wx:key="expansion_game_id" class="play-expansion"><view class="bg-row bg-between"><view class="bg-grow"><template is="boardgame-name" data="{{game:item.game}}"/></view><switch checked="{{item.selected}}" data-id="{{item.game.id}}" bindchange="expansionToggle" color="#FF9800"/></view><block wx:if="{{item.selected}}"><picker range="{{item.boxes}}" range-key="label" value="{{item.boxIndex}}" data-id="{{item.game.id}}" bindchange="expansionBox"><view class="bg-input">{{item.boxes[item.boxIndex].label || '未指定实物'}} ⌄</view></picker><input class="bg-input" data-id="{{item.game.id}}" data-key="modules_note" value="{{item.modules_note}}" bindinput="expansionNote" placeholder="仅使用的模块 / 部分组件（可选）"/><input wx:if="{{item.manual_decision === 'block' || (!item.bgg_suggested && item.manual_decision !== 'allow')}}" class="bg-input" data-id="{{item.game.id}}" data-key="compatibility_note" value="{{item.compatibility_note}}" bindinput="expansionNote" placeholder="请说明本次如何搭配使用"/></block></view><button slot="footer" class="bg-button full" bindtap="closeExpansions">完成选择</button></boardgame-sheet>
<boardgame-sheet title="选择游戏" visible="{{gameOpen}}" bindclose="closeGames"><view class="bg-row"><input class="bg-input bg-grow" value="{{gameQuery}}" bindinput="gameInput" bindconfirm="searchGames" confirm-type="search" placeholder="搜索馆藏"/><button class="bg-button small" bindtap="searchGames">查找</button></view><view wx:for="{{games}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="chooseGame"><template is="boardgame-name" data="{{game:item}}"/></view></boardgame-sheet>
<boardgame-sheet title="发现相似对局" kind="form" visible="{{duplicateOpen}}" bindclose="closeDuplicates" busy="{{saving}}" size="standard"><view class="bg-notice">同一天、同款游戏和参与者相同。先核对是否已经有人记录。</view><view wx:for="{{duplicates}}" wx:key="id" class="bg-card" data-id="{{item.id}}" bindtap="openExisting"><template is="boardgame-name" data="{{game:item.game}}"/><view class="bg-subtitle">{{item.played_on}}</view><view class="bg-link">查看已有记录 ›</view></view><button slot="footer" class="bg-button full" bindtap="confirmDuplicate" disabled="{{saving}}">确认是另一局，继续保存</button></boardgame-sheet>
<date-time-picker-sheet visible="{{dateOpen}}" mode="{{dateMode}}" title="{{dateTitle}}" value="{{dateValue}}" bindclose="closeDate" bindconfirm="dateConfirm"/>

<boardgame-sheet title="记录中途结束" kind="form" visible="{{endOpen}}" bindclose="closeEnd" busy="{{saving}}" size="standard"><view class="bg-notice">这局仍保留在历史中，不计入完成场次和胜率。</view><view class="bg-row"><button class="bg-chip {{form.end_reason !== 'table_flip' ? 'active' : ''}}" data-value="unfinished" bindtap="endReason">没开完</button><button class="bg-chip {{form.end_reason === 'table_flip' ? 'active' : ''}}" data-value="table_flip" bindtap="endReason">掀桌结束</button></view><block wx:if="{{play && play.status !== 'draft'}}"><view class="bg-label">修改原因</view><input class="bg-input" value="{{reason}}" bindinput="reason" placeholder="说明为什么更正这条记录"/></block><view wx:if="{{error}}" class="bg-error">{{error}}</view><button slot="footer" class="bg-button full" bindtap="confirmEnd" loading="{{saving}}" disabled="{{saving}}">保存中途结束</button></boardgame-sheet>

<boardgame-sheet title="选择常用地点" visible="{{locationOpen}}" bindclose="closeLocations"><view class="bg-row"><input class="bg-input bg-grow" value="{{locationQuery}}" maxlength="64" bindinput="locationInput" bindconfirm="searchLocations" placeholder="搜索或填写新地点"/><button class="bg-button small" bindtap="searchLocations">查找</button></view><view wx:if="{{locationError}}" class="bg-error">{{locationError}}</view><view wx:for="{{locations}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="chooseLocation">{{item.name}}</view><button wx:if="{{locationCursor}}" class="bg-chip" data-more="true" bindtap="searchLocations">更多地点</button><button wx:if="{{locationQuery}}" class="bg-button secondary full" bindtap="createLocation" disabled="{{locationSaving}}">{{segmentMode || importedHeld ? '使用这个地点名称' : '保存为新地点并使用'}}</button></boardgame-sheet>

<boardgame-sheet title="{{actionTitle}}" visible="{{actionOpen}}" kind="form" size="standard" busy="{{saving}}" bindclose="closeAction">
  <view class="bg-card"><template is="boardgame-name" data="{{game:game}}"/><view class="bg-subtitle">{{form.played_on}} · {{form.players.length}} 人</view></view>
  <view wx:if="{{actionError}}" class="bg-error">{{actionError}}</view>
  <view wx:if="{{playAction === 'void'}}" class="bg-notice">记录会保留在历史中，作废后退出对局与胜率统计；有权限的成员可再次恢复。</view>
  <view wx:if="{{playAction === 'copy'}}" class="bg-notice">沿用游戏、扩展与参与者，创建一条新的草稿，重新填写日期和成绩。新草稿不关联原活动。</view>
  <block wx:if="{{playAction === 'restore'}}"><view class="bg-label">恢复为</view><picker range="{{restoreOptions}}" range-key="label" value="{{restoreIndex}}" bindchange="restoreStatus"><view class="bg-input">{{restoreOptions[restoreIndex].label}} ⌄</view></picker><view class="bg-subtitle">尚未核对成绩时，可以先恢复为草稿。</view></block>
  <block wx:if="{{playAction !== 'copy'}}"><view class="bg-label">{{playAction === 'report' ? '需要核对的问题' : '操作原因'}}</view><textarea class="bg-input bg-textarea" value="{{actionReason}}" bindinput="actionReason" maxlength="{{playAction === 'report' ? 1000 : 500}}" placeholder="说明具体情况"/></block>
  <button slot="footer" class="bg-button full" disabled="{{saving}}" loading="{{saving}}" bindtap="saveAction">{{playAction === 'report' ? '提交反馈' : playAction === 'copy' ? '创建新草稿' : '确认保存'}}</button>
</boardgame-sheet>
<boardgame-sheet title="修改记录" visible="{{historyOpen}}" bindclose="closeHistory"><view wx:if="{{actionError}}" class="bg-error">{{actionError}}</view><view wx:for="{{historyRows}}" wx:key="id" class="bg-card"><view class="bg-row bg-between"><text>{{item.label}}</text><text class="bg-muted">{{item.actor.nickname || '系统'}}</text></view><view class="bg-subtitle">{{item.created_at}}</view><view wx:if="{{item.reason}}">{{item.reason}}</view></view><button wx:if="{{historyCursor}}" class="bg-button secondary full" bindtap="moreHistory">更多记录</button></boardgame-sheet>
