@import "../../styles/boardgames.wxss";
.play-player{padding:24rpx;border:1rpx solid #E5E7EB;border-radius:30.77rpx;background:#fff;margin-top:18rpx}.play-score-row{flex-wrap:wrap;margin-top:20rpx;display:flex;gap:14rpx;align-items:center}.play-score-input{width:150rpx;font-variant-numeric:tabular-nums}.play-name{font-weight:700}.play-remove{font-size:23.08rpx;color:#B91C1C}.play-timer{font-size:46.15rpx;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:2rpx}.play-compact{margin:12rpx 0;font-size:23.08rpx}.play-state{font-size:23.08rpx;color:#9CA3AF}.play-footer button{flex:1;min-width:0;padding:0 7.69rpx}.play-result-choice{color:#FF9800;background:#FFF3E0;padding:15rpx 20rpx;border-radius:16rpx;font-size:23.08rpx}.play-result-choice.chosen{color:#fff;background:#FF9800}.play-history-note{line-height:1.75;font-size:26.92rpx;color:#4B5563}.play-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.play-field-grid input{min-width:0}.play-sheet-link{margin:20rpx 0}.play-expansion{padding:20rpx 0}.play-expansion .bg-input{margin-top:14rpx}

.play-section-toggle { display:flex; align-items:center; justify-content:space-between; gap:15.38rpx; padding:23.08rpx 0; color:#4B5563; font-size:23.08rpx; line-height:34.62rpx; }.play-section-toggle text:last-child { color:#7C3A05; flex:none; }.play-management { margin-top:30.77rpx; }
