<view class="bg-page">
  <view class="bg-title">桌游管理</view>
  <scroll-view class="bg-scroll manage-tabs" scroll-x><view class="bg-chips"><button wx:for="{{kinds}}" wx:key="value" class="bg-chip {{kind === item.value ? 'active' : ''}}" data-kind="{{item.value}}" bindtap="kind">{{item.label}}</button></view></scroll-view>
  <block wx:if="{{kind === 'reports'}}">
    <view class="bg-row bg-wrap"><button class="bg-chip {{scope === 'actionable' ? 'active' : ''}}" data-scope="actionable" bindtap="scope">待我处理</button><button class="bg-chip {{scope === 'reported_by_me' ? 'active' : ''}}" data-scope="reported_by_me" bindtap="scope">我的反馈</button></view>
    <view class="bg-row bg-wrap manage-filters"><button class="bg-chip {{status === 'open' ? 'active' : ''}}" data-status="open" bindtap="status">待处理</button><button class="bg-chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="status">全部状态</button></view>
  </block>
  <block wx:else><view class="bg-row"><input class="bg-input bg-grow" value="{{query}}" bindinput="input" bindconfirm="load" placeholder="搜索名称" confirm-type="search"/><button class="bg-button small" bindtap="load">搜索</button></view><view class="bg-row bg-between manage-filters"><text class="bg-small">查看已归档记录</text><switch color="#FF9800" checked="{{archived}}" bindchange="archived"/></view><view wx:if="{{!isAdmin}}" class="bg-subtitle">仅管理自己的实物与可编辑的游戏资料</view></block>
  <view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{notice}}" class="bg-notice">{{notice}}</view>
  <view wx:for="{{rows}}" wx:key="id" class="bg-card">
    <view class="bg-row" data-id="{{item.id}}" bindtap="view"><image wx:if="{{item.game.cover_url || item.cover_url}}" class="bg-thumb" data-path="{{'rows[' + index + '].' + (item.game.cover_url ? 'game.cover_url' : 'cover_url')}}" binderror="imageError" src="{{item.game.cover_url || item.cover_url}}" mode="aspectFit"/><image wx:elif="{{item.user.avatar_url}}" class="bg-avatar" data-path="rows[{{index}}].user.avatar_url" binderror="imageError" src="{{item.user.avatar_url}}" mode="aspectFill"/><view class="bg-grow"><view class="manage-name">{{item.label}}</view><view class="bg-subtitle">{{item.caption}}</view></view><text wx:if="{{kind !== 'people' && kind !== 'locations'}}" class="manage-arrow">›</text></view>
    <block wx:if="{{kind === 'reports'}}"><view class="manage-message">{{item.message}}</view><view class="bg-muted">反馈人：{{item.reporter.nickname || '成员'}}</view><view wx:if="{{item.resolution}}" class="bg-notice">处理说明：{{item.resolution}}</view><button wx:if="{{item.status === 'open' && item.permissions.can_resolve}}" class="bg-button secondary full" data-id="{{item.id}}" data-action="resolve" bindtap="openAction">核对并处理</button></block>
    <view wx:elif="{{item.permissions.can_edit && !item.canonical_id}}" class="manage-actions">
      <button wx:if="{{kind !== 'people' || !item.user || archived}}" class="bg-chip" data-id="{{item.id}}" data-action="{{archived ? 'restore' : 'archive'}}" bindtap="openAction">{{archived ? '恢复记录' : '归档'}}</button>
      <block wx:if="{{!archived && isAdmin}}"><button wx:if="{{kind === 'games' || kind === 'people'}}" class="bg-chip" data-id="{{item.id}}" data-action="merge" bindtap="openAction">合并重复记录</button><button wx:if="{{kind === 'inventory'}}" class="bg-chip" data-id="{{item.id}}" data-action="correct" bindtap="openAction">更正对应游戏</button><button wx:if="{{kind === 'people'}}" class="bg-chip" data-id="{{item.id}}" data-action="binding" bindtap="openAction">匹配账号</button><button wx:if="{{kind === 'locations' || (kind === 'people' && !item.user)}}" class="bg-chip" data-id="{{item.id}}" data-action="rename" bindtap="openAction">修改名称</button></block>
    </view><view wx:if="{{item.canonical_id}}" class="bg-muted">已合并到另一条记录</view>
  </view>
  <view wx:if="{{!loading && !rows.length && !error}}" class="bg-empty">{{kind === 'reports' ? '这个范围暂无反馈' : archived ? '没有已归档的记录' : '暂无可管理的记录'}}</view><view wx:if="{{loading}}" class="bg-empty">正在加载…</view><button wx:if="{{cursor && !loading}}" class="bg-button secondary full" bindtap="onReachBottom">加载更多</button>
</view>
<boardgame-sheet title="{{actionTitle}}" visible="{{formOpen}}" kind="form" size="{{action === 'merge' || action === 'correct' ? 'high' : 'standard'}}" busy="{{saving}}" bindclose="closeForm">
  <view class="bg-card"><view class="manage-name">{{selected.label}}</view><view class="bg-subtitle">{{selected.caption}}</view></view>
  <view wx:if="{{formError}}" class="bg-error">{{formError}}</view>
  <block wx:if="{{action === 'resolve'}}"><view class="bg-card manage-message">{{selected.message}}</view><view class="bg-label">处理结果</view><picker range="{{resolveOptions}}" range-key="label" value="{{resolveIndex}}" bindchange="resolve"><view class="bg-input">{{resolveOptions[resolveIndex].label}} ⌄</view></picker><view class="bg-label">处理说明</view><textarea class="bg-input bg-textarea" value="{{resolution}}" data-key="resolution" bindinput="field" maxlength="1000" placeholder="说明已更正的内容，或无需更改的原因"/><view class="bg-subtitle">处理反馈不会自动修改对局成绩；请先进入对局完成必要的更正。</view></block>
  <block wx:else>
    <view wx:if="{{action === 'archive'}}" class="bg-notice">归档后从使用列表移除，既有对局保留。之后可以在已归档列表恢复。</view><view wx:if="{{action === 'restore'}}" class="bg-notice">恢复后重新出现在列表中。实物需另行确认是否可带到活动。</view>
    <block wx:if="{{action === 'rename'}}"><view class="bg-label">新名称</view><input class="bg-input" value="{{name}}" data-key="name" bindinput="field" maxlength="64"/></block>
    <block wx:if="{{action === 'merge' || action === 'correct' || action === 'binding'}}"><view class="bg-label">{{action === 'merge' ? '合并到这条记录，保留目标资料' : action === 'correct' ? '实物实际对应的游戏' : '对应的小程序账号'}}</view><view class="bg-input" bindtap="openPicker">{{target.label || '搜索并选择'}} ›</view><text wx:if="{{action === 'binding' && selected.user}}" class="bg-link" bindtap="unbind">解除现有账号关联</text><view wx:if="{{action === 'binding'}}" class="bg-subtitle">账号已有玩家身份时，请把当前记录合并到该身份；不同账号不能合并。</view></block>
    <block wx:if="{{preview}}"><view class="bg-label">本次影响</view><view class="manage-impact"><view wx:for="{{impacts}}" wx:key="key" class="bg-list-item bg-row bg-between"><text>{{item.label}}</text><text>{{item.count}} 条</text></view><view wx:if="{{!impacts.length}}" class="bg-list-item">暂无相关记录需要调整</view></view><view wx:if="{{action === 'merge'}}" class="bg-notice">关联记录将转到目标，当前记录保留合并去向，不能直接恢复成独立记录。</view><view wx:else class="bg-notice">游戏安排将清除这盒实物的选择。历史对局中的游戏及成绩保持原有记录。{{preview.clears_bgg_edition ? '原 BGG 版次及对应版本、语言会清空，旧选择保留在修改记录中。' : ''}}</view><view wx:for="{{conflicts}}" wx:key="*this" class="bg-error">{{item}}</view></block>
    <view class="bg-label">操作原因</view><textarea class="bg-input bg-textarea" value="{{reason}}" data-key="reason" bindinput="field" maxlength="500" placeholder="填写核对依据，方便之后追溯"/>
  </block>
  <button slot="footer" class="bg-button full" bindtap="save" disabled="{{saving || conflicts.length || ((action === 'merge' || action === 'correct') && !preview)}}" loading="{{saving}}">{{action === 'merge' ? '确认影响并合并' : action === 'correct' ? '确认影响并更正' : '确认保存'}}</button>
</boardgame-sheet>
<boardgame-sheet title="{{action === 'binding' ? '选择小程序账号' : '选择目标记录'}}" visible="{{pickerOpen}}" bindclose="closePicker">
  <view class="bg-row"><input class="bg-input bg-grow" value="{{pickerQuery}}" bindinput="pickerInput" bindconfirm="searchPicker" placeholder="搜索名称"/><button class="bg-button small" bindtap="searchPicker">搜索</button></view><view wx:if="{{formError}}" class="bg-error">{{formError}}</view>
  <view wx:for="{{pickerItems}}" wx:key="id" class="bg-list-item bg-row" data-id="{{item.id}}" bindtap="choose"><image wx:if="{{item.avatar_url || item.user.avatar_url}}" class="bg-avatar" data-path="{{'pickerItems[' + index + '].' + (item.avatar_url ? 'avatar_url' : 'user.avatar_url')}}" binderror="imageError" src="{{item.avatar_url || item.user.avatar_url}}" mode="aspectFill"/><view class="bg-grow">{{item.label}}</view><text class="bg-link">选择</text></view><view wx:if="{{pickerLoading}}" class="bg-empty">正在查找…</view><view wx:if="{{!pickerLoading && !pickerItems.length}}" class="bg-empty">没有符合条件的记录</view><button wx:if="{{pickerCursor}}" class="bg-button secondary full" data-more="{{true}}" bindtap="searchPicker">加载更多</button>
</boardgame-sheet>
