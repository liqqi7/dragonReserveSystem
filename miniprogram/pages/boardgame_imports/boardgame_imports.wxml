<import src="../../templates/boardgame-name.wxml"/>
<view class="bg-page"><view class="bg-row bg-between"><view class="bg-title">{{id ? '核对导入任务' : '导入与核对'}}</view><button class="bg-button small secondary" bindtap="load">刷新</button></view><view class="bg-subtitle">游戏、实物和对局分开确认；历史默认私有，之后再匹配、公开。</view><view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{notice}}" class="bg-notice">{{notice}}</view>
<block wx:if="{{!id}}"><button class="bg-button full" bindtap="openCreate">导入游戏与对局</button><view class="bg-heading">最近任务</view><view wx:for="{{jobs}}" wx:key="id" class="bg-card" data-id="{{item.id}}" bindtap="openJob"><view class="bg-row bg-between"><text>{{item.kindLabel}}</text><text class="bg-badge">{{item.stateLabel}}</text></view><view class="bg-subtitle">{{item.created_at}}　›</view></view><view wx:if="{{!loading && !jobs.length}}" class="bg-empty">还没有导入任务</view><button wx:if="{{nextCursor}}" class="bg-button secondary full" bindtap="more">更多任务</button><view class="bg-heading">来源接入状态</view><view wx:for="{{capabilities}}" wx:key="provider" class="bg-card"><view class="bg-row bg-between"><text>{{item.label}}</text><text class="bg-badge">{{item.available ? '可用' : '暂未开放'}}</text></view><view wx:if="{{!item.available}}" class="bg-subtitle">{{item.reason || '任务处理暂未启用'}}</view></view></block>
<block wx:if="{{id && job}}"><view class="bg-card"><view class="bg-row bg-between"><text>{{job.kindLabel}}</text><text class="bg-badge">{{job.stateLabel}}</text></view><view class="import-actions"><button class="bg-chip" bindtap="openReport">处理报告</button><button class="bg-chip" bindtap="openMappings">已确认的映射</button><button wx:if="{{job.state === 'failed' || job.state === 'partial'}}" class="bg-chip" bindtap="retry" disabled="{{saving}}">重试失败项</button></view></view><view wx:if="{{jobBusy}}" class="bg-notice">来源任务正在处理，稍后点击刷新查看结果。</view><view wx:for="{{items}}" wx:key="id" class="bg-card" data-id="{{item.id}}" bindtap="review"><view class="bg-row bg-between"><text>{{item.title}}</text><text class="bg-badge">{{item.stateLabel}}</text></view><view class="bg-subtitle">{{item.kindLabel}}{{item.normalized.played_on ? ' · ' + item.normalized.played_on : ''}} · {{item.issues.length ? '有内容需核对' : '查看并确认'}}　›</view></view><button wx:if="{{itemCursor}}" class="bg-button secondary full" bindtap="more">加载更多条目</button></block><view wx:if="{{loading}}" class="bg-empty">正在读取任务…</view></view>
<boardgame-sheet title="导入来源" kind="form" visible="{{createOpen}}" bindclose="closeCreate" busy="{{saving}}" size="standard"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="import-actions"><button class="bg-chip {{source === 'bgstats' ? 'active' : ''}}" data-value="bgstats" bindtap="source">BG Stats 文件</button><button class="bg-chip {{source === 'bgg' ? 'active' : ''}}" data-value="bgg" bindtap="source">BGG 账号</button></view><block wx:if="{{source === 'bgstats'}}"><view class="bg-label">JSON 或 bgsplay 文件</view><button class="bg-button secondary full" bindtap="chooseFile">{{file ? file.name : '从聊天文件选择'}}</button><view class="bg-label">是否继续之前的数据集</view><picker range="{{datasets}}" range-key="label" value="{{datasetIndex}}" bindchange="dataset"><view class="bg-input">{{datasets[datasetIndex].label}} ⌄</view></picker><view class="bg-subtitle">重复导出请选择同一个数据集，已确认的人员映射会复用。</view><view class="bg-label">来源时区</view><input class="bg-input" value="{{timezone}}" data-key="timezone" bindinput="field" placeholder="Asia/Shanghai"/></block><block wx:else><view class="bg-label">BGG 用户名</view><input class="bg-input" value="{{username}}" data-key="username" bindinput="field" placeholder="请输入用户名"/><view class="bg-label">查询哪些内容</view><picker range="{{bggKinds}}" range-key="label" value="{{bggKindIndex}}" bindchange="bggKind"><view class="bg-input">{{bggKinds[bggKindIndex].label}} ⌄</view></picker></block><view wx:if="{{isAdmin}}"><view class="bg-label">数据归属</view><view class="bg-input" data-kind="owner" bindtap="openPicker">{{ownerName}} ⌄</view></view><button slot="footer" class="bg-button full" bindtap="create" disabled="{{saving}}" loading="{{saving}}">创建私有导入任务</button></boardgame-sheet>
<boardgame-sheet title="核对来源条目" kind="{{canDecide ? 'form' : 'info'}}" visible="{{reviewOpen}}" bindclose="closeReview" busy="{{saving}}" size="high"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-heading">{{selected.title}}</view><block wx:if="{{review}}"><view wx:if="{{review.issueLabels.length}}" class="bg-notice"><view wx:for="{{review.issueLabels}}" wx:key="*this">· {{item}}</view><view wx:if="{{canDecide}}" class="bg-row bg-between"><text>已逐项核对</text><switch checked="{{acknowledged}}" data-key="acknowledged" bindchange="ack" color="#FF9800"/></view></view><view class="bg-label">对应的本地游戏</view><view wx:if="{{canDecide}}" class="bg-input" data-kind="game" bindtap="openPicker">{{game.name || '选择已有游戏；资料条目也可新建'}} ⌄</view><view wx:else class="bg-card"><template is="boardgame-name" data="{{game:(game || {name:selected.title})}}"/></view><view wx:if="{{review.player_slots.length}}" class="bg-label">来源玩家与本地成员</view><view wx:for="{{decisionPlayers}}" wx:key="source_slot" class="bg-card"><view class="bg-row bg-between"><text>{{item.name}}</text><text class="bg-muted">{{item.is_anonymous ? (item.participant_kind === 'automa' ? 'Automa' : '本局匿名身份') : item.choice ? item.choice.label : '尚未匹配'}}</text></view><view class="bg-subtitle">{{item.score === null ? '分数未填' : item.score + ' 分'}}{{item.source_winner === true ? ' · 来源标记获胜' : ''}}</view><view wx:if="{{canDecide && !item.is_anonymous}}" class="import-actions"><button class="bg-chip" data-kind="person" data-slot="{{item.source_slot}}" bindtap="openPicker">匹配成员</button><button class="bg-chip" data-slot="{{item.source_slot}}" bindtap="keepUnmatched">保留待匹配身份</button></view></view>
<view wx:if="{{canDecide && action === 'create_play' && review.normalized.quantity > 1}}" class="bg-card"><view class="bg-heading">逐局核对 · {{review.normalized.quantity}} 局</view><view class="bg-subtitle">来源分数和时长可能是汇总值。每局单独填写，未记分保留未知；本机草稿在确认导入后才写入私有历史。</view><view wx:for="{{segments}}" wx:key="index" class="bg-list-item bg-row bg-between" data-index="{{index}}" bindtap="editSegment"><view class="bg-grow"><view>第 {{index + 1}} 局 · {{item.date}}</view><view class="bg-muted">{{item.players}} 人 · {{item.status}}</view></view><text class="bg-link">核对 ›</text></view><button wx:if="{{!segments.length}}" class="bg-button secondary full" bindtap="editSegment">开始逐局核对</button></view>
<view wx:for="{{review.same_source}}" wx:key="play_id" class="bg-card"><view>{{item.available === false ? '该来源已被其他账号关联' : item.changed ? '同来源有更新' : '同来源已经保存'}}</view><view wx:if="{{item.locally_modified}}" class="bg-notice">本地也有更正，更新前请仔细核对。</view><view wx:for="{{item.differences}}" wx:for-item="diff" wx:key="field" class="import-diff"><text class="bg-label">{{diff.label}}</text><view class="bg-muted">原：{{diff.beforeText}}</view><view>新：{{diff.afterText}}</view></view><button wx:if="{{canDecide && item.changed && item.publication_status === 'held'}}" class="bg-chip {{action === 'update_play' ? 'active' : ''}}" data-action="update_play" data-id="{{item.play_id}}" bindtap="action">核对后更新这局</button></view>
<view wx:if="{{canDecide && review.normalized.location_name && (action === 'create_play' || action === 'update_play')}}" class="bg-card"><view class="bg-label">来源地点 · {{review.normalized.location_name}}</view><view class="bg-subtitle">{{locationChoice.label || '尚未匹配，只保留原地点文字'}}</view><view class="import-actions"><button class="bg-chip" data-kind="location" bindtap="openPicker">匹配已有地点</button><button class="bg-chip" bindtap="keepLocation">单独保留来源地点</button></view></view><view wx:if="{{canDecide && review.candidates.length}}" class="bg-label">同游戏同日的相似对局</view><view wx:if="{{canDecide}}" wx:for="{{review.candidates}}" wx:key="id" class="bg-card"><view>{{item.game_name}} · {{item.played_on}}</view><view class="bg-subtitle"><text wx:for="{{item.players}}" wx:for-item="person" wx:key="name">{{person.name}} </text></view><view class="bg-subtitle">{{item.duration_minutes ? item.duration_minutes + ' 分钟' : '时长未知'}}{{item.linked_to_source ? ' · 已关联此来源' : ''}}</view><button class="bg-chip {{targetPlay.id === item.id && action === 'link_play' ? 'active' : ''}}" data-action="link_play" data-id="{{item.id}}" bindtap="action">这是同一局，仅关联来源</button></view><view wx:if="{{review.more_candidates}}" class="bg-muted">候选较多，当前显示最近 20 局，请结合历史页继续核对。</view><button wx:if="{{canDecide && (selected.source_kind === 'bgstats_play' || selected.source_kind === 'bgg_play')}}" class="bg-chip {{action === 'create_play' ? 'active' : ''}}" data-action="create_play" bindtap="action">{{review.candidates.length ? '是另一局，另建记录' : '建立私有对局记录'}}</button>
<block wx:if="{{canDecide && action === 'create_inventory'}}"><view class="bg-row bg-between"><text>手动核对实物字段</text><switch checked="{{inventoryOverride}}" data-key="inventoryOverride" bindchange="ack" color="#FF9800"/></view><block wx:if="{{inventoryOverride}}"><view class="bg-label">状态</view><picker range="{{inventoryStatuses}}" range-key="label" value="{{inventoryStatusIndex}}" bindchange="inventoryStatus"><view class="bg-input">{{inventoryStatuses[inventoryStatusIndex].label}} ⌄</view></picker><view class="bg-label">购入价 / 币种</view><view class="bg-row"><input class="bg-input bg-grow" value="{{inventoryForm.purchase_price}}" type="digit" data-key="purchase_price" bindinput="inventoryField" placeholder="未填写"/><input class="bg-input" style="width:120rpx" value="{{inventoryForm.purchase_currency}}" data-key="purchase_currency" bindinput="inventoryField" maxlength="3" placeholder="CNY"/></view><view class="bg-label">购入日期</view><input class="bg-input" value="{{inventoryForm.purchased_on}}" data-key="purchased_on" bindinput="inventoryField" placeholder="YYYY-MM-DD，可留空"/><view class="bg-muted">按来源建立 {{inventoryForm.quantity}} 盒；来源已不拥有的实物可明确记为退役。</view></block></block><view wx:if="{{canDecide && action === 'update_play'}}" class="bg-row bg-between"><text>确认替换来源计分结构，原件继续保留</text><switch checked="{{replaceSheet}}" data-key="replaceSheet" bindchange="ack" color="#FF9800"/></view><block wx:if="{{canDecide}}"><view class="bg-label">核对说明 / 更正原因</view><textarea class="bg-input bg-textarea" value="{{reason}}" data-key="reason" bindinput="field" placeholder="关联、更新已有记录时必填"/></block>
<view wx:for="{{review.applied_plays}}" wx:key="id" class="bg-card"><view>已保存的对局 · {{item.played_on}}</view><view class="bg-subtitle">{{item.can_publish ? '当前私有，不进入榜单' : item.publication_status === 'published' ? '已在小程序公开' : '仍需补齐记录'}} · {{item.players.length}} 位参与者</view><view class="import-actions"><button wx:if="{{item.publication_status === 'held'}}" class="bg-chip" data-id="{{item.id}}" bindtap="editHeld">编辑并匹配人员</button><button wx:if="{{item.can_publish}}" class="bg-button small" data-id="{{item.id}}" bindtap="openPublish">核对公开范围</button></view></view></block><view wx:if="{{canDecide}}" slot="footer" class="bg-row" style="width:100%"><button class="bg-button secondary" data-action="skip" bindtap="saveDecision" disabled="{{saving || jobBusy}}">跳过此项</button><button class="bg-button bg-grow" bindtap="saveDecision" disabled="{{saving || jobBusy}}">确认{{action === 'link_play' ? '关联' : action === 'update_play' ? '更新' : '导入'}}</button></view></boardgame-sheet>
<boardgame-sheet title="{{pickerTitle}}" visible="{{pickerOpen}}" kind="info" bindclose="closePicker"><view class="bg-row"><input class="bg-input bg-grow" value="{{pickerQuery}}" bindinput="pickerInput" placeholder="搜索名称"/><button class="bg-button small" bindtap="searchPicker">搜索</button></view><view wx:for="{{pickerItems}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="choose"><view>{{item.label}}</view><view wx:if="{{item.original_name && item.original_name !== item.label}}" class="bg-original-name">{{item.original_name}}</view></view><button wx:if="{{pickerCursor}}" class="bg-button secondary full" data-more="{{true}}" bindtap="searchPicker">加载更多</button><view wx:if="{{!pickerItems.length}}" class="bg-empty">没有匹配结果</view></boardgame-sheet>
<boardgame-sheet title="公开这一局历史" kind="form" visible="{{publishOpen}}" bindclose="closePublish" busy="{{saving}}" size="standard"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-card"><template is="boardgame-name" data="{{game:(publishPlay.game || publishPlay.game_snapshot)}}"/><view class="bg-subtitle">{{publishPlay.played_on}} · {{publishPlay.players.length}} 位参与者</view><view wx:for="{{publishPlay.players}}" wx:key="id" class="bg-list-item">{{item.display_name_snapshot}} · {{item.score === null ? '未记分' : item.score + ' 分'}}</view></view><view class="bg-notice">公开后，小程序登录成员可查看这局的玩家、成绩、地点与备注。符合口径的完成记录会计入榜单。</view><view class="bg-row bg-between"><text>我确认公开这局内容</text><switch checked="{{publishPublic}}" data-key="publishPublic" bindchange="ack" color="#FF9800"/></view><view wx:if="{{publishPlay.unmatched_people.length}}" class="bg-card"><view>还有 {{publishPlay.unmatched_people.length}} 位玩家未关联小程序账号</view><view class="bg-row bg-between"><text>确认先按当前来源姓名公开</text><switch checked="{{publishPeople}}" data-key="publishPeople" bindchange="ack" color="#FF9800"/></view></view><view class="bg-label">核对说明 *</view><input class="bg-input" value="{{publishReason}}" data-key="publishReason" bindinput="field" placeholder="说明已完成哪些核对"/><button slot="footer" class="bg-button full" bindtap="publish" disabled="{{saving || !publishPublic}}">确认公开这一局</button></boardgame-sheet>
<boardgame-sheet title="导入报告" visible="{{reportOpen}}" kind="info" bindclose="closeReport"><view wx:for="{{report.counts}}" wx:key="label" class="bg-list-item bg-row bg-between"><text>{{item.label}}</text><text>{{item.count}}</text></view><view wx:for="{{report.outcomes}}" wx:key="label" class="bg-list-item"><view>{{item.label}} · {{item.items}} 条来源</view><view class="bg-muted">{{item.games}} 款游戏 · {{item.inventory}} 盒实物 · {{item.plays}} 局</view></view><view wx:for="{{report.publication}}" wx:key="label" class="bg-row bg-between"><text>{{item.label}}</text><text>{{item.count}} 局</text></view><view class="bg-notice">{{report.next_step}}</view><view>原件私有 · 不按姓名自动匹配 · 不执行来源删除标记</view></boardgame-sheet>
<boardgame-sheet title="已确认的映射" visible="{{mappingsOpen}}" kind="info" bindclose="closeMappings"><view wx:for="{{mappings}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="mappingHistory"><view>{{item.entity_type === 'player' ? '玩家' : item.entity_type === 'game' ? '游戏' : '地点'}} → {{item.target.name || '目标需要重新核对'}}</view><text class="bg-muted">已确认版本 {{item.revision}} · 查看变更记录 ›</text></view><button wx:if="{{mappingCursor}}" class="bg-button secondary full" bindtap="moreMappings">加载更多映射</button></boardgame-sheet>
<boardgame-sheet title="映射变更记录" visible="{{historyOpen}}" kind="info" bindclose="closeHistory"><view wx:for="{{mappingHistory}}" wx:key="id" class="bg-list-item"><view>确认版本 {{item.entity_revision}}</view><text class="bg-muted">{{item.created_at}}</text></view></boardgame-sheet>
