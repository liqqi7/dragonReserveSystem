@import "../../styles/dragonChrome.wxss";

/* ============================================================
   微信原生 Light UI — Activity List
   色彩体系（与微信官方设计规范对齐）：
     页面背景   #F7F7F7
     卡片背景   #FFFFFF
     文字主色   #191919
     文字次色   #888888
     文字弱色   #C6C6C6
     分割线     #EEEEEE
     主色(蓝)  #1989FA
     链接(蓝)  #576B95
     警告(橙)  #FA9D3B
     危险(红)  #FA5151
   ============================================================ */

page {
  background-color: #ffffff;
  overflow-x: hidden;
}

.container {
  padding: 0;
  background-color: #F7F7F7;
}

.empty-text {
  font-size: 28rpx;
  color: #C6C6C6;
}

.btn {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #888888;
}


.meta-icon {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  align-self: center;
  margin-right: 12rpx;
}

.meta-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  background-color: #F7F7F7;
  display: block;
  position: relative;
  z-index: 0;
}

/* ── 弹窗进场动画 ── */
@keyframes overlayFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(56rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ── 弹窗遮罩 ── */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

/* ── 详情弹窗 ── */
.modal-content {
  background-color: #ffffff;
  border-radius: 16rpx;
  width: 90%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
  font-size: 32rpx;
  font-weight: 600;
  color: #191919;
}


.modal-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

/* ── 弹窗底栏 ── */
.modal-footer {
  display: flex;
  flex-shrink: 0;
  padding: 24rpx;
  border-top: 1rpx solid #EEEEEE;
  gap: 16rpx;
  background-color: #ffffff;
  position: relative;
  z-index: 2;
}

.modal-footer .btn {
  flex: 1;
  margin: 0;
}

/* ── 表单 ── */
.form-item {
  margin-bottom: 24rpx;
}

.form-item .label {
  font-size: 26rpx;
  color: #191919;
  margin-bottom: 8rpx;
  display: block;
}

.input {
  border-radius: 8rpx;
  border: 1rpx solid #EEEEEE;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background-color: #F7F7F7;
  color: #191919;
}

.textarea {
  border-radius: 8rpx;
  border: 1rpx solid #EEEEEE;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background-color: #F7F7F7;
  color: #191919;
  min-height: 120rpx;
}

.picker {
  border-radius: 8rpx;
  border: 1rpx solid #EEEEEE;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background-color: #F7F7F7;
  color: #191919;
}

.divider {
  height: 1rpx;
  background-color: #EEEEEE;
  margin: 24rpx 0;
}

.participant-actions {
  display: flex;
  align-items: center;
}

/* ── 弹窗按钮 ── */
.btn {
  width: 100%;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  border: none;
}

.btn.primary {
  background-color: #1989FA;
  color: #ffffff;
}

.btn.default {
  background-color: #F7F7F7;
  color: #888888;
}

.btn.danger {
  background-color: #FA5151;
  color: #ffffff;
}

/* ============================================================
   重构新增样式 — 首页分组卡片流
   ============================================================ */

/* ── 页面根容器（见上方 page 底色；此处仅占位与 .page-wrap） ── */
.page-wrap {
  height: 100vh;
  min-height: 0;
  background-color: #FFFFFF;
  position: relative;
  width: 100%;
  max-width: 100vw;
  overflow: hidden;
}

/* 背景水印：固定为原型 x=175、y=-29、323×211，不参与 scroll-view 排版。 */
.page-watermark {
  position: absolute;
  pointer-events: none;
}

/* ── 自定义透明顶部栏 ── */
.custom-navbar {
  position: relative;
  z-index: 2;
  background-color: transparent;
  overflow: visible;
}

.custom-navbar + .group-section {
  margin-top: 23.08rpx;
}

.navbar-inner {
  height: 84.62rpx;
  display: flex;
  align-items: center;
  padding: 0 38.46rpx;
  position: relative;
  z-index: 2;
}

.navbar-title {
  font-size: 46.15rpx;
  font-weight: 600;
  line-height: 65.38rpx;
  color: #0a0a0a;
  letter-spacing: 0;
  flex: 1;
  transform: translateY(-1.92rpx);
}

/* ── 主滚动区 ── */
.main-scroll {
  height: 100%;
  background-color: transparent;
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

.main-refresher-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx 0;
  background-color: #ffffff;
}

.main-refresher-hint {
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
}

/* ── 分组区块 ── */
.group-section:first-child {
  margin-top: 24rpx;
}

.group-section {
  /* 卡片行底部已保留 38.46rpx（在 390px 屏宽上为 20px），模块不再叠加外边距。 */
  margin-bottom: 0;
}

.group-header {
  height: 53.85rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38.46rpx;
}

.group-title {
  font-size: 38.46rpx;
  font-weight: 700;
  line-height: 53.85rpx;
  color: #0a0a0a;
}

/* ── Skyline 原生卡片轮播 ── */
.cards-swiper {
  width: 100%;
  overflow: visible;
  box-sizing: border-box;
}

/* 冷启动首批卡片只做一次轻量入场；不触碰 swiper 内部位移和卡片转场。 */
.home-card-entrance {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 440ms ease-out;
}

.home-card-entrance--pending {
  pointer-events: none;
  opacity: 0;
  transform: translateY(0);
}

.home-card-entrance--idle,
.home-card-entrance--entered {
  opacity: 1;
  transform: translateY(0);
}

.large-cards-swiper {
  height: 688.46rpx;
}

.small-cards-swiper {
  height: 450.00rpx;
}

.large-card-slide,
.small-card-slide {
  box-sizing: border-box;
  overflow: visible;
}

.large-card-slide {
  padding: 23.08rpx 23.08rpx 38.46rpx 0;
}

.small-card-slide {
  /* 将原有 23.08rpx 卡间距均分到左右，卡片 x 坐标和轮播步长保持不变。 */
  padding: 23.08rpx 11.54rpx 38.46rpx;
}

.large-card-wrap {
  display: inline-flex;
  width: 469.23rpx;
  flex-direction: column;
  align-items: flex-start;
    flex-shrink: 0;
  background-color: transparent;
}

.large-card-transition {
  display: block;
  width: 469.23rpx;
  height: 626.92rpx;
  overflow: visible;
  border-radius: 46.15rpx;
  background-color: transparent;
  box-shadow: none;
}


/* 大卡片主体 */
.large-card {
  width: 469.23rpx;
  height: 626.92rpx;
  border-radius: 46.15rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: none;
}

/* 「已结束」横向末尾加载格（宽同 .small-card-wrap，保证横向 snap 步长一致） */
.ended-more-strip .ended-more-card {
  width: 100%;
  min-height: 307.69rpx;
  border-radius: 11.54rpx;
  border: 1px dashed rgba(0, 0, 0, 0.12);
  background: rgba(247, 247, 248, 0.96);
  box-sizing: border-box;
  padding: 23.08rpx 19.23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ended-more-strip .ended-more-text {
  font-size: 23.08rpx;
  line-height: 1.45;
  color: #8a8a8e;
  text-align: center;
}

.small-card-wrap {
  display: block;
  flex-shrink: 0;
  width: 307.69rpx;
  background-color: transparent;
  overflow: visible;
  position: relative;
  z-index: 1;
}

/*
 * 阴影必须位于 open-container 外层。Skyline 的转场容器会建立独立裁切边界，
 * 即便后代声明 overflow:visible，外阴影仍可能在左右两侧被截断。
 */
.small-card-layout {
  width: 307.69rpx;
  position: relative;
  flex-shrink: 0;
  background-color: transparent;
  overflow: visible;
}

.small-card-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 15.38rpx;
  width: 307.69rpx;
  background-color: transparent;
  overflow: visible;
}

/* 保留原有布局层，首页卡片不再绘制外阴影。 */
.small-card-shadow {
  position: absolute;
  top: 0;
  left: 0;
  width: 307.69rpx;
  height: 307.69rpx;
  border-radius: 46.15rpx;
  overflow: visible;
  box-shadow: none;
  pointer-events: none;
  z-index: 0;
}

/* 小卡片主体只负责裁切图片和内部内容。 */
.small-card {
  width: 307.69rpx;
  height: 307.69rpx;
  border-radius: 46.15rpx;
  position: relative;
  overflow: hidden;
  box-shadow: none;
}

.small-card-info {
  display: flex;
  flex-direction: column;
  margin-top: 15.38rpx;
  padding: 0;
  background-color: transparent;
}

.small-card-name {
  display: block;
  font-size: 23.08rpx;
  line-height: 32.69rpx;
  font-weight: 500;
  color: #000000;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 292rpx;
}

.small-card-time {
  display: block;
  font-size: 23.08rpx;
  line-height: 32.69rpx;
  font-weight: 500;
  color: #8a8a8e;
  margin-top: 0;
  white-space: nowrap;
}



.card-image-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}









.glass-meta-icon-img {
  width: 25.00rpx;
  height: 25.00rpx;
  flex-shrink: 0;
  display: block;
}


/* ── 大卡片毛玻璃底部 ── */
.glass-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  box-sizing: border-box;
  /* 微信渲染会向下取整子项 rpx；31.4rpx 在常见视口恢复原型 16px 的实际边距。 */
  padding: 23.08rpx;
  z-index: 3;
  overflow: hidden;
  border-bottom-left-radius: 46.15rpx;
  border-bottom-right-radius: 46.15rpx;
}

/* GIF 仍实时采样当前帧，但模糊半径对齐静态玻璃图的 Pillow 6.5px。 */
.glass-bottom--native {
  backdrop-filter: blur(12.5rpx);
}

/* 静态封面的模糊视口，只显示卡片底部信息区。 */
.glass-static-blur-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  border-bottom-left-radius: inherit;
  border-bottom-right-radius: inherit;
  pointer-events: none;
  background: rgba(31, 41, 55, 0.58);
}

/*
 * 静态封面的毛玻璃使用服务端预渲染图。stage 按整张卡片坐标对齐，
 * glass-bottom 负责把它裁切在卡片内部并保留底部圆角。
 */
.glass-static-blur-stage {
  position: absolute;
  left: 0;
  bottom: 0;
  /* 与整张卡片底边对齐，信息栏高度变化时不再依赖硬编码 top。 */
  width: 469.23rpx;
  height: 626.92rpx;
  overflow: visible;
  pointer-events: none;
}

.glass-static-blur-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 469.23rpx;
  height: 626.92rpx;
  display: block;
}

.glass-tint-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  border-bottom-left-radius: 46.15rpx;
  border-bottom-right-radius: 46.15rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.30) 100%);
}


.glass-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 15.38rpx;
}

.glass-name {
  display: block;
  font-size: 26.92rpx;
  font-weight: 700;
  line-height: 26.92rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 0;
}

.glass-time-row {
  display: flex;
  align-items: center;
  gap: 11.54rpx;
  height: 25.00rpx;
}

.glass-time-text {
  font-size: 23.08rpx;
  line-height: 25.00rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.glass-meta-row {
  display: flex;
  align-items: center;
  height: 25.00rpx;
  gap: 30.77rpx;
  margin-top: 0;
}

.glass-meta-item {
  display: flex;
  align-items: center;
  gap: 11.54rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.glass-meta-item--people {
  gap: 7.69rpx;
}

.glass-meta-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}

.glass-meta-text {
  font-size: 23.08rpx;
  line-height: 25.00rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.85);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
}

/* Independent skeletons sit outside the transparent animated content. */
.home-card-slot { position: relative; }
.home-card-slot--large { width: 469.23rpx; }
.home-card-slot--small { width: 307.69rpx; }
.card-skeleton { position: absolute; top: 0; left: 0; z-index: 2; opacity: 1; pointer-events: none; transition: opacity 440ms ease-out; }
/* The placeholder remains mounted for its crossfade but must never block card navigation. */
.card-skeleton--revealed { opacity: 0; pointer-events: none; }
.card-skeleton--large { width: 469.23rpx; }
.card-skeleton--small { width: 307.69rpx; }
.skeleton-block { position: relative; overflow: hidden; background: #EAECEF; }

.skeleton-large { width: 469.23rpx; height: 626.92rpx; border-radius: 46.15rpx; }
.skeleton-small { width: 307.69rpx; height: 307.69rpx; border-radius: 46.15rpx; }
.skeleton-heading { width: 153.85rpx; height: 38.46rpx; border-radius: 19.23rpx; }
.skeleton-name { width: 246.15rpx; height: 23.08rpx; border-radius: 11.54rpx; margin-top: 15.38rpx; }
.skeleton-time { width: 184.62rpx; height: 23.08rpx; border-radius: 11.54rpx; margin-top: 9.62rpx; }
.skeleton-shimmer {
  position: absolute; top: 0; bottom: 0; left: 0; width: 45%;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.65), rgba(255,255,255,0));
  transform: translateX(-100%);
}
/* Use Skyline's existing transform-transition path rather than CSS keyframes. */
.skeleton-shimmer--running { transform: translateX(325%); transition: transform 1400ms linear; }
.home-loading-shell { overflow: hidden; }
.skeleton-initial-row { display: flex; flex-direction: row; padding-left: 38.46rpx; padding-top: 23.08rpx; box-sizing: border-box; }
.skeleton-initial-row--large { height: 688.46rpx; }
.skeleton-initial-row--small { height: 450.00rpx; }
.skeleton-initial-large { position: relative; width: 469.23rpx; height: 626.92rpx; margin-right: 23.08rpx; flex-shrink: 0; }
.skeleton-initial-small { position: relative; width: 307.69rpx; height: 391.54rpx; margin-right: 23.08rpx; flex-shrink: 0; }

/* A failed image keeps its skeleton, but offers an explicit recovery action. */
.home-card-retry { position: absolute; top: 0; left: 0; width: 100%; display: flex; align-items: center; justify-content: center; color: #666666; font-size: 25rpx; z-index: 3; }
.home-card-retry--large { height: 626.92rpx; }
.home-card-retry--small { height: 307.69rpx; }

/* 管理员首页「小工具」：与活动卡片一致的分页 swiper，卡片仍按内容撑高。
 * 固定视口保留 2px 文本取整余量，防止卡片底边被裁切。 */
.home-tools-swiper {
  height: calc(187.69rpx + 3.85rpx + 23.08rpx + 38.46rpx);
  margin-top: 23.08rpx;
  margin-bottom: 0;
}

.home-tool-slide {
  box-sizing: border-box;
  overflow: visible;
  padding-top: 23.08rpx;
  padding-right: 23.08rpx;
  padding-bottom: 38.46rpx;
}

.home-tool-card {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 538.46rpx;
  flex: none;
  align-items: center;
  overflow: hidden;
  padding: 30.77rpx;
  border-radius: 46.15rpx;
  background-color: #faf7f5;
  box-shadow: 0 11.54rpx 38.46rpx rgba(0, 0, 0, 0.1);
}

.home-tool-glow {
  position: absolute;
  top: -15.38rpx;
  right: -48.08rpx;
  z-index: 1;
  width: 240.38rpx;
  height: 240.38rpx;
  border-radius: 50%;
}

.home-tool-card--chwazi .home-tool-glow {
  background-color: rgba(119, 217, 247, 0.24);
}

.home-tool-card--boardgames .home-tool-glow {
  background-color: rgba(252, 204, 91, 0.24);
}

.home-tool-copy {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 7.69rpx;
}

.home-tool-title {
  color: #1a1a1a;
  font-size: 30.77rpx;
  font-weight: 700;
  line-height: 1.4;
}

.home-tool-description-lines {
  display: flex;
  flex-direction: column;
}

.home-tool-description {
  color: #6b7280;
  font-size: 26.92rpx;
  font-weight: 400;
  line-height: 1.4;
}

.home-tool-art {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  width: 253.85rpx;
  height: 253.85rpx;
}

/* Card shadows rendered on the native open-container itself so they are
   not clipped or covered by the container layer. */
.large-card-transition {
  border-radius: 46.15rpx;
  box-shadow: 0 11.54rpx 38.46rpx rgba(0, 0, 0, 0.1);
}

.small-card-wrap {
  border-radius: 46.15rpx;
  box-shadow: 0 11.54rpx 38.46rpx rgba(0, 0, 0, 0.1);
}
