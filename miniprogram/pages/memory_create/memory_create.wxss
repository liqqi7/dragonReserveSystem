@import "../../styles/formControls.wxss";
@import "../../styles/memory.wxss";
@import "../../styles/memorySheet.wxss";
.memory-form {
  padding-bottom: 0;
}
.memory-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 23.08rpx;
  margin-bottom: 116.53846rpx;
}
.memory-intro + .memory-field {
  margin-top: 0;
}
.upload-grid {
  display: flex;
  flex-direction: row;
  height: 180.76923rpx;
  margin-left: -53.85rpx;
}
.upload-scroll {
  flex: 1;
  width: 0;
  height: 100%;
  display: flex;
  flex-direction: row;
}
.upload-leading-space {
  flex: none;
  width: 53.85rpx;
  height: 180.76923rpx;
}
.upload-hint {
  color: #9ca3af;
  font-size: 21.15385rpx;
  font-weight: 400;
  line-height: 1.2;
}
.upload-tile {
  position: relative;
  width: 180.76923rpx;
  height: 180.76923rpx;
  flex: none;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 23.07692rpx;
  padding: 0;
  margin: 0;
  background: #f3f4f6;
}
.upload-scroll .upload-tile {
  margin-right: 15.38462rpx;
}
.upload-scroll .upload-tile:last-child {
  margin-right: 0;
}
.upload-remove {
  position: absolute;
  right: 7.69231rpx;
  top: 7.69231rpx;
  width: 38.46154rpx;
  height: 38.46154rpx;
  border-radius: 50%;
  background: #00000066;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-remove image {
  width: 19.23077rpx;
  height: 19.23077rpx;
}
.upload-status {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 11.53846rpx;
  background: #00000088;
  color: #ffffff;
  font-size: 21.15385rpx;
  font-weight: 500;
  line-height: 1.2;
}
.upload-spinner,
.upload-progress-ring {
  width: 50rpx;
  height: 50rpx;
}
.upload-progress-ring {
  mask-image: url("/images/memory-upload-progress-mask.svg");
  mask-size: 100% 100%;
  mask-repeat: no-repeat;
}
.upload-spinner {
  animation-name: upload-spin;
  animation-duration: 1s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
@keyframes upload-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.upload-cover {
  display: block;
  width: 100%;
  height: 100%;
}
.upload-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 19.23077rpx;
  height: 19.23077rpx;
  padding: 9.61538rpx;
  box-sizing: content-box;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
}
.upload-duration {
  position: absolute;
  right: 7.69231rpx;
  bottom: 11.53846rpx;
  height: 23.07692rpx;
  padding: 0 7.69231rpx;
  border-radius: 11.53846rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 17.30769rpx;
  line-height: 23.07692rpx;
}
.upload-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 11.53846rpx;
  color: #9ca3af;
  font-size: 21.15385rpx;
  line-height: 1.2;
  border: 1.92308rpx solid #e5e7eb;
  box-sizing: border-box;
}
.memory-footer .primary {
  margin: 0;
  padding: 0;
  line-height: 1;
}
.upload-add image {
  width: 46.15385rpx;
  height: 46.15385rpx;
}
.memory-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  line-height: 1.2;
  margin: 0;
}
.memory-picker--placeholder {
  color: #9ca3af;
}
.memory-picker-value {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3.84615rpx;
}
.memory-picker text {
  min-width: 0;
  flex: 1;
}
.memory-picker image {
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
  margin-left: 16rpx;
}
.memory-counter {
  color: #9ca3af;
}
.memory-clear {
  padding: 8rpx 0;
  background: transparent;
  color: #6b7280;
  font-size: 24rpx;
  text-align: left;
}
.activity-option {
  margin: 0 0 16rpx;
  text-align: left;
  font-size: 28rpx;
  padding: 20rpx;
}
