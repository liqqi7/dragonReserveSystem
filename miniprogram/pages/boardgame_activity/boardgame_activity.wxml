<import src="../../templates/boardgame-name.wxml"/>
<view class="bg-page"><view class="bg-title">{{name}}</view><view class="bg-subtitle">提名想玩什么，安排桌次，最后记下实际玩的游戏。</view><view wx:if="{{!id}}" class="bg-notice">请先选择一场活动，再查看大家想玩的桌游。<button class="bg-button full" bindtap="openActivities">选择活动</button></view><view wx:if="{{loading}}" class="bg-empty">正在加载活动桌游…</view><view wx:if="{{error}}" class="bg-error" bindtap="load">{{error}} · 点击重试</view><button wx:if="{{error && !summary}}" class="bg-button secondary full" bindtap="openActivities">选择其他活动</button><block wx:if="{{summary}}"><view class="activity-tabs"><button class="bg-chip {{tab === 'nominations' ? 'active' : ''}}" data-tab="nominations" bindtap="tab">大家想玩</button><button class="bg-chip {{tab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="tab">游戏安排</button><button class="bg-chip" bindtap="history">实际对局 {{summary.play_summary.completed_count}}</button></view><view wx:if="{{tab === 'nominations'}}"><view class="bg-heading"><text>大家想玩</text><text wx:if="{{summary.permissions.can_nominate}}" class="bg-link" data-kind="nomination" bindtap="add">＋ 提名</text></view><view class="bg-notice">{{summary.nomination_state.editable ? '创建者和报名成员可提名，活动开始前可修改。' : '活动已开始或不可提名，提名名单已保留。'}}</view><view wx:for="{{summary.nominations}}" wx:key="game_id" class="bg-card"><view class="bg-row"><image wx:if="{{item.game.cover_url}}" class="bg-thumb" data-path="summary.nominations[{{index}}].game.cover_url" binderror="imageError" src="{{item.game.cover_url}}" mode="aspectFill"/><view class="bg-grow"><template is="boardgame-name" data="{{game:item.game}}"/></view><text class="bg-link" data-id="{{item.game.id}}" bindtap="people">{{item.nomination_count}} 人想玩 ›</text></view><view class="activity-avatar-row" data-id="{{item.game.id}}" bindtap="people"><block wx:for="{{item.people_preview}}" wx:for-item="person" wx:for-index="personIndex" wx:key="id"><image wx:if="{{person.avatar_url}}" class="bg-avatar" data-path="summary.nominations[{{index}}].people_preview[{{personIndex}}].avatar_url" binderror="imageError" src="{{person.avatar_url}}" mode="aspectFill"/><view wx:else class="bg-avatar">{{person.nickname[0] || '人'}}</view></block></view><view wx:if="{{item.mine}}" class="bg-subtitle">我也想玩{{item.mine.expansions.length ? ' · 已选择扩展' : ''}}</view><view class="activity-actions"><button wx:if="{{summary.permissions.can_record}}" class="bg-button small" data-kind="nomination" data-id="{{item.game.id}}" bindtap="record">记录开局</button><block wx:if="{{item.mine && summary.permissions.can_nominate}}"><button class="bg-chip" data-id="{{item.game.id}}" bindtap="editNomination">修改提名</button><button class="bg-chip" data-id="{{item.game.id}}" bindtap="withdraw">撤回提名</button></block></view></view><view wx:if="{{!summary.nominations.length}}" class="bg-empty">还没有人提名游戏</view></view>
<view wx:if="{{tab === 'plans'}}"><view class="bg-heading"><text>计划开这些</text><text wx:if="{{summary.permissions.can_manage_plans}}" class="bg-link" data-kind="plan" bindtap="add">＋ 添加</text></view><view wx:for="{{summary.plans}}" wx:key="id" class="bg-card"><view class="bg-row bg-between"><view class="bg-grow"><template is="boardgame-name" data="{{game:item.game}}"/></view><text class="bg-badge">{{item.table_label || '桌次待定'}}</text></view><view class="bg-subtitle">{{item.bring_label || (item.bring_user_id ? '已安排成员携带' : '携带人待定')}} · {{item.expansions.length}} 个扩展</view><view wx:for="{{item.expansions}}" wx:for-item="expansion" wx:key="game_id" class="bg-subtitle"><view>{{expansion.game_name}}{{expansion.modules_note ? ' · ' + expansion.modules_note : ''}}</view><view wx:if="{{expansion.original_name && expansion.original_name !== expansion.game_name}}" class="bg-original-name">{{expansion.original_name}}</view></view><view wx:if="{{item.note}}" class="activity-note">{{item.note}}</view><view wx:if="{{item.warnings.length}}" class="bg-notice">实物状态或跨活动使用有变化，请核对携带安排。</view><view class="activity-actions"><button wx:if="{{summary.permissions.can_record}}" class="bg-button small" data-kind="plan" data-id="{{item.id}}" bindtap="record">记录开局</button><block wx:if="{{summary.permissions.can_manage_plans}}"><button class="bg-chip" data-id="{{item.id}}" bindtap="editPlan">编辑</button><button class="bg-chip" data-index="{{index}}" data-step="-1" bindtap="move" disabled="{{index === 0}}">上移</button><button class="bg-chip" data-id="{{item.id}}" bindtap="removePlan">移除计划</button></block></view></view><view wx:if="{{!summary.plans.length}}" class="bg-empty">还没有安排桌游计划</view></view><button wx:if="{{summary.permissions.can_record}}" class="bg-button full" bindtap="record">记录其他实际对局</button><view wx:else class="bg-subtitle">{{activityUnavailable ? '活动' + activityStatus + '，可查看提名、计划和历史对局。' : '报名成员签到后可记录，不要求记分人参加这一桌。'}}</view></block></view>
<boardgame-sheet title="选择桌游" visible="{{gameOpen}}" kind="info" bindclose="closeGames"><view class="bg-row"><input class="bg-input bg-grow" value="{{search}}" bindinput="searchInput" placeholder="查找馆藏"/><button class="bg-button small" bindtap="searchGames">搜索</button></view><view wx:for="{{games}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="chooseGame"><template is="boardgame-name" data="{{game:item}}"/></view></boardgame-sheet>
<boardgame-sheet title="{{formKind === 'plan' ? '安排桌游计划' : '我的想玩提名'}}" visible="{{formOpen}}" kind="form" bindclose="closeForm" busy="{{saving}}" size="high"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-heading"><template is="boardgame-name" data="{{game:selectedGame}}"/></view><block wx:if="{{formKind === 'plan'}}"><view class="bg-label">桌次</view><input class="bg-input" value="{{form.table_label}}" data-key="table_label" bindinput="field" placeholder="例如：A 桌"/><view class="bg-label">携带人 / 安排说明</view><input class="bg-input" value="{{form.bring_label}}" data-key="bring_label" bindinput="field" placeholder="暂未确定可留空"/><view class="bg-label">使用的实物</view><picker range="{{boxes}}" range-key="label" value="{{boxIndex}}" bindchange="box"><view class="bg-input">{{boxes[boxIndex].label}} ⌄</view></picker></block><view class="bg-label">备注</view><textarea class="bg-input bg-textarea" value="{{form.note}}" data-key="note" bindinput="field" placeholder="想玩哪个玩法，或携带安排"/><view class="bg-label">选择扩展与其中的模块</view><view wx:for="{{expansions}}" wx:key="expansion_game_id" class="bg-card"><view class="bg-row bg-between"><view class="bg-grow"><template is="boardgame-name" data="{{game:item.game}}"/></view><switch checked="{{item.selected}}" data-id="{{item.game.id}}" bindchange="expansion" color="#FF9800"/></view><block wx:if="{{item.selected}}"><input class="bg-input" value="{{item.modules_note}}" data-id="{{item.game.id}}" bindinput="expansionNote" placeholder="使用哪些模块（留空表示未限定）"/><input class="bg-input" value="{{item.compatibility_note}}" data-id="{{item.game.id}}" data-key="compatibility_note" bindinput="expansionNote" maxlength="500" placeholder="兼容说明（跨本体或版本时填写）"/><picker wx:if="{{formKind === 'plan'}}" range="{{item.boxes}}" range-key="label" value="{{item.boxIndex}}" data-id="{{item.game.id}}" bindchange="expansionBox"><view class="bg-input">{{item.boxes[item.boxIndex].label}} ⌄</view></picker></block></view><button slot="footer" class="bg-button full" bindtap="save" disabled="{{saving}}">保存{{formKind === 'plan' ? '计划' : '提名'}}</button></boardgame-sheet>
<boardgame-sheet title="提名的人" visible="{{peopleOpen}}" kind="info" bindclose="closePeople"><view wx:for="{{people}}" wx:key="id" class="bg-list-item"><view class="bg-row"><image wx:if="{{item.user.avatar_url}}" class="bg-avatar" data-path="people[{{index}}].user.avatar_url" binderror="imageError" src="{{item.user.avatar_url}}" mode="aspectFill"/><view wx:else class="bg-avatar">{{item.user.nickname[0] || '人'}}</view><text class="bg-grow">{{item.user.display_name || item.user.nickname}}</text></view><view class="bg-subtitle">{{item.note || '想一起开这款'}}</view><view wx:for="{{item.expansions}}" wx:for-item="expansion" wx:key="game_id" class="bg-subtitle">{{expansion.game_name}}{{expansion.modules_note ? ' · ' + expansion.modules_note : ''}}<text wx:if="{{expansion.compatibility_note}}"> · {{expansion.compatibility_note}}</text></view></view><button wx:if="{{peopleCursor}}" class="bg-button secondary full" bindtap="morePeople">加载更多</button></boardgame-sheet>

<boardgame-sheet title="选择活动" kind="info" visible="{{activityOpen}}" bindclose="closeActivities"><view wx:if="{{activityLoading}}" class="bg-empty">正在加载活动…</view><view wx:if="{{activityError}}" class="bg-error" bindtap="openActivities">{{activityError}} · 点击重试</view><view wx:for="{{activityItems}}" wx:key="id" class="bg-list-item bg-row bg-between" data-id="{{item.id}}" bindtap="chooseActivity"><text class="bg-grow">{{item.name}}</text><text class="bg-muted">{{item.status}} ›</text></view><view wx:if="{{!activityLoading && !activityError && !activityItems.length}}" class="bg-empty">还没有可选择的活动，请先在首页创建活动。</view></boardgame-sheet>
