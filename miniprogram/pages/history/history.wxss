page {
  background: #ffffff;
}

.history-page {
  min-height: 100vh;
  background: #ffffff;
  color: #101828;
}

.history-navbar {
  background: transparent;
}

.history-navbar-row {
  height: 44px;
  display: flex;
  align-items: center;
  padding-left: 20px;
  box-sizing: border-box;
}

.history-navbar-title {
  font-size: 24px;
  font-weight: 600;
  line-height: 29px;
  color: #0a0a0a;
  transform: translateY(-1px);
}

.history-content {
  padding: 24rpx 24rpx 160rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999999;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-card {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.member-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.member-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.member-rank {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  color: #999999;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.member-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  overflow: hidden;
  background: #f0f0f0;
  border-radius: 4rpx;
}

.progress-fill {
  height: 100%;
  background: #ff9500;
  border-radius: 4rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 24rpx;
}

.empty-icon {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  color: #999999;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
