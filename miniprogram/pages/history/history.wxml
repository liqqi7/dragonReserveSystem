<view class="history-page">
  <view class="history-navbar" style="padding-top: {{statusBarHeight}}px">
    <view class="history-navbar-row">
      <text class="history-navbar-title">排行榜</text>
    </view>
  </view>

  <view class="history-content">
    <view class="section-header">
      <text class="section-title">鸽子榜</text>
      <text class="section-subtitle">共 {{endedActivityCount}} 场已结束活动</text>
    </view>

    <view wx:if="{{isLoadingPigeonStats}}" class="empty-state">
      <text class="empty-icon">加载中</text>
      <text class="empty-text">排行榜加载中</text>
    </view>

    <view wx:elif="{{pigeonStats.length === 0}}" class="empty-state">
      <text class="empty-icon">暂无数据</text>
      <text class="empty-text">暂无鸽子数据</text>
    </view>

    <view wx:else class="member-list">
      <view wx:for="{{pigeonStats}}" wx:key="userId" class="member-card">
        <view class="member-header">
          <view class="member-name">{{item.name}}</view>
          <view class="member-rank">#{{index + 1}}</view>
        </view>
        <view class="member-stats">
          <view class="stat-item">
            <text class="stat-label">活动报名数</text>
            <text class="stat-value">{{item.signupCount}} 场</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">活动签到数</text>
            <text class="stat-value">{{item.checkinCount}} 场</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">鸽子率</text>
            <text class="stat-value">{{item.pigeonRate}}%</text>
          </view>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.pigeonRate}}%"></view>
        </view>
      </view>
    </view>
  </view>
</view>
