<view id="qa-profile-page" class="profile-page">
  <image class="profile-rainbow" src="/images/profile-rainbow.svg" mode="scaleToFill" aria-hidden="true" />

  <view class="profile-navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="profile-navbar-inner"></view>
  </view>

  <scroll-view class="profile-scroll" type="custom" scroll-y show-scrollbar="{{false}}">
    <view class="container" style="padding-bottom: calc(131.69231rpx + {{bottomSafeAreaRpx}}rpx);">
      <view class="profile-hero">
        <view class="profile-avatar-frame">
          <image
            wx:if="{{hasUser}}"
            class="profile-avatar-image"
            src="{{user.avatarUrl || '/images/default-avatar.svg'}}"
            mode="aspectFill"
            binderror="onProfileAvatarError"
          />
          <image
            wx:else
            class="profile-avatar-image profile-avatar-image--guest"
            src="/images/profile-guest-avatar.png"
            mode="aspectFill"
          />
        </view>
        <text class="profile-nickname">{{hasUser ? (user.nickname || '未命名成员') : '神秘用户'}}</text>
        <text class="profile-subtitle">{{hasUser ? user.subtitle : '非常神秘的一位伙伴'}}</text>
      </view>

      <view class="profile-menu">
        <view wx:if="{{hasUser && isMemoryAdmin}}" class="profile-menu-row" bindtap="openMemoryReview" aria-role="button" aria-label="内容审核">
          <image class="profile-menu-icon" src="/images/memory-shield.svg" mode="aspectFit" />
          <view class="profile-review-label">
            <text class="profile-menu-label">内容审核</text>
            <text wx:if="{{memoryPendingCount}}" class="profile-review-count">{{memoryPendingCount > 99 ? '99+' : memoryPendingCount}}</text>
          </view>
          <image class="profile-menu-chevron" src="/images/profile-icon-chevron-right.svg" mode="aspectFit" />
        </view>
        <view wx:if="{{!hasUser}}" class="profile-menu-row" bindtap="startRegister" aria-role="button" aria-label="登录账户">
          <image class="profile-menu-icon" src="/images/profile-icon-login.svg" mode="aspectFit" />
          <text class="profile-menu-label">登录账户</text>
          <image class="profile-menu-chevron" src="/images/profile-icon-chevron-right.svg" mode="aspectFit" />
        </view>

        <view
          wx:if="{{hasUser}}"
          class="profile-menu-row"
          bindtap="onProfileEditTap"
          aria-role="button"
          aria-label="修改资料"
        >
          <image class="profile-menu-icon" src="/images/profile-icon-pencil.svg" mode="aspectFit" />
          <text class="profile-menu-label">修改资料</text>
          <image class="profile-menu-chevron" src="/images/profile-icon-chevron-right.svg" mode="aspectFit" />
        </view>

        <view wx:if="{{hasUser}}" class="profile-menu-row profile-menu-row--access" bindtap="onAccessTap" aria-role="button" aria-label="{{isGuest ? '获取权限' : '删除权限'}}">
          <image class="profile-menu-icon" src="{{isGuest ? '/images/profile-icon-lock-keyhole.svg' : '/images/profile-icon-lock-keyhole-danger.svg'}}" mode="aspectFit" />
          <text class="profile-menu-label {{isGuest ? '' : 'profile-menu-label--danger'}}">{{isGuest ? '获取权限' : '删除权限'}}</text>
          <image class="profile-menu-chevron" src="/images/profile-icon-chevron-right.svg" mode="aspectFit" />
        </view>

        <view wx:if="{{hasUser}}" class="profile-menu-row" bindtap="logout" aria-role="button" aria-label="退出登录">
          <image class="profile-menu-icon" src="/images/profile-icon-logout.svg" mode="aspectFit" />
          <text class="profile-menu-label profile-menu-label--logout">退出登录</text>
          <image class="profile-menu-chevron" src="/images/profile-icon-chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 添加权限：输入交互弹窗 -->
  <view
    wx:if="{{showPermissionModal}}"
    id="qa-add-permission-dialog-overlay"
    class="permission-dialog-overlay"
    bindtap="closePermissionModal"
    catchtouchmove="stopTouchMove"
  >
    <view
      id="qa-add-permission-dialog"
      class="permission-dialog"
      catchtap="stopTap"
      aria-role="dialog"
      aria-label="添加权限"
    >
      <view class="permission-dialog-copy">
        <view class="permission-dialog-title-row">
          <image class="permission-dialog-icon" src="/images/dialog-prompt.svg" mode="aspectFit" aria-hidden="true" />
          <text class="permission-dialog-title">添加权限</text>
          <view class="permission-dialog-title-spacer" aria-hidden="true" />
        </view>
        <text class="permission-dialog-message">请输入邀请码，验证通过后即可查看相关活动数据。</text>
      </view>
      <input
        id="qa-add-permission-input"
        class="permission-dialog-input"
        password
        maxlength="64"
        placeholder="请输入邀请码"
        placeholder-style="color:#9CA3AF;font-weight:400;"
        value="{{permissionInput}}"
        bindinput="onPermissionInput"
        confirm-type="done"
        bindconfirm="submitPermission"
        cursor-spacing="24"
      />
      <view class="permission-dialog-actions">
        <view class="permission-dialog-button permission-dialog-button--cancel" bindtap="closePermissionModal" aria-role="button">取消</view>
        <view class="permission-dialog-button permission-dialog-button--primary {{permissionSubmitting ? 'permission-dialog-button--disabled' : ''}}" bindtap="submitPermission" aria-role="button">确认提交</view>
      </view>
    </view>
  </view>

  <!-- 删除权限：红色报警弹窗 -->
  <view
    wx:if="{{showDeletePermissionModal}}"
    id="qa-delete-permission-dialog-overlay"
    class="permission-dialog-overlay"
    bindtap="closeDeletePermissionModal"
    catchtouchmove="stopTouchMove"
  >
    <view
      id="qa-delete-permission-dialog"
      class="permission-dialog"
      catchtap="stopTap"
      aria-role="dialog"
      aria-label="确认删除权限"
    >
      <view class="permission-dialog-copy">
        <view class="permission-dialog-title-row">
          <image class="permission-dialog-icon" src="/images/dialog-danger.svg" mode="aspectFit" aria-hidden="true" />
          <text class="permission-dialog-title">确认删除权限</text>
          <view class="permission-dialog-title-spacer" aria-hidden="true" />
        </view>
        <text class="permission-dialog-message">删除后账号将恢复为游客，无法查看相关活动数据。</text>
      </view>
      <view class="permission-dialog-actions">
        <view class="permission-dialog-button permission-dialog-button--cancel" bindtap="closeDeletePermissionModal" aria-role="button">再想想</view>
        <view class="permission-dialog-button permission-dialog-button--danger {{permissionRemoving ? 'permission-dialog-button--disabled' : ''}}" bindtap="confirmDeletePermission" aria-role="button">确认删除</view>
      </view>
    </view>
  </view>

  <profile-editor-dialog
    visible="{{showEditModal}}"
    avatar-url="{{editAvatarUrl}}"
    nickname="{{editNickname}}"
    bind:close="closeEditModal"
    bind:chooseavatar="onChooseAvatar"
    bind:nicknameinput="onInputNickname"
    bind:save="saveProfile"
  />
</view>

<create-access-dialog id="create-access-dialog" />

<create-access-dialog id="session-expired-dialog" />
<create-access-dialog id="logout-dialog" bind:confirm="confirmLogout" />
