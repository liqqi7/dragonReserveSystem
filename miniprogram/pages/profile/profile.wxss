@import "../../styles/centeredDialog.wxss";

page {
  background-color: #f8fafc;
}

.profile-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f8fafc;
}

.profile-rainbow {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 280.76923rpx;
  pointer-events: none;
}

.profile-navbar {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding-right: 38.46154rpx;
  padding-left: 38.46154rpx;
  background: transparent;
}

.profile-navbar-inner {
  display: flex;
  height: 84.61538rpx;
  align-items: center;
}


.profile-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.container {
  box-sizing: border-box;
  min-height: 100%;
  padding: 0 38.46154rpx;
  background: transparent;
}

.profile-hero {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 0;
}

.profile-avatar-frame {
  position: relative;
  display: block;
  width: 153.84615rpx;
  height: 153.84615rpx;
  flex: none;
  overflow: hidden;
  border: 1.92308rpx solid #ffffff;
  border-radius: 50%;
  background: #545454;
  box-sizing: border-box;
}

.profile-avatar-image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar-image--guest {
  top: -7.69231rpx;
  left: -19.23077rpx;
  width: 192.30769rpx;
  height: 192.30769rpx;
}

.profile-nickname {
  display: block;
  max-width: 100%;
  margin-top: 30.76923rpx;
  color: #1a1a1a;
  font-size: 61.53846rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.profile-subtitle {
  display: block;
  max-width: 100%;
  margin-top: 23.07692rpx;
  color: #6b7280;
  font-size: 23.07692rpx;
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
}

.profile-menu {
  display: flex;
  flex-direction: column;
  margin-top: 46.15385rpx;
  padding: 0 30.76923rpx;
  overflow: hidden;
  border-radius: 30.76923rpx;
  background: #ffffff;
}

.profile-menu-row {
  display: flex;
  box-sizing: border-box;
  min-height: 113.46154rpx;
  align-items: center;
  flex-direction: row;
  gap: 23.07692rpx;
  padding: 38.46154rpx 0;
}

.profile-menu-icon {
  display: block;
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
}

.profile-menu-label {
  display: block;
  min-width: 0;
  flex: 1;
  color: #111827;
  font-size: 30.76923rpx;
  font-weight: 400;
  line-height: 1.4;
}

.profile-menu-label--danger,
.profile-menu-label--logout {
  color: #e5484d;
}

.profile-menu-chevron {
  display: block;
  width: 26.92308rpx;
  height: 26.92308rpx;
  flex: none;
}

.profile-menu-row--access {
  border-top: 1.92308rpx solid #ececec;
}

/* 居中权限弹窗：R16 容器、R12/44px 控件、S3 浮层 */
.permission-dialog-overlay {
  z-index: 1100;
}

.permission-dialog-input {
  box-sizing: border-box;
  width: 100%;
  height: 84.61538rpx;
  padding: 0 23.07692rpx;
  border: 0;
  border-radius: 23.07692rpx;
  color: #111827;
  background: #f5f5f5;
  font-size: 26.92308rpx;
  line-height: 84.61538rpx;
  font-weight: 400;
}

.permission-dialog-button--danger {
  color: #ffffff;
}

.permission-dialog-button--disabled {
  opacity: 0.45;
}
.profile-review-label {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: row;
  align-items: center;
  gap: 23.07692rpx;
}

.profile-review-label .profile-menu-label {
  flex: none;
}

.profile-review-count {
  box-sizing: border-box;
  min-width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
  padding: 0 7.69231rpx;
  border-radius: 17.30769rpx;
  background: #e5484d;
  color: #ffffff;
  font-size: 19.23077rpx;
  font-weight: 600;
  line-height: 34.61538rpx;
  text-align: center;
}
