page {
  background-color: #f8fafc;
}

.profile-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f8fafc;
}

.profile-rainbow {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 280.76923rpx;
  pointer-events: none;
}

.profile-navbar {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding-right: 38.46154rpx;
  padding-left: 38.46154rpx;
  background: transparent;
}

.profile-navbar-inner {
  display: flex;
  height: 84.61538rpx;
  align-items: center;
}

.profile-navbar-title {
  color: #0a0a0a;
  font-size: 46.15385rpx;
  font-weight: 600;
  line-height: 65.38462rpx;
}

.profile-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.container {
  box-sizing: border-box;
  min-height: 100%;
  padding: 0 38.46154rpx;
  background: transparent;
}

.profile-hero {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 0;
}

.profile-avatar-frame {
  position: relative;
  display: block;
  width: 153.84615rpx;
  height: 153.84615rpx;
  flex: none;
  overflow: hidden;
  border: 1.92308rpx solid #ffffff;
  border-radius: 50%;
  background: #545454;
  box-sizing: border-box;
}

.profile-avatar-image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar-image--guest {
  top: -7.69231rpx;
  left: -19.23077rpx;
  width: 192.30769rpx;
  height: 192.30769rpx;
}

.profile-nickname {
  display: block;
  max-width: 100%;
  margin-top: 30.76923rpx;
  color: #1a1a1a;
  font-size: 61.53846rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.profile-subtitle {
  display: block;
  max-width: 100%;
  margin-top: 23.07692rpx;
  color: #6b7280;
  font-size: 23.07692rpx;
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
}

.profile-menu {
  display: flex;
  flex-direction: column;
  margin-top: 46.15385rpx;
  padding: 0 30.76923rpx;
  overflow: hidden;
  border-radius: 30.76923rpx;
  background: #ffffff;
}

.profile-menu-row {
  display: flex;
  box-sizing: border-box;
  min-height: 113.46154rpx;
  align-items: center;
  flex-direction: row;
  gap: 23.07692rpx;
  padding: 38.46154rpx 0;
}

.profile-menu-icon {
  display: block;
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
}

.profile-menu-label {
  display: block;
  min-width: 0;
  flex: 1;
  color: #111827;
  font-size: 30.76923rpx;
  font-weight: 400;
  line-height: 1.4;
}

.profile-menu-label--danger,
.profile-menu-label--logout {
  color: #e5484d;
}

.profile-menu-chevron {
  display: block;
  width: 26.92308rpx;
  height: 26.92308rpx;
  flex: none;
}

.profile-menu-row--access {
  border-top: 1.92308rpx solid #ececec;
}

/* 居中权限弹窗：R16 容器、R12/44px 控件、S3 浮层 */
.permission-dialog-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: rgba(23, 24, 20, 0.4);
  animation-name: permissionDialogMaskIn;
  animation-duration: 160ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

.permission-dialog {
  display: flex;
  box-sizing: border-box;
  width: 576.92308rpx;
  max-width: calc(100% - 64rpx);
  padding: 38.46154rpx;
  align-items: center;
  flex-direction: column;
  gap: 30.76923rpx;
  border-radius: 30.76923rpx;
  background: #ffffff;
  box-shadow: 0 19.23077rpx 53.84615rpx rgba(0, 0, 0, 0.15);
  animation-name: permissionDialogIn;
  animation-duration: 200ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-fill-mode: both;
}

.permission-dialog-copy {
  display: flex;
  width: 100%;
  align-items: center;
  flex-direction: column;
  gap: 23.07692rpx;
}

.permission-dialog-title-row {
  display: flex;
  max-width: 100%;
  align-items: center;
  justify-content: center;
  gap: 15.38462rpx;
}

.permission-dialog-icon {
  display: block;
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
}

.permission-dialog-title {
  display: block;
  color: #111827;
  font-size: 30.76923rpx;
  line-height: 42.30769rpx;
  font-weight: 700;
  text-align: center;
}

.permission-dialog-message {
  display: block;
  width: 100%;
  color: #4b5563;
  font-size: 26.92308rpx;
  line-height: 40.38462rpx;
  font-weight: 400;
  text-align: center;
}

.permission-dialog-input {
  box-sizing: border-box;
  width: 100%;
  height: 84.61538rpx;
  padding: 0 23.07692rpx;
  border: 0;
  border-radius: 23.07692rpx;
  color: #111827;
  background: #f5f5f5;
  font-size: 26.92308rpx;
  line-height: 84.61538rpx;
  font-weight: 400;
}

.permission-dialog-input-placeholder {
  color: #9ca3af;
  font-weight: 400;
}

.permission-dialog-actions {
  display: flex;
  width: 100%;
  gap: 23.07692rpx;
}

.permission-dialog-button {
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  height: 84.61538rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 23.07692rpx;
  font-size: 26.92308rpx;
  line-height: 38.46154rpx;
  font-weight: 600;
}

.permission-dialog-button--cancel {
  color: #4b5563;
  background: #f5f5f5;
}

.permission-dialog-button--primary {
  color: #ffffff;
  background: #ff9800;
}

.permission-dialog-button--danger {
  color: #ffffff;
  background: #ef4444;
}

.permission-dialog-button--disabled {
  opacity: 0.45;
}

@keyframes permissionDialogMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes permissionDialogIn {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* yl4tW：我的页面修改个人资料居中弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 76.923%;
  max-height: 80vh;
  padding: 38.46154rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 30.76923rpx;
  box-shadow: 0 19.23077rpx 53.84615rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  gap: 30.76923rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15.38462rpx;
  color: #111827;
  font-size: 30.76923rpx;
  font-weight: 700;
  line-height: 34.61538rpx;
}

.modal-title-icon {
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex-shrink: 0;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 23.07692rpx;
  min-height: 0;
}

.force-profile-hint {
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.5;
}

.modal-body .form-item {
  margin: 0;
}

.modal-body .avatar-form-row {
  height: 76.92308rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.modal-body .label {
  color: #4b5563;
  font-size: 26.92308rpx;
  line-height: 38.46154rpx;
  margin-bottom: 11.53846rpx;
}

.modal-body .avatar-form-row .label {
  margin-bottom: 0;
}

.avatar-edit-wrap,
.avatar-edit-btn,
.avatar-edit-img,
.avatar-edit-placeholder {
  width: 76.92308rpx;
  height: 76.92308rpx;
  border-radius: 38.46154rpx;
}

.avatar-edit-wrap {
  flex-shrink: 0;
}

button.avatar-edit-btn {
  width: 76.92308rpx;
  min-width: 76.92308rpx;
  height: 76.92308rpx;
  min-height: 76.92308rpx;
  padding: 0;
  margin: 0;
  border: 1.92308rpx solid #e5e7eb;
  background: #f9fafb;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
}

.avatar-edit-btn::after {
  border: none;
}

.avatar-edit-img {
  display: block;
}

.avatar-edit-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.avatar-edit-placeholder image {
  display: block;
  width: 30.76923rpx;
  height: 30.76923rpx;
}

.modal-body .input {
  width: 100%;
  height: 84.61538rpx;
  padding: 0 23.07692rpx;
  border: none;
  border-radius: 23.07692rpx;
  background: #f5f5f5;
  color: #111827;
  font-size: 26.92308rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 23.07692rpx;
}

.modal-footer .btn {
  flex: 1;
  width: 0;
  height: 84.61538rpx;
  padding: 0;
  margin: 0;
  border-radius: 23.07692rpx;
  font-size: 26.92308rpx;
  font-weight: 600;
  line-height: 84.61538rpx;
  box-sizing: border-box;
}

.modal-footer .btn.default {
  background: #f5f5f5;
  color: #4b5563;
}

.modal-footer .btn.primary {
  background: #ff9800;
  color: #ffffff;
}

.modal-footer .btn::after {
  border: none;
}

.modal-footer .btn-disabled {
  opacity: 0.45;
}
