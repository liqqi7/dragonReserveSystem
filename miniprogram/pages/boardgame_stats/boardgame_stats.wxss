@import "../../styles/boardgames.wxss";
.stats-toolbar{display:flex;gap:16rpx;margin:24rpx 0}.stats-cards{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:24rpx 0}.stats-card{background:white;border:1rpx solid #E5E7EB;border-radius:30.77rpx;padding:28rpx}.stats-number{font-size:38.46rpx;color:#FF9800;font-weight:700}.stats-value{font-size:38.46rpx;font-weight:700;flex-shrink:0;margin-left:20rpx}.stats-row-label{flex:1;min-width:0;font-size:30.77rpx;line-height:1.5;overflow-wrap:break-word}.stats-rank{margin-right:16rpx;color:#9CA3AF;font-weight:700}.stats-bar{height:8rpx;background:#F5F5F5;border-radius:4rpx;overflow:hidden;margin:20rpx 0}.stats-bar view{height:100%;background:#FF9800}.stats-result-row{display:flex;justify-content:space-between;padding:16rpx 0;border-top:1rpx solid #E5E7EB;font-size:26.92rpx}

.stats-period { margin-bottom:23.08rpx; }.stats-metric-head .bg-heading { margin:23.08rpx 0; }.stats-support { background:#F5F5F5; border-radius:30.77rpx; padding:23.08rpx; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:15.38rpx 30.77rpx; font-size:19.23rpx; line-height:26.92rpx; color:#4B5563; }.stats-support .bg-row { flex-wrap:wrap; }.stats-trend { margin-top:23.08rpx; }.stats-trend-row { display:flex; align-items:center; gap:15.38rpx; padding:7.69rpx 0; }.stats-trend-row>text:first-child { width:153.85rpx; flex:none; }.stats-trend-track { flex:1; height:15.38rpx; border-radius:7.69rpx; background:#F5F5F5; overflow:hidden; }.stats-trend-track view { height:100%; background:#FF9800; border-radius:7.69rpx; }.stats-shortcuts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:23.08rpx; margin-top:46.15rpx; }.stats-shortcuts>view { border:1rpx solid #E5E7EB; border-radius:30.77rpx; padding:23.08rpx; font-weight:700; }.stats-shortcuts text { display:block; font-size:19.23rpx; line-height:26.92rpx; color:#4B5563; margin-top:7.69rpx; font-weight:400; }.stats-menu { background:#FFFFFF; padding:0 23.08rpx; border-radius:30.77rpx; }
