<view class="bg-page"><view class="bg-row bg-between"><view class="bg-title">桌游统计</view><text class="bg-link" bindtap="history">查看对局</text></view><view class="stats-toolbar"><button class="bg-chip {{query.scope !== 'mine' ? 'active' : ''}}" data-value="all" bindtap="scope">全体</button><button class="bg-chip {{query.scope === 'mine' ? 'active' : ''}}" data-value="mine" bindtap="scope">我的</button><button class="bg-chip" bindtap="openFilters">时间与筛选</button></view><view class="bg-subtitle stats-period">{{periodLabel}}</view><view class="bg-row bg-between stats-metric-head"><view class="bg-heading">{{metrics[metricIndex].label}}</view><text class="bg-link" bindtap="openMetrics">切换统计 ›</text></view><view class="bg-input" bindtap="openGames">{{gameName}} ⌄</view>

<view wx:if="{{query.game_id && showRules}}"><view class="bg-label">比赛方式</view><picker range="{{modes}}" range-key="label" value="{{modeIndex}}" bindchange="mode"><view class="bg-input">{{modes[modeIndex].label}} ⌄</view></picker><view class="bg-label">分数比较范围</view><picker range="{{groups}}" range-key="label" value="{{groupIndex}}" bindchange="group"><view class="bg-input">{{groups[groupIndex].label}} ⌄</view></picker></view>
<picker wx:if="{{metric === 'scoresheets' && sheetGroups.length}}" range="{{sheetGroups}}" range-key="label" value="{{sheetGroupIndex}}" bindchange="sheetGroup"><view class="bg-input">{{sheetGroups[sheetGroupIndex].label}} ⌄</view></picker><picker wx:if="{{metric === 'breakdowns'}}" range="{{distributions}}" value="{{distributionIndex}}" bindchange="distribution"><view class="bg-input">{{distributions[distributionIndex]}} ⌄</view></picker><picker wx:if="{{metric === 'trends'}}" range="{{buckets}}" value="{{bucketIndex}}" bindchange="bucket"><view class="bg-input">{{buckets[bucketIndex]}} ⌄</view></picker>
<view wx:if="{{filterNote}}" class="bg-subtitle">{{filterNote}}</view><view wx:if="{{error}}" class="bg-error" bindtap="load">{{error}} · 点击重试</view><view wx:if="{{needsGame}}" class="bg-empty">先选一款游戏查看{{metrics[metricIndex].label}}<text class="bg-link" bindtap="openGames">选择游戏</text></view><view class="stats-cards"><view wx:for="{{metric === 'overview' ? primaryCards : cards}}" wx:key="key" class="stats-card"><view class="stats-number">{{item.value}}</view><view class="bg-muted">{{item.label}}</view></view></view>
<block wx:if="{{metric === 'overview' && !loading}}"><view class="stats-support"><view wx:for="{{secondaryCards}}" wx:key="key" class="bg-row bg-between"><text>{{item.label}}</text><text>{{item.value}}</text></view></view><view class="bg-heading"><text>游玩趋势</text><text class="bg-link" data-metric="trends" bindtap="chooseMetric">查看全部 ›</text></view><view wx:if="{{query.period === 'all'}}" class="bg-muted">最近 12 个月</view><view class="stats-trend"><view wx:for="{{overviewTrend}}" wx:key="displayKey" class="stats-trend-row" data-drill="{{item.drilldown}}" bindtap="drill"><text class="bg-small">{{item.label}}</text><view class="stats-trend-track"><view style="width:{{item.bar}}%"/></view><text class="bg-small">{{item.value}}</text></view><view wx:if="{{!overviewTrend.length}}" class="bg-empty">这个范围还没有游玩记录</view></view><view class="bg-heading"><text>开的最多</text><text class="bg-link" data-metric="most-played" bindtap="chooseMetric">完整榜单 ›</text></view><view wx:for="{{overviewTop}}" wx:key="displayKey" class="bg-list-item bg-row" data-drill="{{item.drilldown}}" bindtap="drill"><text class="stats-rank">{{index + 1}}</text><image wx:if="{{item.cover}}" class="bg-thumb" data-path="overviewTop[{{index}}].cover" binderror="imageError" src="{{item.cover}}" mode="aspectFit"/><view class="bg-grow">{{item.label}}</view><text class="stats-value">{{item.value}} 局</text></view><view wx:if="{{overviewExtraError}}" class="bg-error" bindtap="load">{{overviewExtraError}}</view><view class="stats-shortcuts"><view data-metric="wanted" bindtap="chooseMetric">最想开<text>查看提名排行 ›</text></view><view data-metric="players" bindtap="chooseMetric">玩家排名<text>按游戏查看胜率 ›</text></view><view data-metric="partners" bindtap="chooseMetric">常玩伙伴<text>一起玩的记录 ›</text></view><view bindtap="openMetrics">更多数据<text>分项、角色与连胜 ›</text></view></view></block>
<view wx:for="{{resultGroups}}" wx:key="key" class="bg-card"><view class="bg-row bg-between"><text>{{item.label}}</text><text class="stats-number">{{item.value}}</text></view><view class="bg-subtitle">{{item.caption}}</view></view><view wx:for="{{detailSections}}" wx:key="key" class="bg-card" data-drill="{{item.drilldown}}" bindtap="drill"><view class="bg-row bg-between"><text>{{item.label}}</text><text class="stats-number">{{item.value}}</text></view><view wx:if="{{item.caption}}" class="bg-subtitle">{{item.caption}}</view></view>
<view wx:for="{{rows}}" wx:key="displayKey" class="bg-card" data-row="{{item}}" data-drill="{{item.drilldown}}" bindtap="drill"><view class="bg-row bg-between"><image wx:if="{{item.cover}}" class="bg-thumb" data-path="rows[{{index}}].cover" binderror="imageError" src="{{item.cover}}" mode="aspectFit"/><image wx:elif="{{item.avatar}}" class="bg-avatar" data-path="rows[{{index}}].avatar" binderror="imageError" src="{{item.avatar}}" mode="aspectFill"/><view class="stats-row-label"><text wx:if="{{item.rank}}" class="stats-rank">{{item.rank}}</text>{{item.label}}</view><text class="stats-value">{{item.value}}</text></view><view class="stats-bar"><view style="width:{{item.bar}}%"/></view><view class="bg-subtitle">{{item.caption}}</view><view wx:for="{{item.resultRows}}" wx:for-item="result" wx:key="key" class="stats-result-row" data-drill="{{result.drilldown}}" catchtap="drill"><text>{{result.label}}</text><text>{{result.value}} · {{result.samples}} 项</text></view></view>
<view wx:if="{{loading}}" class="bg-empty">正在统计…</view><view wx:if="{{!loading && !error && !needsGame && !cards.length && !rows.length && !detailSections.length}}" class="bg-empty">{{emptyReason || '这个范围还没有统计样本'}}</view><view class="bg-subtitle" wx:if="{{metric === 'score-curve'}}">柱长按分数绝对值绘制；负分保留负号，空白没有柱形。</view></view>
<boardgame-filters visible="{{filterOpen}}" query="{{query}}" bindclose="closeFilters" bindapply="applyFilters"/>
<boardgame-sheet visible="{{gameOpen}}" title="选择统计游戏" kind="info" bindclose="closeGames"><view class="bg-row"><input class="bg-input bg-grow" value="{{gameSearch}}" bindinput="gameInput" placeholder="搜索桌游"/><button class="bg-button small" bindtap="searchGame">搜索</button></view><view class="bg-list-item" data-id="0" bindtap="chooseGame">全部游戏</view><view wx:for="{{games}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="chooseGame">{{item.name}}</view><button wx:if="{{gameCursor}}" class="bg-button secondary full" data-more="{{true}}" bindtap="searchGame">更多游戏</button></boardgame-sheet>
<boardgame-sheet visible="{{sourcesOpen}}" title="提名来自这些活动" kind="info" bindclose="closeSources"><view wx:for="{{sources}}" wx:key="key" class="bg-list-item" data-id="{{item.activity.id}}" bindtap="activity"><view>{{item.activity.name}}</view><text class="bg-muted">{{item.nomination_count}} 人次 · {{item.activity.start_time}}</text></view><button wx:if="{{sourcesCursor}}" class="bg-button secondary full" bindtap="moreSources">更多活动</button></boardgame-sheet>

<boardgame-sheet title="选择统计内容" visible="{{metricOpen}}" size="high" bindclose="closeMetrics"><view wx:for="{{metricGroups}}" wx:key="label"><view class="bg-heading">{{item.label}}</view><view class="stats-menu"><view wx:for="{{item.items}}" wx:for-item="metricItem" wx:key="value" class="bg-list-item bg-row bg-between" data-metric="{{metricItem.value}}" bindtap="chooseMetric"><text>{{metricItem.label}}</text><text class="bg-link">{{metric === metricItem.value ? '✓' : '›'}}</text></view></view></view></boardgame-sheet>
