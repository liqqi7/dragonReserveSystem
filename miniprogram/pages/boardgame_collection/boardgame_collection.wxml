<import src="../../templates/boardgame-name.wxml"/>
<view class="bg-page"><view class="bg-title">我的收藏</view><view class="bg-subtitle">偏好、价格、标签与保存的筛选仅自己可见</view><view class="collection-tabs"><button class="bg-chip {{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="tab">覆盖率</button><button class="bg-chip {{tab === 'costs' ? 'active' : ''}}" data-tab="costs" bindtap="tab">实物成本</button><button class="bg-chip {{tab === 'tags' ? 'active' : ''}}" data-tab="tags" bindtap="tab">标签</button><button class="bg-chip {{tab === 'filters' ? 'active' : ''}}" data-tab="filters" bindtap="tab">保存的筛选</button></view><view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{notice}}" class="bg-notice">{{notice}}</view>
<block wx:if="{{tab === 'overview' && summary}}"><view class="collection-hero"><view class="collection-percent">{{coverage}}</view><view>馆藏游玩覆盖率</view><view class="bg-subtitle">{{summary.owned_played_game_count}} / {{summary.owned_game_count}} 款已玩</view></view><view class="bg-grid-2"><view class="bg-card" data-key="owned_unplayed" bindtap="drill"><view class="collection-number">{{summary.owned_unplayed_game_count}}</view><text>拥有未玩 ›</text></view><view class="bg-card" data-key="played_not_owned" bindtap="drill"><view class="collection-number">{{summary.played_not_owned_game_count}}</view><text>玩过未拥有 ›</text></view></view><view class="bg-card"><view>已有对局记录 {{summary.exact_logged_game_count}} 款</view><view class="bg-subtitle">另有 {{summary.previous_marked_game_count}} 款标记了以前玩过。既往概数仅帮助确认覆盖率，不进入月份和胜率统计。</view></view></block>
<block wx:if="{{tab === 'costs'}}"><view class="bg-label">用哪个时间范围内的对局计算</view><picker range="{{periods}}" range-key="label" value="{{periodIndex}}" bindchange="period"><view class="bg-input">{{periods[periodIndex].label}} ⌄</view></picker><view wx:if="{{periodIndex > 0 && periodIndex < 4}}" class="bg-grid-2"><input class="bg-input" type="number" value="{{form.year}}" data-key="year" bindinput="field" placeholder="年份"/><input wx:if="{{periodIndex < 3}}" class="bg-input" type="number" value="{{periodIndex === 1 ? form.month : form.quarter}}" data-key="{{periodIndex === 1 ? 'month' : 'quarter'}}" bindinput="field" placeholder="月份 / 季度"/></view><view wx:if="{{periodIndex === 4}}" class="bg-grid-2"><view class="bg-input" data-key="from" bindtap="openDate">{{form.from || '开始日期'}} ›</view><view class="bg-input" data-key="to" bindtap="openDate">{{form.to || '结束日期'}} ›</view></view><button class="bg-button secondary full" bindtap="applyPeriod">应用时间范围</button><view class="bg-subtitle">分子为整盒购入价，分母为所选时间内明确使用该盒的对局。多币种分别计算，时长缺失不补 0。</view><view wx:for="{{currencies}}" wx:key="currency" class="bg-card"><view class="bg-heading">{{item.currency}} · 共 {{item.total}}</view><view>每局 {{item.cost}} · 每小时 {{item.costHour}}</view><view class="bg-subtitle">人均 {{item.costPerson}} · {{item.play_count}} 局 · {{item.priced_copy_count}} 盒有价格</view></view><view class="bg-muted">{{unpriced || 0}} 盒尚未填写价格</view><view wx:for="{{costs}}" wx:key="id" class="bg-card"><view class="bg-row bg-between"><view class="bg-grow" data-id="{{item.game_id}}" bindtap="game"><template is="boardgame-name" data="{{game:item, titleClass:'bg-link'}}"/></view><text>{{item.purchase_currency || ''}} {{item.price}}</text></view><view class="bg-subtitle">{{item.edition_name || '未标版本'}} · {{item.purchased_on || '购入日期未填'}}{{item.archived_at ? ' · 已归档' : ''}}</view><view data-query="{{item.drilldown.query}}" bindtap="drill"><view>每局 {{item.cost}} · 每小时 {{item.costHour}}</view><view class="bg-subtitle">人均 {{item.costPerson}} · {{item.play_count}} 局，{{item.missing_duration_count}} 局缺时长 ›</view></view></view><view wx:if="{{!loading && !costs.length}}" class="bg-empty">还没有实物记录，请在游戏详情中添加自己的一盒。</view></block>
<block wx:if="{{tab === 'tags'}}"><view class="bg-heading"><text>{{contextName ? '标记：' + contextName : '我的标签'}}</text><text class="bg-link" bindtap="openTag">新建标签</text></view><view class="bg-row bg-between"><text class="bg-muted">显示停用标签</text><switch checked="{{includeArchived}}" bindchange="showArchived" color="#FF9800"/></view><view wx:for="{{tags}}" wx:key="id" class="bg-card"><view class="bg-row bg-between"><text class="{{item.selected ? 'bg-link' : ''}}" data-id="{{item.id}}" bindtap="selectTag">{{item.selected ? '✓ ' : ''}}{{item.name}}{{!item.is_active ? '（停用）' : ''}}</text><view class="bg-row"><text class="bg-link" data-id="{{item.id}}" bindtap="openTag">改名</text><text class="bg-link" data-id="{{item.id}}" bindtap="archiveTag">{{item.is_active ? '停用' : '恢复'}}</text></view></view></view><button wx:if="{{tagCursor}}" class="bg-button secondary full" data-kind="tags" bindtap="more">更多标签</button><view wx:if="{{!tags.length && !loading}}" class="bg-empty">建立一个标签，方便下次查找。</view><button wx:if="{{linkId}}" class="bg-button full" bindtap="saveLinks" disabled="{{saving}}">保存选中的标签</button></block>
<block wx:if="{{tab === 'filters'}}"><view wx:for="{{filters}}" wx:key="id" class="bg-card" data-id="{{item.id}}" bindtap="applySaved"><view>{{item.name}}　›</view><text class="bg-muted">{{item.target === 'games' ? '筛选游戏' : item.target === 'plays' ? '筛选对局' : '查看统计'}}</text><view class="bg-row collection-filter-actions"><text class="bg-link" data-id="{{item.id}}" data-action="rename" catchtap="openSavedEdit">改名</text><text class="bg-link" data-id="{{item.id}}" data-action="delete" catchtap="openSavedEdit">移除</text></view></view><button wx:if="{{savedCursor}}" class="bg-button secondary full" data-kind="filters" bindtap="more">更多筛选</button><view wx:if="{{!filters.length && !loading}}" class="bg-empty">在游戏库或对局历史中保存常用筛选。</view></block><view wx:if="{{loading}}" class="bg-empty">正在加载…</view></view>
<boardgame-sheet title="{{tagId ? '修改标签名称' : '新建标签'}}" kind="form" visible="{{tagOpen}}" bindclose="closeTag" busy="{{saving}}" size="low"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-label">名称</view><input class="bg-input" value="{{tagName}}" bindinput="tagInput" maxlength="64" placeholder="例如：适合聚会"/><button slot="footer" class="bg-button full" bindtap="saveTag" disabled="{{saving}}">保存标签</button></boardgame-sheet>

<date-time-picker-sheet visible="{{dateOpen}}" mode="date" title="{{dateField === 'from' ? '开始日期' : '结束日期'}}" value="{{dateValue}}" bindclose="closeDate" bindconfirm="dateConfirm"/>

<boardgame-sheet visible="{{savedEditOpen}}" title="{{savedEditAction === 'delete' ? '移除保存的筛选' : '修改筛选名称'}}" kind="form" size="low" busy="{{saving}}" bindclose="closeSavedEdit"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view wx:if="{{savedEditAction === 'delete'}}" class="bg-card">移除“{{savedEdit.name}}”后，对局与馆藏仍会保留。</view><block wx:else><view class="bg-label">筛选名称</view><input class="bg-input" value="{{savedEditName}}" bindinput="savedEditName" maxlength="64"/></block><button slot="footer" class="bg-button full" bindtap="saveSavedEdit" disabled="{{saving}}">{{savedEditAction === 'delete' ? '确认移除' : '保存名称'}}</button></boardgame-sheet>
