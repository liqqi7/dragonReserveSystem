<view class="bg-page"><view class="bg-row bg-between"><view class="bg-title">对局历史</view><button class="bg-button small" bindtap="record">记一局</button></view><view class="bg-subtitle">打开一局查看成绩、扩展和计分表</view><view class="history-toolbar"><button class="bg-chip {{query.scope === 'all' ? 'active' : ''}}" data-scope="all" bindtap="scope">全体</button><button class="bg-chip {{query.scope === 'mine' ? 'active' : ''}}" data-scope="mine" bindtap="scope">我的</button><button class="bg-chip" bindtap="openFilters">筛选</button><button class="bg-chip" bindtap="stats">统计</button><button class="bg-chip" bindtap="openSave">保存筛选</button></view><view class="history-toolbar"><button class="bg-chip {{!query.status ? 'active' : ''}}" data-value="" bindtap="status">全部记录</button><button class="bg-chip {{query.status === 'draft' ? 'active' : ''}}" data-value="draft" bindtap="status">我的待完成</button><button class="bg-chip" bindtap="offline">待同步</button></view><view wx:if="{{error}}" class="bg-error" bindtap="load">{{error}} · 点击重试</view><view wx:for="{{items}}" wx:key="id" class="bg-card" data-id="{{item.id}}" bindtap="open"><view class="bg-row bg-between"><text class="history-name">{{item.game_snapshot.name}}</text><text class="bg-badge">{{item.statusLabel}}</text></view><view class="bg-subtitle">{{item.played_on || '日期未填'}} · {{item.durationLabel}}</view><view class="history-players">{{item.playersLabel || '待选择玩家'}}</view><view class="bg-row bg-between"><text class="bg-muted">{{item.activity_snapshot.name || item.location_label || '自由组局'}}</text><text class="bg-muted">{{item.resultLabel}}　›</text></view></view><view wx:if="{{loading}}" class="bg-empty">正在加载…</view><view wx:if="{{!loading && !items.length && !error}}" class="bg-empty">这个范围还没有对局<view class="bg-link" bindtap="record">记录第一局</view></view></view>
<boardgame-filters visible="{{filterOpen}}" query="{{query}}" bindclose="closeFilters" bindapply="applyFilters"/>
<boardgame-sheet title="保存筛选" visible="{{saveOpen}}" kind="form" bindclose="closeSave" busy="{{saving}}" size="low"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-label">筛选名称</view><input class="bg-input" value="{{filterName}}" bindinput="name" placeholder="例如：今年我的四人局"/><button slot="footer" class="bg-button full" bindtap="saveFilter" disabled="{{saving}}">保存</button></boardgame-sheet>
