<import src="../../templates/boardgame-name.wxml"/>
<view class="bg-page">
  <view class="bg-row bg-between library-head"><view><view class="bg-title">桌游库</view></view><button class="bg-button small" bindtap="openAdd">＋ 录入</button></view>
  <view class="bg-toolbar"><input class="bg-input bg-grow" value="{{query}}" placeholder="搜索名称或别名" bindinput="onSearch" confirm-type="search" bindconfirm="reload"/><button class="bg-chip" bindtap="openFilter">筛选<text wx:if="{{filterCount}}" class="library-filter-count">{{filterCount}}</text></button></view>
  <view wx:if="{{savedNotice}}" class="bg-notice">{{savedNotice}}</view><view class="library-links"><view data-page="boardgame_history" bindtap="navigate"><text class="library-nav-title">对局历史</text><text class="bg-muted">每一局都记得</text></view><view data-page="boardgame_stats" bindtap="navigate"><text class="library-nav-title">数据统计</text><text class="bg-muted">想玩与常玩</text></view><view bindtap="openMore"><text class="library-nav-title">我的与管理</text><text class="bg-muted">收藏、导入、反馈</text></view></view>
  <view wx:if="{{pending}}" class="bg-notice" data-page="boardgame_offline" bindtap="navigate">{{pending}} 条记录等待同步或核对　›</view>
  <scroll-view scroll-x class="bg-scroll"><view class="bg-chips"><button wx:for="{{quickOptions}}" wx:key="key" class="bg-chip {{quick === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onQuick">{{item.label}}</button></view></scroll-view>
  <view wx:if="{{error}}" class="bg-error" bindtap="reload">{{error}} · 点击重试</view>
  <view class="bg-grid"><view wx:for="{{games}}" wx:key="id" class="bg-game" data-id="{{item.id}}" bindtap="openGame"><image wx:if="{{item.cover_url}}" class="bg-cover" data-path="games[{{index}}].cover_url" binderror="imageError" src="{{item.cover_url}}" mode="aspectFill"/><view wx:else class="bg-cover placeholder">暂无封面</view><view class="bg-game-body"><template is="boardgame-name" data="{{game:item, titleClass:'bg-game-name', compact:true}}"/><text class="bg-game-meta">{{item.game_type === 'expansion' ? '扩展' : '本体'}} · {{item.min_players || '?'}}–{{item.max_players || '?'}} 人 · {{item.max_playtime_minutes || '?'}} 分钟</text><text class="bg-game-meta">{{item.inventory_summary.total}} 盒馆藏 · {{item.inventory_summary.activity_available}} 盒可带出</text><view class="library-tags"><text wx:for="{{item.my_tags}}" wx:for-item="tag" wx:key="id" class="bg-badge">{{tag.name}}</text></view></view></view></view>
  <view wx:if="{{!games.length && !loading && !error}}" class="bg-empty">暂时没有符合条件的游戏<view class="bg-link" bindtap="openAdd">录入一款游戏</view></view>
  <view wx:if="{{loading}}" class="bg-empty">正在加载…</view><button wx:if="{{hasMore && !loading}}" class="bg-button secondary full" bindtap="onReachBottom">加载更多</button>
</view>
<boardgame-sheet visible="{{filterOpen}}" title="筛选游戏" kind="form" bindclose="closeFilter" busy="{{saving}}" size="high">
  <view class="bg-label">人数</view><input class="bg-input" type="number" value="{{filterForm.player_count}}" data-key="player_count" bindinput="filterField" placeholder="例如 4"/>
  <view class="bg-label">最长游戏时间（分钟）</view><input class="bg-input" type="number" value="{{filterForm.max_minutes}}" data-key="max_minutes" bindinput="filterField" placeholder="不限"/>
  <view class="bg-label">复杂度（1–5）</view><view class="bg-row"><input class="bg-input library-inline-field" type="digit" value="{{filterForm.min_complexity}}" data-key="min_complexity" bindinput="filterField" placeholder="最低"/><text>—</text><input class="bg-input library-inline-field" type="digit" value="{{filterForm.max_complexity}}" data-key="max_complexity" bindinput="filterField" placeholder="最高"/></view>
  <view class="bg-label">我的评分至少（1–10）</view><input class="bg-input" type="digit" value="{{filterForm.min_rating}}" data-key="min_rating" bindinput="filterField" placeholder="不限"/>
  <view class="bg-label">我的游戏标签</view><view wx:for="{{filterTags}}" wx:key="id" class="bg-row bg-between bg-list-item"><text>{{item.name}}</text><view class="bg-row"><button class="bg-chip {{item.included ? 'active' : ''}}" data-id="{{item.id}}" bindtap="tagFilter">包含</button><button class="bg-chip {{item.excluded ? 'active' : ''}}" data-id="{{item.id}}" data-exclude="{{true}}" bindtap="tagFilter">排除</button></view></view><view slot="footer" class="bg-row" style="width:100%"><button class="bg-button secondary" bindtap="resetFilter">重置</button><button class="bg-button bg-grow" bindtap="applyFilter">查看游戏</button></view>
</boardgame-sheet>


<boardgame-sheet visible="{{savedOpen}}" title="保存游戏筛选" kind="form" bindclose="closeSaveFilter" busy="{{saving}}" size="low"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-label">筛选名称</view><input class="bg-input" value="{{savedName}}" bindinput="savedName" maxlength="64" placeholder="例如：周末四人游戏"/><button slot="footer" class="bg-button full" bindtap="saveFilter">保存筛选</button></boardgame-sheet>

<boardgame-sheet visible="{{moreOpen}}" title="我的与管理" size="standard" bindclose="closeMore"><view class="library-menu"><view class="bg-list-item" data-page="boardgame_collection" bindtap="navigate">我的收藏与标签　›</view><view class="bg-list-item" bindtap="openSaveFilter">保存当前游戏筛选　›</view><view class="bg-list-item" data-page="boardgame_imports" bindtap="navigate">导入历史数据　›</view><view class="bg-list-item" data-page="boardgame_offline" bindtap="navigate">待同步记录　›</view><view class="bg-list-item" data-page="boardgame_manage" bindtap="navigate">对局反馈与资料管理　›</view></view></boardgame-sheet>
