@import "../../styles/boardgames.wxss";
.library-head { padding-bottom:30.77rpx; }.library-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:15.38rpx; margin:30.77rpx 0; padding:23.08rpx 0; border-top:1rpx solid #E5E7EB; border-bottom:1rpx solid #E5E7EB; }.library-links>view { min-width:0; }.library-nav-title { display:block; font-weight:700; margin-bottom:7.69rpx; }.library-links .bg-muted { font-size:19.23rpx; line-height:26.92rpx; }.library-inline-field { flex:1; width:0; }.library-filter-count { font-size:19.23rpx; background:#FF9800; color:#FFFFFF; border-radius:15.38rpx; padding:0 7.69rpx; margin-left:7.69rpx; }.library-tags { display:flex; flex-wrap:wrap; gap:7.69rpx; margin-top:7.69rpx; max-height:76.92rpx; overflow:hidden; }.library-tags .bg-badge { max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; box-sizing:border-box; }.library-tags:empty { margin:0; }.library-menu { background:#FFFFFF; border-radius:30.77rpx; padding:0 23.08rpx; }
