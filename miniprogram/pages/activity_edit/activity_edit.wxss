page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #111827;
}

.edit-page {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #FFFFFF;
}

.navbar {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 44.23rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}

.navbar-back,
.navbar-placeholder {
  width: 69.23rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-back-icon {
  width: 34.62rpx;
  height: 34.62rpx;
  display: block;
}

.navbar-title {
  color: #111827;
  font-size: 30.77rpx;
  line-height: 46.15rpx;
  font-weight: 700;
}

.edit-scroll {
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.edit-content {
  width: 100%;
  padding: 53.85rpx 53.85rpx 38.46rpx;
  box-sizing: border-box;
}

.cover-card {
  position: relative;
  width: 100%;
  height: 576.92rpx;
  overflow: hidden;
  border-radius: 30.77rpx;
  background: #F3F4F6;
}

.cover-image,
.cover-placeholder,
.cover-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-image {
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 26.92rpx;
}

.cover-shade {
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.03) 40%, rgba(0, 0, 0, 0.28) 100%);
}

.cover-change {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  min-width: 184.62rpx;
  height: 73.08rpx;
  padding: 0 38.46rpx;
  border-radius: 36.54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.9);
  color: #111827;
  font-size: 26.92rpx;
  line-height: 38.46rpx;
}

.field-block {
  margin-top: 38.46rpx;
}

.field-label {
  display: block;
  margin: 0 0 15.38rpx;
  color: #111827;
  font-size: 26.92rpx;
  line-height: 46.15rpx;
  font-weight: 700;
}

.field-card,
.time-field {
  position: relative;
  width: 100%;
  min-height: 107.69rpx;
  border-radius: 30.77rpx;
  background: #F3F4F6;
  box-sizing: border-box;
}

.field-card-input {
  padding: 0 38.46rpx;
  display: flex;
  align-items: center;
}

.field-input {
  width: 100%;
  height: 53.85rpx;
  color: #111827;
  font-size: 26.92rpx;
  line-height: 37.69rpx;
}

.field-card-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38.46rpx;
}

.field-value {
  min-width: 0;
  color: #111827;
  font-size: 26.92rpx;
  line-height: 37.69rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.field-value-placeholder {
  color: #9CA3AF;
}

.field-value-filled {
  color: #111827;
}

.field-chevron {
  flex-shrink: 0;
  width: 26.92rpx;
  height: 26.92rpx;
  margin-left: 15.38rpx;
  opacity: 0.65;
}

.field-help {
  display: block;
  margin: 7.69rpx 0 0;
  color: #9CA3AF;
  font-size: 19.23rpx;
  line-height: 26.92rpx;
}

.remark-card {
  height: 184.62rpx;
  padding: 30.77rpx 38.46rpx;
}

.remark-input {
  width: 100%;
  height: 100rpx;
  color: #111827;
  font-size: 26.92rpx;
  line-height: 37.69rpx;
}

.remark-count {
  display: block;
  text-align: right;
  color: #CBD5E1;
  font-size: 19.23rpx;
  line-height: 26.92rpx;
}

.time-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 23.08rpx;
}

.time-field {
  flex: 1;
  min-width: 0;
  height: 107.69rpx;
  padding: 0 30.77rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26.92rpx;
  color: #111827;
  white-space: nowrap;
}

.time-value {
  color: #111827;
}

.time-placeholder {
  color: #9CA3AF;
  font-weight: 400;
}

.time-separator {
  flex-shrink: 0;
  color: #9CA3AF;
  font-size: 23.08rpx;
  font-weight: 500;
}

.quota-card {
  height: 107.69rpx;
  padding: 0 23.08rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-button {
  width: 69.23rpx;
  height: 69.23rpx;
  border-radius: 19.23rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-button image {
  width: 30.77rpx;
  height: 30.77rpx;
  display: block;
}

.quota-value {
  min-width: 107.69rpx;
  color: #111827;
  text-align: center;
  font-size: 30.77rpx;
  line-height: 30.77rpx;
  font-weight: 600;
}

.subitems-card {
  margin-top: 38.46rpx;
  padding: 0;
}

.bottom-spacer {
  height: 38.46rpx;
}

.loading-card {
  height: 576.92rpx;
  border-radius: 30.77rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 26.92rpx;
}

.footer {
  position: absolute;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 11.54rpx 38.46rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  background: #FFFFFF;
  border-top: 1rpx solid #F3F4F6;
  box-shadow: 0 -8rpx 24rpx rgba(17, 24, 39, 0.04);
}

.footer-actions {
  width: 100%;
  height: 84.62rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 15.38rpx;
}

.footer-button {
  height: 84.62rpx;
  border-radius: 23.08rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 26.92rpx;
  line-height: 38.46rpx;
  font-weight: 600;
}

.footer-cancel {
  width: 215.38rpx;
  flex-shrink: 0;
  border: 1.92rpx solid #FF9800;
  color: #FF9800;
  background: #FFFFFF;
}

.footer-save {
  width: 442.31rpx;
  flex: 1;
  color: #FFFFFF;
  background: #FF9800;
}

.footer-save-disabled {
  background: #CBD5E1;
}


.edit-picker-host {
  position: absolute;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.edit-picker-host--visible {
  pointer-events: auto;
}
