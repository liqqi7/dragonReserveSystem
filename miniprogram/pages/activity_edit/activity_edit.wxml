<view class="edit-page" style="padding-top:{{statusBarHeight}}px;">
  <view class="navbar">
    <view class="navbar-back" bindtap="onBack" aria-role="button" aria-label="返回活动详情">
      <image class="navbar-back-icon" src="/images/activity-create-chevron-left.svg" mode="aspectFit" />
    </view>
    <text class="navbar-title">编辑活动</text>
    <view class="navbar-placeholder"></view>
  </view>

  <scroll-view class="edit-scroll" style="margin-bottom:{{footerSafeAreaRpx + 97.16}}rpx;" scroll-y="{{true}}" show-scrollbar="{{false}}">
    <view class="edit-content">
      <view wx:if="{{loading}}" class="loading-card"><text>活动信息加载中…</text></view>
      <block wx:else>
        <view class="cover-card" bindtap="openCoverPicker" aria-role="button" aria-label="更换活动封面">
          <image wx:if="{{selectedCover.imageUrl || selectedCover.thumbnailUrl}}" class="cover-image" src="{{selectedCover.imageUrl || selectedCover.thumbnailUrl}}" mode="aspectFill" fade-in="{{true}}" />
          <view wx:else class="cover-placeholder"><text>请选择活动封面</text></view>
          <view class="cover-shade"></view>
          <view class="cover-change"><text>更换封面</text></view>
        </view>

        <view class="field-block">
          <text class="field-label">活动名称</text>
          <view class="field-card field-card-input">
            <input class="field-input" value="{{form.name}}" maxlength="10" placeholder="请输入活动名称" placeholder-style="color:#9CA3AF;font-size:26.92rpx;font-weight:400;" bindinput="onNameInput" />
          </view>
        </view>

        <view class="field-block">
          <text class="field-label">活动地点</text>
          <view class="field-card field-card-location" bindtap="chooseLocation" aria-role="button" aria-label="选择活动地点">
            <text class="field-value {{form.locationName ? 'field-value-filled' : 'field-value-placeholder'}}">{{form.locationName || '请选择活动地点'}}</text>
            <image class="field-chevron" src="/images/icon-chevron-right.svg" mode="aspectFit" />
          </view>
          <text wx:if="{{locationDisabled}}" class="field-help">已有用户完成签到，不可修改活动地点</text>
        </view>

        <view class="field-block">
          <text class="field-label">活动备注</text>
          <view class="field-card remark-card">
            <textarea class="remark-input" value="{{form.remark}}" maxlength="200" placeholder="填写活动指引、游玩要求或相关提醒…" placeholder-style="color:#9CA3AF;font-size:26.92rpx;font-weight:400;line-height:37.69rpx;" cursor-spacing="120" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" bindinput="onRemarkInput" />
            <text class="remark-count">{{form.remark.length || 0}} / 200</text>
          </view>
        </view>

        <view class="field-block">
          <text class="field-label">活动时间</text>
          <view class="time-card">
            <view class="time-field" bindtap="openPicker" data-target="start" aria-role="button" aria-label="选择开始时间">
              <text wx:if="{{form.startDate && form.startTime}}" class="time-value">{{startLabel}}</text>
              <text wx:else class="time-placeholder">开始时间</text>
            </view>
            <text class="time-separator">至</text>
            <view class="time-field" bindtap="openPicker" data-target="end" aria-role="button" aria-label="选择结束时间">
              <text wx:if="{{form.endDate && form.endTime}}" class="time-value">{{endLabel}}</text>
              <text wx:else class="time-placeholder">结束时间</text>
            </view>
          </view>
        </view>

        <view class="field-block">
          <text class="field-label">名额上限</text>
          <view class="field-card quota-card">
            <view class="step-button" bindtap="stepQuota" data-delta="-1" aria-role="button" aria-label="减少名额"><image src="/images/icon-minus.svg" mode="aspectFit" /></view>
            <text class="quota-value">{{form.maxParticipants}} 人</text>
            <view class="step-button" bindtap="stepQuota" data-delta="1" aria-role="button" aria-label="增加名额"><image src="/images/icon-plus.svg" mode="aspectFit" /></view>
          </view>
        </view>

        <view class="subitems-card">
          <activity-subitems-editor enabled="{{form.subItemsEnabled}}" items="{{form.subItems}}" max-participants="{{form.maxParticipants}}" locked="{{participantCount > 0}}" bindchange="onSubItemsChange" />
        </view>
      </block>
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <view class="footer" style="padding-bottom:{{footerSafeAreaRpx}}rpx;">
    <view class="footer-actions">
      <view class="footer-button footer-cancel" bindtap="cancelActivity" aria-role="button"><text>取消活动</text></view>
      <view class="footer-button footer-save {{saving ? 'footer-save-disabled' : ''}}" bindtap="saveActivity" aria-role="button" aria-disabled="{{saving}}"><text>{{saving ? '保存中…' : '保存修改'}}</text></view>
    </view>
  </view>

  <activity-cover-picker-sheet embedded="{{true}}" visible="{{coverPickerVisible}}" value="{{form.activityCoverId}}" bindclose="closeCoverPicker" bindconfirm="confirmCoverPicker" />
  <view class="edit-picker-host {{pickerVisible ? 'edit-picker-host--visible' : ''}}">
    <date-time-picker-sheet id="qaEditDateTimePicker" embedded="{{true}}" visible="{{pickerVisible}}" mode="datetime" title="{{pickerTarget === 'start' ? '选择开始时间' : '选择结束时间'}}" value="{{pickerValue}}" minute-step="{{1}}" bindclose="closePicker" bindconfirm="confirmPicker" />
  </view>
</view>
