@import "../../styles/memory.wxss";
@import "../../styles/formControls.wxss";
@import "../../styles/memorySheet.wxss";
page {
  background: #000000;
}
.memory-viewer {
  position: relative;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #000000;
  color: #ffffff;
}
.memory-viewer button {
  min-width: 0;
  padding: 0;
  margin: 0;
}
.viewer-nav {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 3;
  justify-content: space-between;
  color: #ffffff;
}
.memory-viewer .viewer-share {
  width: 42.30769rpx;
  height: 42.30769rpx;
  padding: 0;
  margin: 0;
  background: transparent;
}
.viewer-share image {
  display: block;
  width: 42.30769rpx;
  height: 42.30769rpx;
}
.viewer-stage {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
}
.viewer-slide {
  position: relative;
  overflow: hidden;
  height: 100%;
  width: 100%;
}
.viewer-image,
.viewer-photo-stage,
.viewer-video {
  display: block;
  width: 100%;
  height: 100%;
}
.viewer-photo-stage {
  position: relative;
}
.viewer-photo {
  position: absolute;
  display: block;
}
.viewer-missing {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 28rpx;
}
.viewer-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}
.viewer-info,
.viewer-footer {
  pointer-events: auto;
}
.viewer-bottom-shade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 700rpx;
  background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.7));
  pointer-events: none;
}
.viewer-bottom-shade--seeking {
  height: 688.46154rpx;
}
.viewer-info {
  position: absolute;
  left: 30.76923rpx;
  right: 30.76923rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 15.38462rpx;
  box-sizing: border-box;
  opacity: 1;
  transition: opacity 200ms ease-out;
}
.viewer-copy {
  display: flex;
  flex-direction: column;
  gap: 15.38462rpx;
}
.viewer-info--seeking {
  opacity: 0;
  pointer-events: none;
}
.viewer-tools {
  display: flex;
  align-items: center;
  gap: 34.61538rpx;
  flex: none;
}
.viewer-author {
  display: flex;
  align-items: center;
  gap: 19.23077rpx;
  font-size: 28.84615rpx;
  font-weight: 600;
  line-height: 1.2;
}
.viewer-author > image {
  width: 69.23077rpx;
  height: 69.23077rpx;
  flex: none;
  border-radius: 50%;
}
.viewer-author > text {
  flex: 1;
  min-width: 0;
}
.viewer-caption {
  display: block;
  font-size: 26.92308rpx;
  line-height: 1.2;
  word-break: break-all;
}
.viewer-meta {
  display: flex;
  align-items: center;
  gap: 7.69231rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.2;
  min-height: 30.76923rpx;
}
.viewer-meta--activity {
  gap: 11.53846rpx;
}
.viewer-meta image {
  width: 26.92308rpx;
  height: 26.92308rpx;
  flex: none;
}
.viewer-meta text {
  min-width: 0;
  flex: 1;
}
.viewer-meta .viewer-activity-name {
  flex: 0 1 auto;
}
.viewer-meta .viewer-activity-divider,
.viewer-meta .viewer-activity-time {
  flex: none;
}
.viewer-footer {
  position: absolute;
  left: 38.46154rpx;
  right: 38.46154rpx;
  z-index: 2;
}
.viewer-footer .memory-actions {
  gap: 23.07692rpx;
}
.viewer-footer button {
  height: 92.30769rpx;
  border-radius: 23.07692rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28.84615rpx;
  font-weight: 600;
  line-height: 1.2;
}
.viewer-reject {
  background: rgba(255, 255, 255, 0.1);
  border: 1.92308rpx solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  box-sizing: border-box;
}
.viewer-approve {
  background: #ff9800;
  color: #ffffff;
}
.viewer-error {
  position: absolute;
  top: 180rpx;
  left: 0;
  right: 0;
  z-index: 4;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #fca5a5;
  font-size: 26rpx;
}
.viewer-error button {
  font-size: 24rpx;
}
.review-publish {
  padding: 23.08rpx 0;
  flex: none;
}
.review-thumbnails {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.memory-viewer .review-thumb {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  border: 4rpx solid transparent;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #374151;
}
.memory-viewer .review-thumb--selected {
  border-color: #ff9800;
}
.review-thumb image {
  width: 100%;
  height: 100%;
  display: block;
}
.review-thumb text {
  position: absolute;
  bottom: 0;
  right: 0;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.6);
  font-size: 20rpx;
  padding: 0 8rpx;
  line-height: 28rpx;
}
.review-thumb--disabled {
  opacity: 0.4;
}
.review-status {
  color: #667085;
  font-size: 22rpx;
  margin-top: 8rpx;
}
.review-ack {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
}
.review-ack text {
  flex: 1;
  min-width: 0;
}
.viewer-top-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 230.76923rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
  pointer-events: none;
}
.memory-state {
  position: absolute;
  top: 45%;
  left: 0;
  right: 0;
}
.viewer-video-hitbox {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.memory-viewer .viewer-play-button {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 123.07692rpx;
  height: 123.07692rpx;
  margin: 0;
  padding: 34.61538rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
}
.viewer-play-button image {
  display: block;
  width: 53.84615rpx;
  height: 53.84615rpx;
}
.memory-viewer .viewer-enter-fullscreen {
  width: 42.30769rpx;
  height: 42.30769rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  flex: none;
}
.viewer-enter-fullscreen image {
  display: block;
  width: 42.30769rpx;
  height: 42.30769rpx;
}
.memory-viewer .viewer-restore {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  width: 211.53846rpx;
  height: 61.53846rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11.53846rpx;
  padding: 0;
  margin: 0;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 30.76923rpx;
  color: #ffffff;
  font-size: 23.07692rpx;
}
.viewer-restore image {
  width: 30.76923rpx;
  height: 30.76923rpx;
}
.viewer-progress {
  position: relative;
  height: 5.76923rpx;
  width: 100%;
}
.viewer-progress--seeking {
  height: 7.69231rpx;
}
.viewer-progress--seeking .viewer-progress-track,
.viewer-progress--seeking .viewer-progress-played {
  height: 7.69231rpx;
}
.viewer-progress-track,
.viewer-progress-played {
  position: absolute;
  top: 50%;
  left: 0;
  height: 5.76923rpx;
  border-radius: 3rpx;
  transform: translateY(-50%);
}
.viewer-progress-track {
  width: 100%;
  background: rgba(255, 255, 255, 0.2);
}
.viewer-progress-played {
  background: #ffffff;
}
.viewer-progress-thumb {
  position: absolute;
  top: 50%;
  width: 30.76923rpx;
  height: 30.76923rpx;
  border-radius: 50%;
  background: #ffffff;
  transform: translate(-50%, -50%);
}
.viewer-progress-bubble {
  position: absolute;
  bottom: 30.76923rpx;
  transform: translateX(-50%);
  width: 123.07692rpx;
  height: 46.15385rpx;
  line-height: 46.15385rpx;
  border-radius: 7.69231rpx;
  background: rgba(0, 0, 0, 0.7);
  text-align: center;
  font-size: 21.15385rpx;
}
.viewer-progress-input {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 61.53846rpx;
  transform: translateY(-50%);
  margin: 0;
  opacity: 0;
}
.viewer-seek-region,
.viewer-portrait-timeline {
  position: absolute;
  left: 0;
  right: 0;
  height: 157.69231rpx;
}
.viewer-seek-region {
  pointer-events: auto;
}
.viewer-portrait-timeline {
  pointer-events: none;
  z-index: 2;
}
.portrait-seek,
.portrait-progress {
  opacity: 0;
  transition: opacity 200ms ease-out;
}
.portrait-seek--active,
.portrait-progress--visible {
  opacity: 1;
}
.portrait-seek {
  display: flex;
  flex-direction: column;
  gap: 69.23077rpx;
}
.portrait-seek-time {
  height: 61.53846rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19.23077rpx;
  font-size: 42.30769rpx;
  font-weight: 500;
}
.portrait-seek-divider,
.portrait-seek-duration {
  color: rgba(255, 255, 255, 0.5);
}
.portrait-seek-divider {
  font-size: 28.84615rpx;
}
.portrait-seek-track {
  position: relative;
  height: 19.23077rpx;
  margin: 3.84615rpx 30.76923rpx;
  border-radius: 9.61538rpx;
  background: rgba(255, 255, 255, 0.2);
}
.portrait-seek-played {
  height: 100%;
  border-radius: 9.61538rpx;
  background: rgba(255, 255, 255, 0.85);
}
.portrait-seek-thumb {
  position: absolute;
  top: 50%;
  width: 13.46154rpx;
  height: 26.92308rpx;
  border-radius: 7.69231rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}
.portrait-progress {
  position: absolute;
  left: 30.76923rpx;
  right: 30.76923rpx;
  bottom: 3.84615rpx;
  height: 7.69231rpx;
}
.portrait-progress-track,
.portrait-progress-played {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  border-radius: 3.84615rpx;
}
.portrait-progress-track {
  width: 100%;
  background: rgba(255, 255, 255, 0.2);
}
.portrait-progress-played {
  background: #ffffff;
}
.portrait-progress-thumb {
  position: absolute;
  top: 50%;
  width: 15.38462rpx;
  height: 15.38462rpx;
  border-radius: 50%;
  background: #ffffff;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 15.38462rpx rgba(0, 0, 0, 0.4);
}
/* Fullscreen controls keep their prototype pixel sizes after the viewport rotates. */
.viewer-fullscreen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  color: #ffffff;
}
.viewer-fullscreen .viewer-play-button {
  width: 64px;
  height: 64px;
  padding: 18px;
}
.viewer-fullscreen .viewer-play-button image {
  width: 28px;
  height: 28px;
}
.fullscreen-head {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 80px;
  padding: 6px 14px;
  box-sizing: border-box;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
  pointer-events: none;
}
.memory-viewer button.fullscreen-back,
.memory-viewer button.fullscreen-exit {
  width: 44px;
  height: 44px;
  box-sizing: border-box;
  padding: 10px;
  margin: 0;
  background: transparent;
  pointer-events: auto;
  flex: none;
}
.fullscreen-back image {
  display: block;
  width: 24px;
  height: 24px;
}
.fullscreen-exit image {
  display: block;
  width: 22px;
  height: 22px;
}
.fullscreen-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70px;
  padding: 26px 12px 6px 24px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12px;
  background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.7));
}
.fullscreen-time {
  width: 40px;
  font-size: 11px;
  flex: none;
  color: rgba(255, 255, 255, 0.8);
}
.fullscreen-time--duration {
  width: 28px;
}
.fullscreen-controls .viewer-progress-input {
  height: 32px;
}
.fullscreen-controls .viewer-progress {
  width: auto;
  min-width: 0;
  flex: 1;
  height: 32px;
}
.fullscreen-controls .viewer-progress-track,
.fullscreen-controls .viewer-progress-played {
  height: 3px;
}
.fullscreen-controls .viewer-progress-thumb {
  width: 12px;
  height: 12px;
}
.fullscreen-controls .viewer-progress-bubble {
  width: 64px;
  height: 24px;
  line-height: 24px;
  bottom: 32px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 12px;
}
.viewer-seek-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 220px;
  height: 64px;
  border-radius: 32px;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 16px;
  font-weight: 600;
}
.viewer-seek-indicator image {
  width: 24px;
  height: 24px;
}
