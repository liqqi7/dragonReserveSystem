<import src="memory-controls.wxml" />
<wxs module="photoPointer" src="./photo-pointer.wxs" />
<wxs module="videoPointer" src="./video-pointer.wxs" />
<view class="memory-viewer" prop="{{videoPointerState}}" change:prop="{{videoPointer.sync}}" bindtouchmove="{{videoPointer.move}}" bindtouchend="{{videoPointer.end}}" bindtouchcancel="{{videoPointer.cancel}}">
  <image wx:if="{{entrySource}}" class="viewer-image" src="{{entrySource}}" mode="aspectFit" />
  <vertical-drag-gesture-handler wx:if="{{memory}}" native-view="swiper" tag="memory-pager" simultaneous-handlers="{{['memory-scale']}}" worklet:should-accept-gesture="pagerAllowed" worklet:should-response-on-move="pagerAllowed">
  <swiper class="viewer-stage" vertical current="{{index}}" scroll-with-animation="{{false}}" circular="{{false}}" cache-extent="1" disable-touch="{{zoomed || fullScreen || seeking || selectionOpen || busy}}" bindchange="change">
    <swiper-item wx:for="{{viewerMedia}}" wx:for-index="mediaIndex" wx:key="id" class="viewer-slide">
      <scale-gesture-handler wx:if="{{item.kind === 'image' && mediaIndex === index && item.url}}" tag="memory-scale" simultaneous-handlers="{{['memory-pan', 'memory-pager']}}" worklet:ongesture="photoScale">
        <pan-gesture-handler tag="memory-pan" simultaneous-handlers="{{['memory-scale']}}" worklet:should-accept-gesture="photoPanAllowed" worklet:ongesture="photoPan">
          <double-tap-gesture-handler worklet:ongesture="photoDoubleTap">
            <view class="viewer-photo-stage" data-id="{{item.id}}" bindtap="photoTap" data-generation="{{videoGeneration}}" prop="{{photoPointerState}}" change:prop="{{photoPointer.sync}}" bindtouchstart="{{photoPointer.touch}}" bindtouchmove="{{photoPointer.touch}}" bindtouchend="{{photoPointer.touch}}" bindtouchcancel="{{photoPointer.touch}}"><image id="memory-photo" data-id="{{item.id}}" data-generation="{{videoGeneration}}" data-source="{{imageSources[item.url] || imageSources[item.thumbnail_url] || ''}}" class="viewer-photo" src="{{imageSources[item.url] || imageSources[item.thumbnail_url] || ''}}" style="width:{{photoWidth}}px;height:{{photoHeight}}px;left:{{photoLeft}}px;top:{{photoTop}}px;{{photoPointerState ? 'transform:scale(' + photoPointerState.scale + ');transition:transform ' + (photoPointerState.animated ? 240 : 0) + 'ms ease-out;' : ''}}" mode="aspectFit" bindload="photoLoaded" binderror="mediaError" /></view>
          </double-tap-gesture-handler>
        </pan-gesture-handler>
      </scale-gesture-handler>
      <video wx:elif="{{item.kind === 'video' && mediaIndex === index && videoMounted && videoSource}}" id="memory-video" data-id="{{item.id}}" data-generation="{{videoGeneration}}" class="viewer-video" src="{{videoSource}}" poster="{{videoPoster}}" initial-time="{{videoInitialTime}}" controls="{{false}}" muted="{{muted}}" autoplay="{{visible && !pausedByUser && !selectionOpen}}" loop="{{true}}" object-fit="{{item.width > item.height || fullScreen ? 'contain' : 'cover'}}" show-fullscreen-btn="{{false}}" show-center-play-btn="{{false}}" enable-progress-gesture="{{false}}" vslide-gesture-in-fullscreen="{{false}}" bindloadedmetadata="videoMetadata" bindwaiting="videoWaiting" bindplay="videoPlay" bindpause="videoPause" bindtimeupdate="videoTime" bindfullscreenchange="fullScreenChanged" binderror="mediaError">
        <template wx:if="{{fullScreen}}" is="memory-fullscreen" data="{{playing,pausedByUser,seeking,seekGesture,seekForward,currentLabel,durationLabel,controlsVisible,progress,bubbleLeft,mediaLoading,loadingIndicatorVisible,error}}" />
      </video>
      <image wx:elif="{{item.thumbnail_url || item.kind === 'image' && item.url}}" class="viewer-image" src="{{imageSources[item.url] || imageSources[item.thumbnail_url] || ''}}" data-id="{{item.id}}" data-generation="{{videoGeneration}}" data-source="{{imageSources[item.url] || ''}}" bindload="photoLoaded" mode="aspectFit" />
      <view wx:else class="viewer-missing"><text>{{memory.statusLabel || '素材不可用'}}</text></view>
      <view wx:if="{{item.kind === 'video' && mediaIndex === index && item.url && !fullScreen}}" class="viewer-video-hitbox" bindtap="videoTap">
        <button size="mini" wx:if="{{!playing && pausedByUser && !videoLoading && !mediaLoading && !error && !seeking && !selectionOpen}}" class="viewer-play-button" catchtap="playVideo" aria-label="播放"><image src="/images/memory-play-large.svg" /></button>
      </view>
      <template wx:if="{{!zoomed && !fullScreen}}" is="memory-portrait-bottom" data="{{memory:viewerInfo[mediaIndex],current:item,admin,bottom,active:mediaIndex === index,busy,seeking:mediaIndex === index && seeking,progressVisible:mediaIndex === index && progressVisible,progress:mediaIndex === index ? progress : 0,seekCurrentLabel,seekDurationLabel}}" />
    </swiper-item>
  </swiper>
  </vertical-drag-gesture-handler>
  <view wx:if="{{!fullScreen}}" class="viewer-top-shade" />
  <view wx:if="{{!fullScreen}}" class="memory-nav viewer-nav" style="top:{{top}}px;"><view class="memory-back" bindtap="back" aria-role="button" aria-label="返回"><image src="/images/memory-back-light.svg" /></view></view>
  <template wx:if="{{loadingIndicatorVisible && !error && !fullScreen}}" is="memory-loading" />
  <view wx:if="{{reviewComplete}}" class="memory-state"><text>待审核内容已处理完</text></view>
  <view wx:if="{{error}}" class="viewer-error"><text>{{error}}</text><button bindtap="load">刷新</button></view>
  <button wx:elif="{{revalidationFailed}}" class="viewer-error" bindtap="revalidate">重试</button>
  <button size="mini" wx:if="{{zoomed && !fullScreen}}" class="viewer-restore" style="bottom:{{bottom + 46.15385}}rpx;" bindtap="restorePhoto" aria-label="还原适宽"><image src="/images/memory-restore.svg" /><text>还原适宽</text></button>
  <view wx:if="{{selectionOpen && admin && memory.status === 'pending'}}" class="memory-sheet-overlay" bindtap="closeSelection">
    <view class="memory-sheet" catchtap="stopTap" style="padding-bottom:{{reviewBottomInsetRpx}}rpx;">
      <view class="memory-sheet-drag" bindtap="closeSelection"><view /></view><view class="memory-sheet-title"><text>选择发布内容 · {{selected.length}} 项</text></view>
      <scroll-view type="list" scroll-y class="memory-sheet-body">
        <text wx:if="{{memory.location_name}}" class="review-status">位置 · {{memory.location_name}}</text>
        <view class="review-thumbnails"><button size="mini" wx:for="{{memory.media}}" wx:key="id" class="review-thumb {{item.selected ? 'review-thumb--selected' : ''}} {{busy || !item.selectable ? 'review-thumb--disabled' : ''}}" data-id="{{item.id}}" bindtap="selectMedia" disabled="{{busy || !item.selectable}}" aria-label="选择第 {{index + 1}} 项"><image src="{{imageSources[item.thumbnail_url] || ''}}" mode="aspectFill" /><text>{{index + 1}}</text></button></view>
        <view wx:for="{{memory.media}}" wx:key="id" class="review-status"><text>{{index + 1}} · {{item.stateLabel || item.state}}</text></view>
        <checkbox-group bindchange="reviewed"><label class="review-ack"><checkbox value="reviewed" checked="{{reviewed}}" color="#FF9800" /><text>已审核文字、所选图片及视频的完整画面和声音</text></label></checkbox-group>
      </scroll-view>
      <view class="review-publish"><button size="mini" class="primary {{busy || !selected.length || !reviewed ? 'primary--disabled' : ''}}" data-action="publish" bindtap="askReview" disabled="{{busy || !selected.length || !reviewed}}">发布 {{selected.length}} 项</button></view>
    </view>
  </view>
</view>
<create-access-dialog id="memory-confirm" bind:confirm="confirmReview" />
<create-access-dialog id="session-expired-dialog" />
