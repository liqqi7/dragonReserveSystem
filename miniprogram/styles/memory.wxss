@import "./formLayout.wxss";
.memory-screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f8fafc;
  color: #111827;
}
.memory-nav {
  position: relative;
  height: 84.61538rpx;
  display: flex;
  flex: none;
  align-items: center;
  padding: 0 44.23rpx;
  box-sizing: border-box;
}
.memory-back {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  width: 69.23rpx;
  height: 84.61538rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  flex: none;
}
.memory-back image {
  width: 34.61538rpx;
  height: 34.61538rpx;
}
.memory-nav-title {
  position: absolute;
  left: 150rpx;
  right: 150rpx;
  text-align: center;
  font-size: 38.46154rpx;
  line-height: 1.2;
  font-weight: 700;
}
.memory-form {
  padding: 61.53846rpx 53.85rpx 38.46rpx;
}
.memory-field {
  margin-top: 38.46rpx;
}
.memory-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.memory-optional {
  color: #9ca3af;
  font-size: 23.07692rpx;
  font-weight: 400;
}
.memory-input {
  width: 100%;
}
.memory-footer {
  flex: none;
  padding: 23.08rpx 46.15rpx 0;
  background: #f8fafc;
}
.memory-state {
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
  font-size: 28rpx;
  color: #6b7280;
}
.memory-error {
  color: #dc2626;
  font-size: 26rpx;
  margin-top: 16rpx;
}
.memory-actions {
  display: flex;
  gap: 20rpx;
}
.memory-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 28rpx;
}
.memory-danger {
  background: #f43f44;
  color: #ffffff;
}
.memory-neutral {
  background: #f3f4f6;
  color: #4b5563;
}
