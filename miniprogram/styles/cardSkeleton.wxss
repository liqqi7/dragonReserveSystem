/* Shared native transition sweep for home and memory cards. */
.skeleton-shimmer,
.memory-skeleton-shimmer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 45%;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.65), rgba(255,255,255,0));
  transform: translateX(-100%);
  pointer-events: none;
}
.skeleton-shimmer--running,
.memory-skeleton-shimmer--running {
  transform: translateX(325%);
  transition: transform 1400ms linear;
}
