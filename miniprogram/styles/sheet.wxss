/* Cover/time pickers are secondary sheets; participants is a primary drawer.
 * Only identical primitives are shared. Each surface owns its layout and motion. */
.cover-sheet-embedded-root,
.picker-sheet-embedded-root {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.cover-sheet-mask,
.picker-sheet-embedded-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0;
}

.cover-sheet-mask--visible,
.picker-sheet-embedded-mask--visible {
  opacity: 1;
}

.cover-sheet-header,
.picker-sheet-header,
.drawer-header {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.cover-sheet-header,
.picker-sheet-header {
  height: 107.69rpx;
  padding: 0 38.46rpx;
}

.cover-sheet-title,
.picker-sheet-title {
  color: #000000;
  font-size: 30.77rpx;
  line-height: 42.31rpx;
  font-weight: 600;
}

.cover-sheet-close,
.picker-sheet-close,
.drawer-close {
  width: 61.54rpx;
  height: 61.54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-sheet-close-icon,
.picker-sheet-close-icon,
.drawer-close image {
  width: 38.46rpx;
  height: 38.46rpx;
}

.cover-sheet-close-icon,
.picker-sheet-close-icon {
  display: block;
}
