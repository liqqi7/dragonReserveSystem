.cover-skeleton-shimmer,
.detail-skeleton-shimmer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 72%;
  height: 100%;
  background-image: linear-gradient(
    90deg,
    rgba(248, 249, 251, 0) 0%,
    rgba(248, 249, 251, 0.24) 22%,
    rgba(248, 249, 251, 0.52) 42%,
    rgba(248, 249, 251, 0.52) 58%,
    rgba(248, 249, 251, 0.24) 78%,
    rgba(248, 249, 251, 0) 100%
  );
  transform: translateX(-100%);
  pointer-events: none;
  animation-name: shared-skeleton-shimmer;
  animation-duration: 1800ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes shared-skeleton-shimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(150%); }
}
