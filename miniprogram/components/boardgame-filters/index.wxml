<boardgame-sheet visible="{{visible}}" title="筛选记录" kind="form" bindclose="close" busy="{{saving}}" size="high"><view wx:if="{{error}}" class="bg-error">{{error}}</view><view class="bg-label">时间</view><picker range="{{periods}}" range-key="label" value="{{periodIndex}}" bindchange="period"><view class="bg-input">{{periods[periodIndex].label}}　⌄</view></picker><view wx:if="{{periodIndex > 0 && periodIndex < 4}}" class="filter-grid"><view><view class="bg-label">年份</view><input class="bg-input" type="number" value="{{form.year}}" data-key="year" bindinput="field"/></view><view wx:if="{{periodIndex < 3}}"><view class="bg-label">{{periodIndex === 1 ? '月份（1–12）' : '季度（1–4）'}}</view><input class="bg-input" type="number" value="{{periodIndex === 1 ? form.month : form.quarter}}" data-key="{{periodIndex === 1 ? 'month' : 'quarter'}}" bindinput="field"/></view></view><view wx:if="{{periodIndex === 4}}" class="filter-grid"><view><view class="bg-label">起始日期</view><view class="bg-input" data-key="from" bindtap="openDate">{{form.from || '选择日期'}} ›</view></view><view><view class="bg-label">结束日期</view><view class="bg-input" data-key="to" bindtap="openDate">{{form.to || '选择日期'}} ›</view></view></view>
<view class="filter-grid"><view><view class="bg-label">比赛方式</view><picker range="{{modes}}" value="{{modeIndex}}" bindchange="mode"><view class="bg-input">{{modes[modeIndex]}}</view></picker></view><view><view class="bg-label">游玩环境</view><picker range="{{environments}}" value="{{environmentIndex}}" bindchange="environment"><view class="bg-input">{{environments[environmentIndex]}}</view></picker></view></view><view class="bg-label">实际人数（含 Automa）</view><input class="bg-input" type="number" value="{{form.player_count}}" data-key="player_count" bindinput="field" placeholder="不限"/>
<view class="bg-label">活动、伙伴和地点</view><view class="filter-tags"><button class="bg-chip" data-kind="activity" bindtap="selectList">活动 · {{form.activity_ids.length || 0}}</button><button class="bg-chip" data-kind="person" bindtap="selectList">伙伴 · {{form.person_ids.length || 0}}</button><button class="bg-chip" data-kind="location" bindtap="selectList">地点 · {{form.location_ids.length || 0}}</button><text class="bg-link" bindtap="clearRelated">清空</text></view><view class="bg-muted">选中多个伙伴时，查找共同参加的对局。</view><view class="bg-label">我的对局标签</view><view wx:for="{{tags}}" wx:key="id" class="filter-line bg-row bg-between"><text>{{item.name}}</text><view class="bg-row"><button class="bg-chip {{item.included ? 'active' : ''}}" data-id="{{item.id}}" bindtap="tag">包含</button><button class="bg-chip {{item.excluded ? 'active' : ''}}" data-id="{{item.id}}" data-kind="exclude" bindtap="tag">排除</button></view></view><view slot="footer" class="bg-row"><button class="bg-button secondary" bindtap="reset">重置</button><button class="bg-button bg-grow" bindtap="apply">应用筛选</button></view></boardgame-sheet>
<boardgame-sheet visible="{{listOpen}}" title="选择筛选对象" kind="info" bindclose="closeList"><view wx:if="{{listKind !== 'activity'}}" class="bg-row"><input class="bg-input bg-grow" value="{{search}}" bindinput="searchInput" placeholder="搜索名称"/><button class="bg-button small" bindtap="searchList">搜索</button></view><view class="bg-notice">再次点击可取消；选好后关闭返回，回到筛选表单。</view><view wx:for="{{list}}" wx:key="id" class="bg-list-item" data-id="{{item.id}}" bindtap="choose"><text class="{{item.selected ? 'bg-link' : ''}}">{{item.selected ? '✓ ' : '○ '}}{{item.name || item.display_name}}</text><text class="bg-muted"> {{item.selected ? '已选' : '未选'}}</text></view><button wx:if="{{listCursor}}" class="bg-button secondary full" data-more="{{true}}" bindtap="searchList">加载更多</button><view wx:if="{{!list.length}}" class="bg-empty">暂无可选内容</view></boardgame-sheet>

<date-time-picker-sheet visible="{{dateOpen}}" mode="date" title="{{dateField === 'from' ? '开始日期' : '结束日期'}}" value="{{dateValue}}" bindclose="closeDate" bindconfirm="dateConfirm"/>
