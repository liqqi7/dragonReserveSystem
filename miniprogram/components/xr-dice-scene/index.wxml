  </xr-node>
  <xr-node node-id="camera-target" position="0 -1 0" />
  <xr-camera id="camera" node-id="camera" position="0 12 17" target="camera-target" camera-orbit-control="rotateSpeed: 0.8; isLockMove: true; isLockZoom: true" clear-color="0.92 0.93 0.97 1" />
  <xr-light type="ambient" color="1 1 1" intensity="1.4" />
