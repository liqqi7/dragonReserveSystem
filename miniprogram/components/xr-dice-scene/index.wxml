    <xr-text value="5" position="0 0.81 0" rotation="-90 0 0" size="0.65" anchor="0.5 0.5" color="1 1 1 1" />
    <xr-text value="2" position="0 -0.81 0" rotation="90 0 0" size="0.65" anchor="0.5 0.5" color="1 1 1 1" />
  </xr-node>
  <xr-node id="dice-mesh-1" node-id="dice-mesh-1" position="0 -20 0" rigidbody="{{rigidbodyConfig}}" cube-shape="size: 1.6 1.6 1.6" shape-interact="{{diceInteract}}" bind:touch-shape="handleTouchShape" bind:drag-shape="handleDragShape" bind:untouch-shape="handleUntouchShape">
