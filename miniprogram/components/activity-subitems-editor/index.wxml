<view class="toggle-row">
  <text>可选子项目</text>
  <view class="prototype-switch {{enabled ? 'prototype-switch--checked' : ''}} {{locked ? 'prototype-switch--locked' : ''}}" bindtap="toggleTap" aria-role="switch" aria-checked="{{enabled}}">
    <view class="prototype-switch-thumb"></view>
  </view>
</view>
<view wx:if="{{renderContent}}" class="subitems-content {{contentEntering ? 'subitems-content--entering' : ''}} {{contentLeaving ? 'subitems-content--leaving' : ''}}">
  <view
    wx:for="{{items}}"
    wx:key="index"
    class="item-wrap {{insertingIndex === index ? 'item-wrap--inserting' : ''}} {{removingIndex === index ? 'item-wrap--removing' : ''}}"
    bindtouchstart="startSwipe"
    bindtouchmove="moveSwipe"
    bindtouchend="endSwipe"
    bindtouchcancel="cancelSwipe"
    data-index="{{index}}"
  >
    <view class="delete" data-index="{{index}}" bindtap="remove" aria-role="button" aria-label="删除子项目">
      <image class="delete-icon" src="/images/activity-subitem-trash.svg" mode="aspectFit" />
      <text>删除</text>
    </view>
    <view class="project-row" style="transform:translate3d({{rowStates[index].offsetX || 0}}rpx,0,0)">
      <input class="name" placeholder="请输入项目名称" placeholder-style="color:#9CA3AF;font-size:26.92rpx;font-weight:400;" value="{{item.name}}" maxlength="64" data-index="{{index}}" bindinput="input" />
      <view class="stepper">
        <view class="step" data-index="{{index}}" data-delta="-1" bindtap="step" aria-role="button" aria-label="减少名额"><image class="step-icon" src="/images/activity-subitem-minus.svg" mode="aspectFit" /></view>
        <text class="count">{{item.max_participants}} 人</text>
        <view class="step" data-index="{{index}}" data-delta="1" bindtap="step" aria-role="button" aria-label="增加名额"><image class="step-icon" src="/images/activity-subitem-plus.svg" mode="aspectFit" /></view>
      </view>
    </view>
  </view>
  <view wx:if="{{items.length < 4}}" class="add" bindtap="add" aria-role="button">
    <image class="add-border" src="/images/activity-subitem-add-border.svg" mode="scaleToFill" aria-hidden="true" />
    <image class="add-icon" src="/images/activity-subitem-plus.svg" mode="aspectFit" />
    <text>添加项目</text>
  </view>
</view>
