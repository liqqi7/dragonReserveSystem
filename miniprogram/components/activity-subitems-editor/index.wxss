.toggle-row { display:flex; align-items:center; justify-content:space-between; height:46.15rpx; font-size:26.92rpx; font-weight:700; color:#111827; }
.subitems-content { transform-origin:top center; }
.subitems-content--entering { animation-name:subitems-content-enter; animation-duration:360ms; animation-timing-function:cubic-bezier(0.42,0,0.58,1); animation-fill-mode:forwards; }
.subitems-content--leaving { animation-name:subitems-content-leave; animation-duration:360ms; animation-timing-function:cubic-bezier(0.42,0,0.58,1); animation-fill-mode:forwards; }
.item-wrap { position:relative; height:107.69rpx; margin-top:15.38rpx; overflow:hidden; border-radius:30.77rpx; background:transparent; }
.item-wrap--inserting { height:0; margin-top:0; pointer-events:none; transition:height 240ms cubic-bezier(0.42,0,0.58,1), margin-top 240ms cubic-bezier(0.42,0,0.58,1); }
.item-wrap--inserting .item-visual { opacity:0; transition:opacity 240ms ease-out; }
.item-wrap--inserting.item-wrap--insert-visible { height:107.69rpx; margin-top:15.38rpx; }
.item-wrap--inserting.item-wrap--insert-visible .item-visual { opacity:1; }
.item-visual { position:relative; width:100%; height:107.69rpx; }
.item-wrap--removing { pointer-events:none; }
.item-wrap--removing .item-visual { animation-name:subitem-remove-left; animation-duration:150ms; animation-timing-function:cubic-bezier(0.4,0,1,1); animation-fill-mode:forwards; }
.item-wrap--removing-collapsing { height:0; margin-top:0; transition:height 240ms cubic-bezier(0.42,0,0.58,1), margin-top 240ms cubic-bezier(0.42,0,0.58,1); }
.item-wrap--removing-committing { height:0; margin-top:0; pointer-events:none; }
.item-wrap--removing-committing .item-visual { opacity:0; transform:none; }
.project-row { position:relative; z-index:1; display:flex; align-items:center; width:100%; height:107.69rpx; padding:0 38.46rpx; border-radius:30.77rpx; background:#F3F4F6; box-sizing:border-box; transition:transform 180ms ease-out; }
.project-row--no-transition { transition:none; }
.name { flex:1; min-width:0; height:53.85rpx; font-size:26.92rpx; font-weight:400; color:#111827; }
.stepper { display:flex; align-items:center; flex-shrink:0; margin-left:15.38rpx; gap:15.38rpx; }
.step { width:53.85rpx; height:53.85rpx; flex-shrink:0; border-radius:15.38rpx; background:#FFFFFF; display:flex; align-items:center; justify-content:center; }
.step-icon { display:block; width:26.92rpx; height:26.92rpx; }
.step-plus { position:relative; }
.plus-bar { position:absolute; left:3.85rpx; top:11.54rpx; width:19.23rpx; height:3.85rpx; border-radius:1.92rpx; background:#FF9800; }
.plus-bar--vertical { transform:rotate(90deg); }
.count { width:76.92rpx; flex-shrink:0; text-align:center; font-size:26.92rpx; line-height:30.77rpx; font-weight:600; color:#111827; }
.delete { position:absolute; right:0; top:0; width:130.77rpx; height:107.69rpx; border-radius:30.77rpx; background:#FFF5F5; color:#EF4444; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7.69rpx; font-size:23.08rpx; line-height:23.08rpx; font-weight:400; }
.delete-icon { display:block; width:34.62rpx; height:34.62rpx; }
.add { position:relative; height:107.69rpx; margin-top:15.38rpx; border:0; border-radius:30.77rpx; background:#FFFDF9; box-sizing:border-box; display:flex; align-items:center; justify-content:center; gap:15.38rpx; color:#FF9800; font-size:26.92rpx; font-weight:600; overflow:visible; }
.add-border { position:absolute; top:0; left:0; z-index:0; width:100%; height:100%; pointer-events:none; }
.add-icon, .add text { position:relative; z-index:1; }
.add-icon { display:block; width:30.77rpx; height:30.77rpx; }
.prototype-switch { position:relative; width:84.62rpx; height:46.15rpx; border-radius:23.08rpx; background:#E5E7EB; flex-shrink:0; }
.prototype-switch--checked { background:#FF9800; }
.prototype-switch-thumb { position:absolute; left:3.85rpx; top:3.85rpx; width:38.46rpx; height:38.46rpx; border-radius:19.23rpx; background:#FFFFFF; box-shadow:0 1.92rpx 5.77rpx rgba(0,0,0,0.15); transition:left 150ms ease-out; }
.prototype-switch--checked .prototype-switch-thumb { left:42.31rpx; }
@keyframes subitems-content-enter { from { opacity:0; transform:translateY(15.38rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes subitems-content-leave { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(15.38rpx); } }
@keyframes subitem-remove-left { from { opacity:1; transform:translateX(0); } to { opacity:0; transform:translateX(-100%); } }

