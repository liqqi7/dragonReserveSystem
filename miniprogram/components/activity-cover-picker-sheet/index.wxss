@import "../../styles/sheet.wxss";
@import "../../styles/skeleton-shimmer.wxss";
.cover-sheet-embedded-root {
  z-index: 20;
}

.cover-sheet-mask {
  background: #00000066;
  transition: opacity 240ms ease-out;
}

.cover-sheet-embedded-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1384.62rpx;
  max-height: 92%;
  transform: translateY(100%);
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.cover-sheet-embedded-panel--visible { transform: translateY(0); }

.cover-sheet-panel {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 42.31rpx 42.31rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.cover-sheet-header {
  width: 100%;
  flex: none;
  justify-content: space-between;
}

.cover-sheet-divider { width: 100%; height: 1.92rpx; flex: none; background: #f5f5f5; }

.cover-sheet-content {
  width: 100%;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  margin-top: 23.08rpx;
  margin-bottom: 23.08rpx;
  box-sizing: border-box;
}

.cover-artist-group {
  width: 100%;
  height: 369.23rpx;
  padding: 0 0 0 30.77rpx;
  display: flex;
  flex-direction: column;
  gap: 19.23rpx;
  box-sizing: border-box;
}

.cover-artist-group + .cover-artist-group { margin-top: 46.15rpx; }

.cover-artist-header {
  height: 53.85rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: 15.38rpx;
}

.cover-artist-name {
  color: #374151;
  font-size: 26.92rpx;
  line-height: 38.46rpx;
  font-weight: 600;
}

.cover-artwork-track {
  width: 100%;
  height: 296.15rpx;
  flex: none;
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.cover-artwork {
  position: relative;
  width: 296.15rpx;
  min-width: 296.15rpx;
  height: 296.15rpx;
  flex: 0 0 296.15rpx;
  margin-right: 23.08rpx;
  overflow: visible;
  border: 0;
  border-radius: 23.08rpx;
  background: #f5f5f5;
  box-sizing: border-box;
  animation-name: cover-artwork-enter;
  animation-duration: 560ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-fill-mode: both;
}

@keyframes cover-artwork-enter {
  from {
    opacity: 0;
    transform: translateY(23.08rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cover-artwork:last-child { margin-right: 30.77rpx; }
.cover-artwork-transition,
.cover-artwork-media {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 23.08rpx;
}

.cover-artwork-image { width: 100%; height: 100%; display: block; }
.cover-artwork-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background-color: #eaecef;
}

.cover-sheet-skeleton {
  width: 100%;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 23.08rpx 0;
  overflow: hidden;
  box-sizing: border-box;
}

.cover-sheet-skeleton-list {
  width: 100%;
  padding: 0 30.77rpx;
  box-sizing: border-box;
}

.cover-skeleton-group {
  width: 100%;
  height: 369.23rpx;
  display: flex;
  flex-direction: column;
  gap: 19.23rpx;
  overflow: hidden;
}

.cover-skeleton-group + .cover-skeleton-group { margin-top: 46.15rpx; }

.cover-skeleton-header {
  width: 100%;
  height: 53.85rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: 15.38rpx;
}

.cover-skeleton-block {
  flex: none;
  position: relative;
  overflow: hidden;
  background-color: #eaecef;
}

.cover-skeleton-track {
  width: 100%;
  height: 296.15rpx;
  flex: none;
  display: flex;
  flex-direction: row;
  gap: 23.08rpx;
  overflow: hidden;
}

.cover-skeleton-card {
  width: 296.15rpx;
  min-width: 296.15rpx;
  height: 296.15rpx;
  border-radius: 23.08rpx;
}

.cover-artwork-border {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  border: 1.92rpx solid #e5e7eb;
  border-radius: 23.08rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.cover-artwork--selected .cover-artwork-border {
  border-width: 3.85rpx;
  border-color: #ff9800;
}

.cover-artwork-check {
  position: absolute;
  top: 15.38rpx;
  left: 15.38rpx;
  width: 53.85rpx;
  height: 53.85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  z-index: 3;
}

.cover-artwork-check-icon { width: 53.85rpx; height: 53.85rpx; display: block; }

.cover-artwork-preview {
  position: absolute;
  right: 15.38rpx;
  bottom: 15.38rpx;
  width: 53.85rpx;
  height: 53.85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  z-index: 3;
}

.cover-artwork-preview-icon { width: 53.85rpx; height: 53.85rpx; display: block; }

.cover-sheet-status {
  flex: 1 1 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.cover-sheet-retry {
  height: 72rpx;
  padding: 0 32rpx;
  border: 0;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 72rpx;
}
.cover-sheet-retry::after { border: 0; }

.cover-sheet-footer {
  width: 100%;
  height: 153.85rpx;
  flex: none;
  padding: 11.54rpx 38.46rpx 57.69rpx;
  border-top: 1.92rpx solid #e5e7eb;
  background: #ffffff;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.cover-sheet-confirm {
  width: auto;
  min-width: 0;
  height: 84.62rpx;
  flex: 1;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 23.08rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff9800;
  color: #ffffff;
  box-shadow: 0 3.85rpx 15.38rpx rgba(0, 0, 0, 0.05);
  font-size: 26.92rpx;
  line-height: 84.62rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.cover-sheet-confirm-label {
  color: #ffffff;
  font-size: inherit;
  line-height: inherit;
  font-weight: inherit;
  text-align: center;
}

.cover-sheet-confirm--disabled {
  background: #b8bec8;
  color: #ffffff;
}

.cover-sheet-confirm--disabled .cover-sheet-confirm-label {
  color: #ffffff;
}

.cover-skeleton-category { color: #374151; font-size: 26.92rpx; line-height: 53.85rpx; font-weight: 600; }
