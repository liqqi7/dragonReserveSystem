.activity-sheet-root {
  position: fixed;
  inset: 0;
  z-index: 20000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #111827;
}

.activity-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(23, 24, 20, 0.4);
}

.activity-sheet-panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 100%;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 48rpx 48rpx 0 0;
  background: #f5f5f5;
  box-shadow: 0 -10rpx 36rpx rgba(65, 74, 138, 0.08);
  animation: activity-sheet-up 180ms ease-out;
}

.activity-sheet-drag-area {
  height: 24rpx;
  flex: none;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-sheet-drag {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #9ca3af;
}

.activity-sheet-header {
  height: 80rpx;
  flex: none;
  margin-top: 12rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.activity-sheet-title {
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 700;
  color: #000000;
}

.activity-sheet-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-sheet-close-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.activity-sheet-body {
  flex: none;
  min-height: 0;
  height: auto;
  max-height: calc(100vh - 232rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bento-grid {
  padding: 12rpx 36rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.bento-card {
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bento-card--full {
  width: 100%;
  padding: 16rpx 24rpx;
}

.bento-card--disabled {
  opacity: 0.64;
}

.bento-label {
  display: block;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.bento-label--strong {
  color: #4b5563;
  font-weight: 600;
}

.activity-time-card,
.deadline-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.activity-time-grid,
.deadline-grid {
  display: flex;
  gap: 16rpx;
}

.date-time-row {
  min-width: 0;
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.date-time-row--pressed {
  opacity: 0.72;
}

.date-time-row-label {
  flex: none;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.date-time-row-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 32rpx;
  font-weight: 400;
  text-align: right;
}

.date-time-row-value--filled {
  color: #000000;
}

.bento-pair-row {
  width: 100%;
  display: flex;
  gap: 20rpx;
}

.bento-card--half {
  min-width: 0;
  flex: 1;
}

.compact-card {
  height: 92rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.compact-select-card,
.compact-select-row,
.compact-switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.compact-select-row {
  min-width: 0;
  min-height: 44rpx;
  flex: 1;
  justify-content: flex-end;
}

.compact-select-card--pressed {
  opacity: 0.72;
}

.compact-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 400;
}

.compact-value--filled {
  color: #272064;
}

.compact-switch-card {
  height: 92rpx;
}

.prototype-switch {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  padding: 6rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 28rpx;
  background: #d1d5db;
  box-sizing: border-box;
}

.prototype-switch--checked {
  justify-content: flex-end;
  background: #ff9800;
}

.prototype-switch-thumb {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  border-radius: 50%;
  background: #ffffff;
}

.stepper-card {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.stepper {
  flex: none;
  width: 220rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.stepper-button {
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  flex: 0 0 44rpx;
  height: 44rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.stepper-button::after {
  border: 0;
}

.stepper-button--disabled {
  opacity: 0.35;
}

.stepper-value {
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  flex: 0 0 44rpx;
  text-align: center;
  color: #000000;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.stepper-value-input {
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  flex: 0 0 44rpx;
  height: 40rpx;
  min-height: 40rpx;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  color: #000000;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  text-align: center;
}

.input-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.input-count {
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 28rpx;
}

.bento-input {
  min-width: 0;
  height: 40rpx;
  flex: 1;
  color: #272064;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
}

.bento-placeholder,
.bento-placeholder-text {
  color: #9ca3af;
  font-weight: 400;
}

.bento-value-row {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bento-value {
  min-width: 0;
  color: #272064;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 400;
}

.bento-value-row--location {
  min-height: 40rpx;
  align-items: center;
}

.bento-value-row--with-address {
  align-items: flex-start;
}

.location-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.location-value {
  color: #272064;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
}

.location-value.bento-placeholder-text {
  color: #9ca3af;
}

.location-address {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 32rpx;
}

.activity-type-chevron {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  display: block;
}

.location-chevron {
  width: 34rpx;
  height: 34rpx;
  margin-top: 3rpx;
  flex: none;
  display: block;
}

.textarea-card {
  min-height: 0;
}

.bento-textarea {
  width: 100%;
  height: 40rpx;
  min-height: 40rpx;
  color: #272064;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.textarea-count-row {
  display: flex;
  justify-content: flex-end;
}

.activity-sheet-footer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  border-top: 1rpx solid #e5e7eb;
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.07);
}

.activity-sheet-footer-actions {
  height: 100rpx;
  padding: 12rpx 32rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  box-sizing: border-box;
}

.sheet-button {
  height: 88rpx;
  flex: 1;
  min-width: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.sheet-button::after {
  border: 0;
}

.sheet-button--primary {
  background: #ff9800;
  color: #ffffff;
}

.sheet-button--danger {
  background: #fff1f0;
  color: #e34d59;
}

.sheet-button[disabled] {
  opacity: 0.56;
}

@keyframes activity-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 新建活动主抽屉：与最新 Pencil 规范对齐，不影响编辑活动。 */
.activity-sheet-panel--create {
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

.activity-sheet-panel--create .activity-sheet-body {
  max-height: calc(100vh - 244rpx - env(safe-area-inset-bottom));
}

.bento-grid--create {
  gap: 12rpx;
}

.activity-sheet-panel--create .compact-card,
.activity-sheet-panel--create .compact-switch-card {
  height: 104rpx;
}

.activity-sheet-panel--create .compact-select-row {
  gap: 16rpx;
}

.activity-sheet-panel--create .stepper-card {
  min-height: 104rpx;
}

.activity-sheet-panel--create .stepper {
  width: 220rpx;
  height: 72rpx;
  padding: 0 24rpx;
  justify-content: flex-start;
  gap: 24rpx;
}

.activity-sheet-panel--create .stepper-button {
  width: 40rpx;
  min-width: 40rpx;
  max-width: 40rpx;
  flex-basis: 40rpx;
  height: 40rpx;
}

.activity-sheet-panel--create .participant-limit-card--create {
  min-height: 0;
  height: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: -12rpx;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transform: translateY(-8rpx);
  transition:
    height 240ms ease,
    min-height 240ms ease,
    padding-top 240ms ease,
    padding-bottom 240ms ease,
    margin-top 240ms ease,
    opacity 160ms ease,
    transform 240ms ease;
}

.activity-sheet-panel--create .participant-limit-card--create.participant-limit-card--visible {
  min-height: 104rpx;
  height: 104rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  margin-top: 0;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.create-completed-text,
.create-completed-field .bento-input,
.create-completed-field .bento-textarea {
  color: #111827;
}

.activity-sheet-panel--create .location-chevron {
  margin-top: 0;
  align-self: center;
}

/* 新建活动备注使用受控的 1～5 行高度，避免真机 auto-height 首帧跳变和删除后不回缩。 */
.activity-sheet-panel--create .bento-textarea {
  height: 48rpx;
  min-height: 48rpx;
  max-height: 200rpx;
  padding: 0;
  line-height: 40rpx;
  overflow-y: auto;
}

.activity-sheet-footer--create {
  height: calc(112rpx + env(safe-area-inset-bottom));
  border-top-width: 2rpx;
}

.activity-sheet-footer-actions--create {
  height: 112rpx;
  padding: 12rpx 32rpx;
}

.sheet-button--primary-create {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 编辑活动抽屉：复用公共表单结构，仅覆盖编辑态与最新 Pencil 原型的差异。 */
.activity-sheet-panel--edit {
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

.activity-sheet-panel--edit .activity-sheet-body {
  max-height: calc(100vh - 244rpx - env(safe-area-inset-bottom));
}

.bento-grid--edit {
  gap: 12rpx;
}

.activity-sheet-panel--edit .compact-card,
.activity-sheet-panel--edit .compact-switch-card,
.activity-sheet-panel--edit .stepper-card {
  min-height: 104rpx;
  height: 104rpx;
}

.activity-sheet-panel--edit .stepper {
  width: 220rpx;
  height: 72rpx;
  padding: 0 24rpx;
  justify-content: flex-start;
  gap: 24rpx;
}

.activity-sheet-panel--edit .stepper-button {
  width: 40rpx;
  min-width: 40rpx;
  max-width: 40rpx;
  flex-basis: 40rpx;
  height: 40rpx;
}

.activity-sheet-panel--edit .participant-limit-card--edit {
  min-height: 0;
  height: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: -12rpx;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transform: translateY(-8rpx);
  transition:
    height 240ms ease,
    min-height 240ms ease,
    padding-top 240ms ease,
    padding-bottom 240ms ease,
    margin-top 240ms ease,
    opacity 160ms ease,
    transform 240ms ease;
}

.activity-sheet-panel--edit .participant-limit-card--edit.participant-limit-card--visible {
  min-height: 104rpx;
  height: 104rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  margin-top: 0;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.activity-sheet-panel--edit .date-time-row-value--filled,
.activity-sheet-panel--edit .bento-input,
.activity-sheet-panel--edit .bento-value,
.activity-sheet-panel--edit .location-value,
.activity-sheet-panel--edit .bento-textarea {
  color: #111827;
}

.activity-sheet-panel--edit .location-chevron {
  margin-top: 0;
  align-self: center;
}

.activity-sheet-panel--edit .bento-textarea {
  height: 48rpx;
  min-height: 48rpx;
  max-height: 210rpx;
  padding: 0;
  line-height: 42rpx;
  overflow-y: auto;
}

.activity-sheet-footer--double {
  height: calc(112rpx + env(safe-area-inset-bottom));
  border-top-width: 2rpx;
}

.activity-sheet-footer-actions--edit {
  height: 112rpx;
  padding: 12rpx 32rpx;
  align-items: center;
  gap: 16rpx;
}

.sheet-button--secondary-edit {
  width: 224rpx;
  flex: 0 0 224rpx;
  border: 2rpx solid #ff9800;
  background: transparent;
  color: #ff9800;
  font-weight: 600;
}

.sheet-button--primary-edit {
  flex: 1;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
