.bg-sheet-overlay { position:fixed; inset:0; z-index:20000; display:flex; align-items:flex-end; }
.bg-sheet-mask { position:absolute; inset:0; background:#00000066; }
.bg-sheet-panel { position:relative; display:flex; flex-direction:column; width:100%; height:1073.08rpx; max-height:100vh; background:#F5F5F5; border-radius:46.15rpx 46.15rpx 0 0; overflow:hidden; box-shadow:0 -9.62rpx 34.62rpx #414A8A14; }
.bg-sheet-panel.low { height:692.31rpx; }.bg-sheet-panel.high { height:1384.62rpx; }
.bg-sheet-header { height:146.15rpx; flex:none; padding-top:15.38rpx; box-sizing:border-box; }
.bg-sheet-handle-zone { height:23.08rpx; display:flex; align-items:center; justify-content:center; margin-bottom:15.38rpx; }
.bg-sheet-handle { width:73.08rpx; height:7.69rpx; border-radius:7.69rpx; background:#9CA3AF; }
.bg-sheet-heading { height:76.92rpx; display:flex; align-items:center; justify-content:space-between; padding:0 30.77rpx; gap:15.38rpx; }
.bg-sheet-title { min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:38.46rpx; line-height:53.85rpx; color:#111827; font-weight:700; }
.bg-sheet-close { display:flex; align-items:center; justify-content:center; width:61.54rpx; height:61.54rpx; flex:none; padding:0; margin:0; border:0; background:transparent; }.bg-sheet-close::after { border:0; }.bg-sheet-close image { width:38.46rpx; height:38.46rpx; }
.bg-sheet-content { height:0; flex:1; min-height:0; box-sizing:border-box; padding:0 30.77rpx 30.77rpx; }
.form .bg-sheet-heading { padding:0 34.62rpx; }.form .bg-sheet-content { padding-left:34.62rpx; padding-right:34.62rpx; }
.bg-sheet-footer { height:153.85rpx; flex:none; padding:15.38rpx 34.62rpx 0; box-sizing:border-box; background:#FFFFFF; display:flex; align-items:flex-start; box-shadow:0 -9.62rpx 34.62rpx #414A8A14; }
