# Local API + server MySQL + server media. No local business database.
APP_ENV=test
APP_DEBUG=false
DATABASE_URL=mysql+pymysql://test_user:replace-me@127.0.0.1:3307/dragon_reserve_test?charset=utf8mb4
# The launcher reads existing SERVER TEST credentials in memory over SSH.
# Do not copy production secrets or generate test JWT/media keys here.
SSH_TEST_DB_HOST=124.156.228.148
SSH_TEST_DB_USER=ubuntu
SSH_TEST_DB_REMOTE_PORT=3306
SSH_TEST_DB_IDENTITY_FILE=~/.ssh/id_rsa
TEST_REMOTE_DATA_ROOT=/home/ubuntu/apps/dragonReserveSystem-test/data
# Windows: unused drive letter. Linux/macOS: empty mount directory.
TEST_MEDIA_MOUNT=R:/
# MEDIA_ROOT and MEMORY_STORAGE_ROOT are supplied by the verified remote mount.
# Dependencies: OpenSSH and SSHFS (Windows: WinFsp + SSHFS-Win).
# FFmpeg/FFprobe must be installed locally for API media validation.
# Optional explicit LOCAL paths (do not use the server's /usr/bin paths):
# MEMORY_FFMPEG=C:/Users/your-name/AppData/Local/Programs/FFmpeg/bin/ffmpeg.exe
# MEMORY_FFPROBE=C:/Users/your-name/AppData/Local/Programs/FFmpeg/bin/ffprobe.exe
