[Unit]
Description=Dragon Reserve weather snapshot refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/dragonReserveSystem/backend
EnvironmentFile=/home/ubuntu/apps/dragonReserveSystem/backend/.env
ExecStart=/usr/bin/flock -n /var/lock/dragonreserve-weather-refresh.lock /home/ubuntu/apps/dragonReserveSystem/backend/.venv/bin/python scripts/refresh_activity_weather.py
